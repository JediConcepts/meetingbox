#!/usr/bin/env bash
#
# meetingbox: one key, whole meeting. Record, transcribe, summarise, all on device.
#
#   press once  -> records you and everyone else
#   press again -> stops, transcribes, writes the minutes
#
# Nothing leaves the Mac. No account, no API key, no upload, no per seat fee.
#
#   audio-capture     ->  audio.m4a          ScreenCaptureKit + your mic, one clock
#   speech-analyzer   ->  transcript.txt     Apple SpeechAnalyzer, on device
#     or whisper-cli  ->  transcript.txt     whisper.cpp, if you prefer
#   fm respond        ->  notes.md + brief.json
#
# First run: meetingbox setup
# It checks what is missing and offers to install it. Nothing to do by hand.
#
# Written for bash 3.2 and BSD userland, so it runs on a stock Mac.

set -euo pipefail

VERSION="1.2.1"

# --------------------------------------------------------------- configuration

BASE_DIR="${MB_DIR:-$HOME/Meetings}"
ENGINE="${MB_ENGINE:-auto}"              # auto | native | whisper
LOCALE="${MB_LOCALE:-en-GB}"
MIC="${MB_MIC:-}"                        # substring match, empty = system default
WHISPER_MODEL="${MB_WHISPER_MODEL:-}"
KEEP_AUDIO="${MB_KEEP_AUDIO:-1}"

STATE_DIR="${MB_STATE_DIR:-$HOME/.meetingbox}"
PID_FILE="$STATE_DIR/recording.pid"
DIR_FILE="$STATE_DIR/recording.dir"

BIN_DIR="${MB_BIN_DIR:-$HOME/.local/bin}"
SRC_DIR="${MB_SRC_DIR:-$HOME/.local/share/meetingbox}"
MODEL_DIR="${MB_MODEL_DIR:-$HOME/.local/share/whisper}"
WHISPER_FILE="$MODEL_DIR/ggml-large-v3-turbo.bin"
# where speech-analyzer's own install script puts itself
SA_LINK="$HOME/.local/bin/speech-analyzer"
SA_APP="$HOME/.local/libexec/SpeechAnalyzerCLI.app"

# The recorder runs inside its own small app so that macOS files the Screen
# Recording and Microphone permissions under "meetingbox", not under whichever
# app happened to start it (Terminal, Shortcuts, Raycast).
APP_ID="com.jediconcepts.meetingbox"
APP_DIR="$SRC_DIR/meetingbox.app"
APP_BIN="$APP_DIR/Contents/MacOS/audio-capture"
# Registering the app with LaunchServices is what lets tccutil find it by ID.
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

AUDIO_CAPTURE_REPO="https://github.com/danySam/audio-capture"
SPEECH_ANALYZER_REPO="https://github.com/simonw/speech-analyzer-cli"
WHISPER_MODEL_URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin"

CHUNK_WORDS="${MB_CHUNK_WORDS:-1500}"    # ~2000 tokens, leaves room for the answer
TOKEN_CEILING="${MB_TOKEN_CEILING:-2600}"

MAP_INSTRUCTIONS='You are taking minutes. This is one slice of a longer meeting transcript, so write no introduction and no conclusion. Extract only what is actually in this text, under these headings, omitting any heading with nothing under it: DECISIONS, ACTIONS (name the owner if one was named), NUMBERS AND DATES, OPEN QUESTIONS, NOTABLE QUOTES. Be terse. Invent nothing. If a point is ambiguous, say so rather than resolving it.'

REDUCE_INSTRUCTIONS='These are notes from consecutive slices of one meeting. Merge them into a single set of minutes. Drop duplicates, keep every distinct decision and action, keep the owner against each action, and preserve all numbers, dates and names exactly as written. Add nothing that is not in the notes. Same headings: DECISIONS, ACTIONS, NUMBERS AND DATES, OPEN QUESTIONS.'

FINAL_INSTRUCTIONS='Write the final minutes of this meeting from the merged notes below. Open with a three line summary, then the headings DECISIONS, ACTIONS (one line each, owner first), OPEN QUESTIONS. Markdown. No preamble and no sign off. Add nothing that is not in the notes.'

BRIEF_INSTRUCTIONS='Extract the structured record of this meeting from the notes below. Every item must come from the notes. Leave an array empty rather than guessing.'

# -------------------------------------------------------------------- plumbing

if [ -t 2 ]; then
  c_dim=$'\033[2m'; c_b=$'\033[1m'; c_r=$'\033[0;31m'
  c_g=$'\033[0;32m'; c_y=$'\033[0;33m'; c_c=$'\033[0;36m'; c_0=$'\033[0m'
else
  c_dim=; c_b=; c_r=; c_g=; c_y=; c_c=; c_0=
fi

say()  { printf '%s\n' "${c_b}meetingbox${c_0} $*" >&2; }
info() { printf '%s\n' "${c_dim}           $*${c_0}" >&2; }
ok()   { printf '%s\n' "${c_g}         +${c_0} $*" >&2; }
miss() { printf '%s\n' "${c_y}         -${c_0} $*" >&2; }
warn() { printf '%s\n' "${c_y}      warn${c_0} $*" >&2; }
die()  { printf '%s\n' "${c_r}     error${c_0} $*" >&2; exit 1; }
rule() { printf '%s\n' "${c_dim}           ------------------------------------------------${c_0}" >&2; }

have() { command -v "$1" >/dev/null 2>&1; }

notify() {
  have osascript || return 0
  osascript -e "display notification \"${2//\"/}\" with title \"${1//\"/}\"" >/dev/null 2>&1 || true
}

# yes/no, default yes. If stdin is not a terminal (piped, or `curl | bash`) it
# falls back to /dev/tty, because a question about installing things on someone's
# machine has to be answered by a person. With no terminal at all the answer is
# NO: silently assuming yes would install software nobody agreed to.
# `[ -r /dev/tty ]` is not good enough: the node can be readable while opening it
# fails with ENXIO (no controlling terminal). The only honest test is to open it.
tty_src() {
  [ -t 0 ] && { printf 'stdin'; return 0; }
  ( exec < /dev/tty ) 2>/dev/null && { printf '/dev/tty'; return 0; }
  return 1
}

#   confirm "question"       Enter means yes
#   confirm "question" no    Enter means no, for anything that removes things
confirm() {
  src="$(tty_src)" || {
    warn "no terminal to ask on, so leaving it alone: $1"
    info "run it in Terminal and it will ask properly"
    return 1
  }
  if [ "${2:-yes}" = no ]; then hint="[y/N]"; else hint="[Y/n]"; fi
  printf '%s' "${c_c}         ? ${c_0}$1 ${c_dim}$hint${c_0} " >&2
  if [ "$src" = stdin ]; then read -r reply || return 1
  else read -r reply < /dev/tty || return 1; fi
  case "$reply" in
    [yY]|[yY][eE][sS]) return 0 ;;
    [nN]|[nN][oO])     return 1 ;;
    *) [ "${2:-yes}" != no ] ;;
  esac
}

pause_for() {
  src="$(tty_src)" || return 0
  printf '%s' "${c_c}         > ${c_0}$1 ${c_dim}[enter]${c_0} " >&2
  if [ "$src" = stdin ]; then read -r _ || true
  else read -r _ < /dev/tty || true; fi
}

mkdir -p "$STATE_DIR"

# ------------------------------------------------------------ what setup made
#
# Setup writes down every path it creates, at the moment it creates it. reset
# and uninstall delete only paths on that list. So a folder that was already
# there (your own clone, your own whisper model, whatever an MB_* setting points
# at) is never deleted, and remove_installed is the only recursive delete of
# anything setup installed.

INSTALLED="$STATE_DIR/installed"

record_install()  { installed_by_us "$1" || printf '%s\n' "$1" >> "$INSTALLED"; }
installed_by_us() { grep -qxF -- "$1" "$INSTALLED" 2>/dev/null; }

remove_installed() {
  p="$1"
  case "$p" in ""|/|"$HOME"|"$HOME"/) warn "refusing to remove '$p'"; return 1 ;; esac
  installed_by_us "$p" || return 1
  rm -rf -- "$p"
  { grep -vxF -- "$p" "$INSTALLED" || true; } > "$INSTALLED.tmp"
  mv -f "$INSTALLED.tmp" "$INSTALLED"
}

# Clear a path for setup to create. Something meetingbox made before is replaced;
# anything else is left alone and setup stops.
claim_path() {
  if [ -e "$1" ] || [ -L "$1" ]; then
    installed_by_us "$1" || {
      warn "$1 already exists and meetingbox did not create it, so I will not replace it"
      info "move it somewhere else, then run: meetingbox setup"
      return 1
    }
    remove_installed "$1"
  fi
  record_install "$1"
}

# A meetingbox.app from v1.2.0, built before setup kept its list, is still ours:
# it carries meetingbox's bundle ID.
adopt_own_app() {
  [ -f "$APP_DIR/Contents/Info.plist" ] || return 0
  id="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$APP_DIR/Contents/Info.plist" 2>/dev/null || true)"
  [ "$id" = "$APP_ID" ] && record_install "$APP_DIR"
  return 0
}

macos_major() { sw_vers -productVersion 2>/dev/null | cut -d. -f1; }

open_privacy() {
  have open || return 0
  open "x-apple.systempreferences:com.apple.preference.security?Privacy_$1" >/dev/null 2>&1 || true
}

on_path() { case ":$PATH:" in *":$BIN_DIR:"*) return 0 ;; *) return 1 ;; esac; }

recorder_ready() { [ -x "$APP_BIN" ]; }

# Start the recorder through `open`, so it runs as meetingbox.app in its own
# right rather than as a child of this shell. macOS grants Screen Recording and
# Microphone to the app that launched a process, so a child of Terminal would be
# Terminal's, and from a hotkey Shortcuts'. This way there is one grant, listed
# as meetingbox, whatever starts it. Launched this way it also keeps a live
# SIGINT, which a `&` job in a script does not, so stopping finalises the m4a.
# stdout goes to /dev/null: audio-capture streams raw PCM to stdout whenever it
# is not a terminal. Prints the new recorder's PID.
#
# The first launch after a rebuild can be slow while macOS checks the new
# signature, so it waits up to 10s. If the recorder still has not shown up, any
# that turns up for this folder later is stopped, never left recording alone.
launch_recorder() {
  out="$1"; name="$2"; log="$3"; shift 3
  open -n -g --stdout /dev/null --stderr "$log" "$APP_DIR" --args -o "$out" -n "$name" "$@" \
    >/dev/null 2>&1 || return 1
  i=0
  while [ "$i" -lt 100 ]; do
    p="$(recorder_pids "$out" | head -n 1)"
    [ -n "$p" ] && { printf '%s' "$p"; return 0; }
    sleep 0.1; i=$((i + 1))
  done
  stop_recorders "$out"
  return 1
}

# PIDs of the recorders writing into one folder, or of every meetingbox recorder
# when the folder is "". Every launch gets a folder of its own, so this names the
# right process however late it started. Matched as a fixed string, since a
# folder name is not a pattern.
recorder_pids() {
  ps -axo pid=,command= | NEEDLE="$APP_BIN -o ${1:+$1 -n }" awk '
    { pid = $1; sub(/^ *[0-9]+ /, "") }
    index($0, ENVIRON["NEEDLE"]) == 1 { print pid }'
}

stop_recorders() { for p in $(recorder_pids "$1"); do stop_proc "$p" "${2:-150}"; done; }

# Ask nicely, then insist, then stop asking. The shell's own job notices are
# swallowed so the user never sees "line 215: 1952 Killed".
stop_proc() {
  p="$1"; grace="${2:-150}"
  kill -INT "$p" 2>/dev/null || true
  i=0; while kill -0 "$p" 2>/dev/null && [ "$i" -lt "$grace" ]; do sleep 0.1; i=$((i + 1)); done
  if kill -0 "$p" 2>/dev/null; then
    kill -TERM "$p" 2>/dev/null || true
    i=0; while kill -0 "$p" 2>/dev/null && [ "$i" -lt 30 ]; do sleep 0.1; i=$((i + 1)); done
  fi
  if kill -0 "$p" 2>/dev/null; then kill -9 "$p" 2>/dev/null || true; fi
  { wait "$p"; } 2>/dev/null || true
}

# ------------------------------------------------------------------ setup steps

# swiftc is the thing actually needed, and `xcode-select -p` can report a path
# while the toolchain is still downloading, so test for the compiler itself.
need_xcode_clt()      { ! have swiftc; }
need_brew()           { ! have brew; }
need_audio_capture()  { ! recorder_ready; }
# fm rejects an empty prompt ("Missing prompt"), so the probe must send one or it
# reports the licence missing on every machine.
need_fm_license()     { have fm && ! printf 'ok' | fm respond -i 'Reply with the single word ok.' >/dev/null 2>&1; }

transcriber_present() { have speech-analyzer || have whisper-cli; }

brew_bin() {
  if [ -x /opt/homebrew/bin/brew ]; then printf '/opt/homebrew/bin/brew'
  elif [ -x /usr/local/bin/brew ]; then printf '/usr/local/bin/brew'
  else printf ''; fi
}

install_xcode_clt() {
  say "Xcode Command Line Tools"
  info "a one off Apple download, needed to compile the recorder"
  xcode-select --install >/dev/null 2>&1 || true
  info "an Apple installer window should have opened"
  pause_for "click through it, then come back here and press enter"
  if need_xcode_clt; then
    warn "still not detected. Finish the Apple installer, then run: meetingbox setup"
    return 1
  fi
  ok "Xcode Command Line Tools"
}

install_brew() {
  say "Homebrew"
  info "the package manager. It will ask for your Mac password."
  if ! /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"; then
    warn "Homebrew install did not finish"
    return 1
  fi
  b="$(brew_bin)"
  [ -n "$b" ] && eval "$("$b" shellenv)"
  have brew && ok "Homebrew" || { warn "Homebrew installed but not on PATH, reopen Terminal"; return 1; }
}

install_audio_capture() {
  say "the recorder (audio-capture)"
  info "captures the far side with ScreenCaptureKit and your mic together"
  info "no virtual audio driver, no aggregate device, nothing to reboot"
  mkdir -p "$SRC_DIR" "$BIN_DIR"
  if [ -d "$SRC_DIR/audio-capture/.git" ]; then
    git -C "$SRC_DIR/audio-capture" pull -q --ff-only || true
  else
    claim_path "$SRC_DIR/audio-capture" || return 1
    git clone -q --depth 1 "$AUDIO_CAPTURE_REPO" "$SRC_DIR/audio-capture" \
      || { warn "could not clone $AUDIO_CAPTURE_REPO"; return 1; }
  fi
  have swiftc || {
    warn "no Swift compiler, so the Command Line Tools are not ready yet"
    info "finish the Apple installer window, then run: meetingbox setup"
    return 1
  }
  info "compiling. The first Swift build on a Mac caches Apple's frameworks and can"
  info "sit silent for a few minutes. It has not hung, leave it be."
  ( cd "$SRC_DIR/audio-capture" \
    && swiftc -O -o audio-capture Sources/*.swift \
         -framework ScreenCaptureKit -framework AVFoundation -framework CoreMedia ) \
    || { warn "compile failed, see the output above"; return 1; }
  build_app "$SRC_DIR/audio-capture/audio-capture" || return 1
  ok "recorder -> $APP_DIR"
}

# Wrap the recorder in an app bundle with its own identity. Signed ad hoc, which
# is enough for macOS to remember the permissions against it. A rebuild changes
# the signature, so macOS may ask once more after one.
build_app() {
  adopt_own_app
  claim_path "$APP_DIR" || return 1
  mkdir -p "$APP_DIR/Contents/MacOS"
  install -m 755 "$1" "$APP_BIN"
  cat > "$APP_DIR/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>$APP_ID</string>
  <key>CFBundleName</key><string>meetingbox</string>
  <key>CFBundleDisplayName</key><string>meetingbox</string>
  <key>CFBundleExecutable</key><string>audio-capture</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$VERSION</string>
  <key>CFBundleVersion</key><string>$VERSION</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>LSUIElement</key><true/>
  <key>NSMicrophoneUsageDescription</key><string>meetingbox records your side of the meeting.</string>
  <key>NSAudioCaptureUsageDescription</key><string>meetingbox records the other side of the meeting.</string>
</dict>
</plist>
PLIST
  codesign --force --sign - --identifier "$APP_ID" "$APP_DIR" >/dev/null 2>&1 \
    || { warn "could not sign the recorder app"; return 1; }
  register_app
}

register_app() {
  [ -x "$LSREGISTER" ] && "$LSREGISTER" -f "$APP_DIR" >/dev/null 2>&1 || true
}

install_speech_analyzer() {
  say "the transcriber (Apple SpeechAnalyzer)"
  info "the same on device engine behind Notes transcription. Fast, no model to download."
  mkdir -p "$SRC_DIR" "$BIN_DIR"
  if [ -d "$SRC_DIR/speech-analyzer-cli/.git" ]; then
    git -C "$SRC_DIR/speech-analyzer-cli" pull -q --ff-only || true
  else
    claim_path "$SRC_DIR/speech-analyzer-cli" || return 1
    git clone -q --depth 1 "$SPEECH_ANALYZER_REPO" "$SRC_DIR/speech-analyzer-cli" \
      || { warn "could not clone $SPEECH_ANALYZER_REPO"; return 1; }
  fi
  # Its install script writes these two. Only ones it creates now count as ours.
  [ -e "$SA_APP" ] || record_install "$SA_APP"
  [ -e "$SA_LINK" ] || [ -L "$SA_LINK" ] || record_install "$SA_LINK"
  ( cd "$SRC_DIR/speech-analyzer-cli" && chmod +x scripts/install.sh && ./scripts/install.sh ) \
    || {
      warn "speech-analyzer build failed"
      # Seen on macOS 27: the Command Line Tools ship a Swift package library that
      # cannot link, so every Swift package fails with "Invalid manifest", however
      # simple. The recorder still builds because it calls swiftc directly.
      info "if the error above says 'Invalid manifest', the Command Line Tools are damaged."
      info "reinstalling them fixes it: sudo rm -rf /Library/Developer/CommandLineTools && xcode-select --install"
      return 1
    }
  have speech-analyzer && ok "speech-analyzer" || { warn "built but not on PATH"; return 1; }
}

install_whisper() {
  say "the transcriber (whisper.cpp)"
  have brew || { warn "needs Homebrew first"; return 1; }
  # whisper-cli needs 16kHz wav, which comes from ffmpeg. Skip brew's cache
  # cleanup, which otherwise deletes unrelated downloads as a side effect.
  pkgs="whisper-cpp"; have ffmpeg || pkgs="$pkgs ffmpeg"
  HOMEBREW_NO_INSTALL_CLEANUP=1 brew install $pkgs || { warn "brew install $pkgs failed"; return 1; }
  mkdir -p "$MODEL_DIR"
  if [ ! -s "$WHISPER_FILE" ]; then
    info "downloading the model, about 1.6GB, this is the slow bit"
    record_install "$WHISPER_FILE"
    curl -fL --progress-bar -o "$WHISPER_FILE.part" "$WHISPER_MODEL_URL" \
      || { warn "model download failed"; rm -f "$WHISPER_FILE.part"; return 1; }
    mv "$WHISPER_FILE.part" "$WHISPER_FILE"
  fi
  ok "whisper-cli + model"
}

accept_fm_license() {
  say "Apple model licence"
  info "one command, machine wide, asks for your Mac password"
  sudo fm license || { warn "licence not accepted"; return 1; }
  ok "fm licence accepted"
}

add_to_path() {
  on_path && return 0
  line="export PATH=\"\$HOME/.local/bin:\$PATH\""
  for rc in "$HOME/.zshrc" "$HOME/.bash_profile"; do
    [ -e "$rc" ] || [ "$rc" = "$HOME/.zshrc" ] || continue
    grep -qF '.local/bin' "$rc" 2>/dev/null || printf '\n# meetingbox\n%s\n' "$line" >> "$rc"
  done
  export PATH="$BIN_DIR:$PATH"
  ok "added $BIN_DIR to your PATH"
}

# One short recording to make macOS throw its permission prompts now, in setup,
# rather than halfway through a real meeting.
# The recorder gives up at once if Screen Recording is missing, so a non-empty
# file means both sides are being captured.
PERM_DIR="$STATE_DIR/permcheck"
test_recording() {
  clear_permcheck; mkdir -p "$PERM_DIR"
  p="$(launch_recorder "$PERM_DIR" permcheck "$PERM_DIR/log")" || return 1
  sleep 4
  stop_proc "$p" 60
  for f in "$PERM_DIR"/*_permcheck.m4a; do
    [ -s "$f" ] && { clear_permcheck; return 0; }
  done
  return 1
}

# Only the files the test writes, then the folder if that leaves it empty.
clear_permcheck() {
  rm -f "$PERM_DIR"/*_permcheck.m4a "$PERM_DIR/log"
  rmdir "$PERM_DIR" 2>/dev/null || true
}

prime_permissions() {
  say "permissions"
  info "macOS will ask to let ${c_b}meetingbox${c_0} use Screen Recording (that is how the"
  info "far side is captured) and the Microphone. Allow both."
  if test_recording; then ok "recording works"; return 0; fi

  warn "macOS has not allowed it yet"
  rule
  info "1. Opening Privacy settings now"
  info "2. Under ${c_b}Screen & System Audio Recording${c_0}, turn on ${c_b}meetingbox${c_0} in the top list"
  info "   (not the 'System Audio Recording Only' list below it)"
  info "3. Under ${c_b}Microphone${c_0}, turn on ${c_b}meetingbox${c_0} too"
  rule
  open_privacy ScreenCapture
  sleep 1
  open_privacy Microphone
  pause_for "press enter once both are on, and I will test again"

  if test_recording; then ok "recording works"; return 0; fi
  warn "still not recording"
  [ -s "$PERM_DIR/log" ] && sed 's/^/           /' "$PERM_DIR/log" >&2
  info "check both switches are on for meetingbox, then run: ${c_b}meetingbox setup${c_0}"
  info "to start the permissions over: ${c_b}meetingbox reset${c_0}"
  return 1
}

make_shortcut_hint() {
  rule
  say "want it on a hotkey?"
  info "Shortcuts app, new shortcut, add a ${c_b}Run Shell Script${c_0} action, shell /bin/bash:"
  printf '\n' >&2
  printf '%s\n' "${c_c}             export PATH=\"\$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:\$PATH\"${c_0}" >&2
  printf '%s\n' "${c_c}             meetingbox${c_0}" >&2
  printf '\n' >&2
  info "then set a keyboard shortcut in the details pane and tick Pin in Menu Bar."
  info "First press records, second press writes the minutes."
  rule
}

setup() {
  printf '\n' >&2
  say "setup ${c_dim}v$VERSION${c_0}"
  rule

  v="$(macos_major)"
  if [ -z "$v" ]; then
    die "this only runs on macOS"
  elif [ "$v" -lt 27 ] 2>/dev/null; then
    miss "macOS $v. The on device model (fm) arrived in macOS 27."
    info "Recording and transcribing will still work, the summary will not."
  else
    ok "macOS $v"
  fi

  # --- survey, before asking for anything ---
  todo=""
  need_xcode_clt      && { miss "Xcode Command Line Tools";    todo="$todo clt"; }      || ok "Xcode Command Line Tools"
  need_audio_capture  && { miss "audio-capture (the recorder)"; todo="$todo capture"; }  || ok "audio-capture (the recorder)"
  transcriber_present && ok "a transcriber" || { miss "a transcriber"; todo="$todo transcriber"; }
  if have fm; then
    if need_fm_license; then miss "Apple model licence not accepted"; todo="$todo license"
    else ok "fm, licence accepted"; fi
  else
    miss "fm not found (ships with macOS 27)"
  fi
  on_path || { miss "$BIN_DIR is not on your PATH"; todo="$todo path"; }

  rule
  if [ -z "$todo" ]; then
    say "everything is already in place"
    prime_permissions || return 1
    install -m 755 "$0" "$BIN_DIR/meetingbox" 2>/dev/null || true
    make_shortcut_hint
    say "ready. Run ${c_b}meetingbox${c_0} to start a recording."
    return 0
  fi

  n="$(printf '%s' "$todo" | wc -w | tr -d ' ')"
  if [ "$n" = 1 ]; then say "one thing to install. I can do it from here."
  else say "$n things to install. I can do all of them from here."; fi
  info "some steps may ask for your Mac password, and Apple may open an installer window."
  confirm "go ahead?" || { info "nothing changed. Run 'meetingbox setup' when you are ready."; return 1; }
  rule

  case " $todo " in *" path "*) add_to_path ;; esac
  case " $todo " in *" clt "*)  install_xcode_clt || return 1 ;; esac

  case " $todo " in
    *" capture "*) install_audio_capture || return 1 ;;
  esac

  case " $todo " in
    *" transcriber "*)
      if [ "${v:-0}" -ge 26 ] 2>/dev/null && confirm "use Apple's built in transcriber? (fast, no 1.6GB download)"; then
        install_speech_analyzer || {
          warn "the Apple transcriber did not build"
          # The fallback is Homebrew plus a 1.6GB model, a different thing to what
          # was agreed, so ask again rather than carry on.
          confirm "use whisper.cpp instead? (Homebrew, about 1.6GB download)" || return 1
          if need_brew; then install_brew || return 1; fi
          install_whisper || return 1
        }
      else
        need_brew && { confirm "whisper.cpp needs Homebrew, install it?" && install_brew || return 1; }
        install_whisper || return 1
      fi ;;
  esac

  case " $todo " in *" license "*) accept_fm_license || true ;; esac

  rule
  install -m 755 "$0" "$BIN_DIR/meetingbox" 2>/dev/null \
    && ok "meetingbox -> $BIN_DIR/meetingbox" || true

  prime_permissions || return 1
  make_shortcut_hint
  say "ready. Run ${c_b}meetingbox${c_0} to start a recording."
}

doctor() {
  say "check"
  v="$(macos_major)"; [ -n "$v" ] && ok "macOS $v" || miss "not macOS"
  recorder_ready      && ok "recorder (meetingbox.app)" || miss "recorder (meetingbox.app)"
  have speech-analyzer && ok "speech-analyzer" || info "speech-analyzer not installed"
  have whisper-cli    && ok "whisper-cli"     || info "whisper-cli not installed"
  transcriber_present || miss "no transcriber at all"
  if have fm; then
    need_fm_license && miss "fm licence not accepted (sudo fm license)" || ok "fm"
  else miss "fm"; fi
  on_path && ok "$BIN_DIR on PATH" || miss "$BIN_DIR not on PATH"
  if recorder_ready; then
    info "microphones the recorder can see:"
    "$APP_BIN" -l 2>&1 | sed 's/^/             /' >&2 || true
  fi
  info "if anything is missing: meetingbox setup"
}

# ------------------------------------------------------------------- recording

# The recorder is found by the folder it writes to, not by a saved PID, so a
# PID reused after a crash or reboot can never be mistaken for it.
session_dir()  { cat "$DIR_FILE" 2>/dev/null || true; }
is_recording() { d="$(session_dir)"; [ -n "$d" ] && [ -n "$(recorder_pids "$d")" ]; }

# A session whose recorder died on its own (crash, sleep, force quit) still has
# audio worth keeping, so the next press should finish it, not start a new one.
has_session() { [ -f "$DIR_FILE" ]; }

# Start and stop run one at a time. A double tap on the hotkey would otherwise
# start two recorders, or try to stop one that is still starting.
LOCK="$STATE_DIR/busy"
take_lock() {
  if ! mkdir "$LOCK" 2>/dev/null; then
    holder="$(cat "$LOCK/pid" 2>/dev/null || true)"
    if [ -z "$holder" ] || kill -0 "$holder" 2>/dev/null; then
      die "meetingbox is busy starting or stopping a recording, try again in a moment"
    fi
    release_lock   # left behind by a run that crashed
    mkdir "$LOCK" 2>/dev/null || die "meetingbox is busy, try again in a moment"
  fi
  printf '%s' "$$" > "$LOCK/pid"
  trap release_lock EXIT
}
release_lock() { rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null || true; }

newest_m4a() {
  found=""
  for f in "$1"/*.m4a; do
    [ -e "$f" ] || continue
    [ -z "$found" ] && found="$f" && continue
    [ "$f" -nt "$found" ] && found="$f"
  done
  printf '%s' "$found"
}

start_recording() {
  recorder_ready || die "the recorder is not installed yet. Run: meetingbox setup"
  if is_recording; then
    warn "already recording in $(session_dir)"
    return 0
  fi
  if has_session; then
    warn "an earlier recording was never finished: $(session_dir)"
    info "it is still on disk. To get its minutes: meetingbox process <the .m4a in that folder>"
  fi

  stamp="$(date +%Y-%m-%d_%H%M)"
  dir="$BASE_DIR/$stamp"
  # Two recordings in the same minute would otherwise share a folder, and the
  # second would overwrite the first meeting's audio and minutes.
  [ -e "$dir" ] && dir="$BASE_DIR/$(date +%Y-%m-%d_%H%M%S)"
  mkdir -p "$dir"
  printf '%s' "$dir" > "$DIR_FILE"

  pid="$(launch_recorder "$dir" meeting "$dir/capture.log" ${MIC:+-d "$MIC"})" || pid=""
  [ -n "$pid" ] && sleep 2
  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$DIR_FILE"
    [ -s "$dir/capture.log" ] && sed 's/^/           /' "$dir/capture.log" >&2
    # nothing recorded, so drop the log just shown and the folder made above
    if [ -z "$(newest_m4a "$dir")" ]; then
      rm -f "$dir/capture.log"; rmdir "$dir" 2>/dev/null || true
    fi
    die "the recorder stopped immediately. Usually a missing permission: meetingbox setup"
  fi

  say "recording ${c_dim}->${c_0} $dir"
  info "press the key again, or run 'meetingbox stop', to finish"
  notify "meetingbox" "Recording"
}

STOPPED_AUDIO=""
stop_recording() {
  has_session || die "not recording"
  dir="$(session_dir)"

  if is_recording; then
    stop_recorders "$dir"
  else
    warn "the recorder had already stopped, picking up what it wrote"
  fi
  rm -f "$DIR_FILE"

  audio="$(newest_m4a "$dir")"
  if [ -z "$audio" ] || [ ! -s "$audio" ]; then
    [ -s "$dir/capture.log" ] && sed 's/^/           /' "$dir/capture.log" >&2
    die "no recording was written in $dir"
  fi
  [ "$audio" = "$dir/audio.m4a" ] || { mv -f "$audio" "$dir/audio.m4a"; audio="$dir/audio.m4a"; }

  secs=""
  have ffprobe && secs="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$audio" 2>/dev/null || true)"
  if [ -n "$secs" ]; then ok "stopped, ${secs%.*}s captured"; else ok "stopped"; fi
  notify "meetingbox" "Transcribing"
  STOPPED_AUDIO="$audio"
}

# ----------------------------------------------------------------- transcribing

pick_engine() {
  case "$ENGINE" in
    native)  have speech-analyzer || die "speech-analyzer not installed. Run: meetingbox setup"; printf 'native' ;;
    whisper) have whisper-cli     || die "whisper-cli not installed. Run: meetingbox setup";     printf 'whisper' ;;
    auto)
      if have speech-analyzer; then printf 'native'
      elif have whisper-cli;   then printf 'whisper'
      else die "no transcriber installed. Run: meetingbox setup"; fi ;;
    *) die "unknown engine: $ENGINE" ;;
  esac
}

find_whisper_model() {
  [ -n "$WHISPER_MODEL" ] && { printf '%s' "$WHISPER_MODEL"; return; }
  for c in \
    "$MODEL_DIR/ggml-large-v3-turbo.bin" \
    "$HOME/Models/ggml-large-v3-turbo.bin" \
    "$HOME/.whisper-models/ggml-large-v3-turbo.bin"
  do
    [ -f "$c" ] && { printf '%s' "$c"; return; }
  done
  printf ''
}

transcribe() {
  audio="$1"; out="$2"
  engine="$(pick_engine)"

  case "$engine" in
    native)
      say "transcribing on device (Apple SpeechAnalyzer)"
      speech-analyzer --locale "$LOCALE" "$audio" > "$out" \
        || die "transcription failed. Check Speech Recognition in Privacy settings, or run: meetingbox setup"
      ;;
    whisper)
      model="$(find_whisper_model)"
      [ -n "$model" ] || die "no whisper model found. Run: meetingbox setup"
      have ffmpeg || die "whisper.cpp needs ffmpeg for the 16kHz conversion. brew install ffmpeg"
      wav="${audio%.*}.16k.wav"
      say "transcribing on device (whisper.cpp, $(basename "$model"))"
      ffmpeg -hide_banner -loglevel error -y -i "$audio" -ar 16000 -ac 1 -c:a pcm_s16le "$wav"
      whisper-cli -m "$model" -f "$wav" --no-timestamps \
        --output-txt --output-file "${out%.txt}" >/dev/null || die "whisper-cli failed"
      rm -f "$wav"
      ;;
  esac

  [ -s "$out" ] || die "the transcript came out empty. Was there any sound?"
  ok "transcript: $(wc -w < "$out" | tr -d ' ') words"
}

# ------------------------------------------------------------------ summarising

token_count() {
  if have fm; then
    n="$(fm count-tokens < "$1" 2>/dev/null | tr -dc '0-9\n' | grep -m1 '[0-9]' || true)"
    [ -n "$n" ] && { printf '%s' "$n"; return; }
  fi
  awk '{n += NF} END {printf "%d", n * 1.35}' "$1"
}

# fm ignores stdin if given a positional prompt, so the prompt goes in -i and
# the content arrives on stdin.
fm_run() {
  instr="$1"; input="$2"; shift 2
  fm respond -i "$instr" "$@" < "$input"
}

# A dense slice can need more answer than the window has room for, and fm then
# fails with "exceeded the model's context size". Dropping it would quietly lose
# decisions, so halve the slice and try again, down to a floor. Output is held
# until the call succeeds, because fm streams and a failed call prints half an answer.
fm_fold() {
  local instr="$1" input="$2" words="$3" sub c
  if fm_run "$instr" "$input" > "$input.out" 2>/dev/null; then
    cat "$input.out"; return 0
  fi
  [ "$words" -gt 200 ] || return 1
  info "  too dense for one pass, splitting it"
  sub="$input.split"
  split_chunks "$input" "$sub" $((words / 2)) > "$sub.list"
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    fm_fold "$instr" "$c" $((words / 2)) || return 1
    printf '\n'
  done < "$sub.list"
}

# Fold by word count, not by line: a transcript can arrive as one long paragraph.
# Break at a sentence end once past the target, with a hard cap so text without
# punctuation still splits.
split_chunks() {
  infile="$1"; outdir="$2"; n="$3"
  mkdir -p "$outdir"
  awk -v n="$n" -v dir="$outdir" '
    function newfile() { part++; w = 0; file = sprintf("%s/chunk-%03d.txt", dir, part) }
    BEGIN { part = 0; newfile() }
    {
      for (i = 1; i <= NF; i++) {
        printf "%s%s", (w > 0 ? " " : ""), $i > (file)
        w++
        if ((w >= n && $i ~ /[.!?]["'"'"')]?$/) || w >= n * 1.5) {
          printf "\n" > (file); close(file); newfile()
        }
      }
    }
    END { printf "\n" > (file); close(file) }
  ' "$infile"

  for f in "$outdir"/chunk-*.txt; do
    [ -e "$f" ] || continue
    if [ -s "$f" ] && grep -q '[^[:space:]]' "$f"; then printf '%s\n' "$f"; else rm -f "$f"; fi
  done
}

summarise() {
  transcript="$1"; dir="$2"
  have fm || die "fm not found. It ships with macOS 27. Run: meetingbox setup"

  # A fresh folder made here, so the clean up at the end can only delete that.
  work="$(mktemp -d "${dir:?}/.work.XXXXXX")" || die "could not make a working folder in $dir"
  merged="$work/merged.txt"

  tokens="$(token_count "$transcript")"; tokens="${tokens:-0}"
  info "transcript is ~$tokens tokens, the on device window is ~4000"

  if [ "$tokens" -le "$TOKEN_CEILING" ]; then
    info "fits in one pass"
    cp "$transcript" "$merged"
  else
    # Chunk lists go through files, not bash arrays: stock macOS bash is 3.2,
    # where `mapfile` is missing and an empty array trips `set -u`.
    list="$work/chunks.list"
    split_chunks "$transcript" "$work/chunks" "$CHUNK_WORDS" > "$list"
    total="$(grep -c . "$list" 2>/dev/null || true)"
    [ "${total:-0}" -gt 0 ] || die "chunking produced nothing, the transcript may be unreadable"
    say "summarising in $total slices"

    : > "$merged"
    i=0
    while IFS= read -r c; do
      [ -n "$c" ] || continue
      i=$((i + 1))
      info "slice $i/$total"
      {
        printf '\n## slice %d of %d\n\n' "$i" "$total"
        fm_fold "$MAP_INSTRUCTIONS" "$c" "$CHUNK_WORDS" || {
          warn "slice $i could not be summarised, its text is kept verbatim in notes-raw.md"
          cat "$c"; }
      } >> "$merged"
    done < "$list"

    round=0
    while [ "$(token_count "$merged")" -gt "$TOKEN_CEILING" ]; do
      round=$((round + 1))
      if [ "$round" -gt 4 ]; then warn "still over the window after 4 rounds, going with what we have"; break; fi
      info "folding, round $round"
      rlist="$work/reduce-$round.list"
      # Merging keeps every item, so the answer is about as long as the input.
      # Half size slices leave room for both inside the window.
      split_chunks "$merged" "$work/reduce-$round" $((CHUNK_WORDS / 2)) > "$rlist"
      next="$work/merged.r$round.txt"
      : > "$next"
      while IFS= read -r c; do
        [ -n "$c" ] || continue
        # On failure carry the notes forward unmerged rather than drop them.
        fm_fold "$REDUCE_INSTRUCTIONS" "$c" $((CHUNK_WORDS / 2)) >> "$next" || cat "$c" >> "$next"
        printf '\n' >> "$next"
      done < "$rlist"
      merged="$next"
    done
  fi

  cp "$merged" "$dir/notes-raw.md"

  say "writing the minutes"
  # fm streams, so a failed pass would leave half a file. Write aside, then move.
  # If the notes are still too big for the window, ship them whole rather than nothing.
  if ! fm_run "$FINAL_INSTRUCTIONS" "$merged" > "$work/final.md" 2>/dev/null; then
    warn "too much in this meeting for one final pass, so notes.md holds the merged notes in full"
    cp "$merged" "$work/final.md"
  fi
  mv "$work/final.md" "$dir/notes.md"

  # Structured record beside the prose, so downstream tooling gets something it
  # can parse rather than something it has to interpret.
  schema="$work/schema.json"
  if fm schema object --name MeetingBrief \
       --string summary \
       --string decisions --array \
       --string actions --array \
       --string open_questions --array \
       --string numbers_and_dates --array > "$schema" 2>/dev/null
  then
    if fm_run "$BRIEF_INSTRUCTIONS" "$merged" --schema "$schema" > "$dir/brief.json" 2>/dev/null; then
      ok "brief.json"
    else
      warn "structured pass failed, the prose minutes are still good"
      rm -f "$dir/brief.json"
    fi
  fi

  [ "${MB_DEBUG:-0}" = "1" ] || rm -rf "$work"
  ok "minutes: $dir/notes.md"
}

# ------------------------------------------------------------------- processing

process() {
  input="$1"
  [ -e "$input" ] || die "no such file: $input"
  dir="$(cd "$(dirname "$input")" && pwd)"
  transcript="$dir/transcript.txt"

  case "${input##*.}" in
    txt|md|vtt|srt)
      [ "$input" = "$transcript" ] || cp "$input" "$transcript" ;;
    *)
      transcribe "$input" "$transcript"
      [ "$KEEP_AUDIO" = "1" ] || rm -f "$input" ;;
  esac

  summarise "$transcript" "$dir"
  notify "meetingbox" "Minutes ready"

  if [ -t 1 ]; then
    printf '\n'; cat "$dir/notes.md"; printf '\n'
    have open && open "$dir/notes.md" 2>/dev/null || true
  fi
}

# ----------------------------------------------------------------------- reset
#
#   reset            stuck recording state, and meetingbox's macOS permissions
#   reset --tools    also what setup built, so setup starts from scratch
#   uninstall        also meetingbox itself
#
# Recordings are never touched. Only paths on setup's list (see remove_installed)
# are deleted, so nothing that was already on the Mac is, wherever an MB_*
# setting points.

# The v1.1.0 recorder sat in $BIN_DIR. Only a byte for byte copy of the one
# setup compiled counts as ours.
old_recorder() {
  [ -f "$BIN_DIR/audio-capture" ] && [ -f "$SRC_DIR/audio-capture/audio-capture" ] \
    && cmp -s "$BIN_DIR/audio-capture" "$SRC_DIR/audio-capture/audio-capture"
}

reset_cmd() {
  level="$1"   # state | tools | all
  [ "$level" = state ] || adopt_own_app
  say "reset"
  rule
  info "this will:"
  info "  stop any recorder left running and clear the recording state"
  info "  reset the Screen Recording and Microphone permissions for meetingbox,"
  info "  so macOS asks again next time"
  if [ "$level" != state ]; then
    ours="$(cat "$INSTALLED" 2>/dev/null || true)"
    info "  delete what setup installed:"
    n=0
    while IFS= read -r p; do
      if [ -n "$p" ] && { [ -e "$p" ] || [ -L "$p" ]; }; then info "    $p"; n=$((n + 1)); fi
    done <<< "$ours"
    if old_recorder; then info "    $BIN_DIR/audio-capture (from v1.1.0)"; n=$((n + 1)); fi
    [ "$n" -gt 0 ] || info "    nothing, setup has no record of installing anything"
    left=""
    for p in "$APP_DIR" "$SRC_DIR/audio-capture" "$SRC_DIR/speech-analyzer-cli" \
             "$SA_APP" "$SA_LINK" "$WHISPER_FILE"; do
      if { [ -e "$p" ] || [ -L "$p" ]; } && ! installed_by_us "$p"; then left="$left$p
"; fi
    done
    if [ -n "$left" ]; then
      info "  leave alone, meetingbox did not install these:"
      printf '%s' "$left" | while IFS= read -r p; do info "    $p"; done
    fi
  fi
  [ "$level" = all ] && info "  delete meetingbox itself:                 $BIN_DIR/meetingbox"
  info "your recordings in $BASE_DIR are not touched"
  rule
  confirm "go ahead?" no || { info "nothing changed"; return 1; }

  # recorder and state. Same 15s as stop, so a long recording can finish its file.
  stop_recorders ""
  if has_session; then
    info "the unfinished recording is kept in $(session_dir)"
  fi
  rm -f "$PID_FILE" "$DIR_FILE"   # recording.pid is from v1.2.0 and earlier
  clear_permcheck; release_lock
  ok "recording state cleared"

  # permissions, only meetingbox's own
  if [ -d "$APP_DIR" ]; then
    register_app
    if tccutil reset ScreenCapture "$APP_ID" >/dev/null 2>&1 \
       && tccutil reset Microphone "$APP_ID" >/dev/null 2>&1; then
      ok "permissions reset for meetingbox"
    else
      warn "could not reset permissions. Turn meetingbox off by hand in Privacy & Security"
    fi
  else
    info "the recorder app is not installed, so there are no meetingbox permissions to reset"
  fi

  if [ "$level" != state ]; then
    if installed_by_us "$APP_DIR" && [ -x "$LSREGISTER" ]; then
      "$LSREGISTER" -u "$APP_DIR" >/dev/null 2>&1 || true
    fi
    old_recorder && rm -f "$BIN_DIR/audio-capture"
    while IFS= read -r p; do
      if [ -n "$p" ]; then remove_installed "$p" || true; fi
    done <<< "$ours"
    # a half finished download of the model setup was fetching
    if printf '%s\n' "$ours" | grep -qxF -- "$WHISPER_FILE"; then rm -f "$WHISPER_FILE.part"; fi
    rmdir "$SRC_DIR" "$MODEL_DIR" 2>/dev/null || true
    ok "installed tools removed"
    if have brew && brew list whisper-cpp >/dev/null 2>&1; then
      info "Homebrew's whisper-cpp is left installed. To remove it: brew uninstall whisper-cpp"
    fi
  fi

  if [ "$level" = all ]; then
    rm -f "$BIN_DIR/meetingbox"
    [ -s "$INSTALLED" ] || rm -f "$INSTALLED"
    rmdir "$STATE_DIR" 2>/dev/null || true
    ok "meetingbox removed"
    info "the PATH line in your shell profile stays, other tools use ~/.local/bin too"
    return 0
  fi

  rule
  say "done. Run ${c_b}meetingbox setup${c_0} to set it up again."
}

usage() {
  cat <<'USAGE'
meetingbox: record, transcribe and summarise a meeting entirely on device.

  meetingbox setup                 install what is missing, next next next
  meetingbox                       toggle: start, or stop and write the minutes
  meetingbox start | stop | status
  meetingbox process <audio|txt>   run an existing file through the pipeline
  meetingbox doctor                what is installed and what is not
  meetingbox mics                  microphones the recorder can see
  meetingbox reset                 clear a stuck recording, ask for permissions again
  meetingbox reset --tools         also remove what setup built, to start setup afresh
  meetingbox uninstall             remove meetingbox (recordings are kept)
  meetingbox help

Options
  --mic "USB"            microphone, substring match   (MB_MIC)
  --dir ~/Meetings       where recordings land         (MB_DIR)
  --locale en-GB         transcription locale          (MB_LOCALE)
  --whisper | --native   pick the transcriber          (MB_ENGINE)
  --model <path>         whisper ggml model            (MB_WHISPER_MODEL)
  --no-keep-audio        bin the m4a once transcribed

Output lands in ~/Meetings/<date>_<time>/
  audio.m4a  transcript.txt  notes.md  notes-raw.md  brief.json
USAGE
}

# ------------------------------------------------------------------------ main

cmd=""
argfile=""
RESET_TOOLS=0
while [ $# -gt 0 ]; do
  case "$1" in
    --mic|--device) MIC="$2"; shift 2 ;;
    --dir)     BASE_DIR="$2"; shift 2 ;;
    --locale)  LOCALE="$2"; shift 2 ;;
    --model)   WHISPER_MODEL="$2"; ENGINE="whisper"; shift 2 ;;
    --whisper) ENGINE="whisper"; shift ;;
    --native)  ENGINE="native"; shift ;;
    --keep-audio)    KEEP_AUDIO=1; shift ;;
    --no-keep-audio) KEEP_AUDIO=0; shift ;;
    --tools)   RESET_TOOLS=1; shift ;;
    -v|--version) printf 'meetingbox %s\n' "$VERSION"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *)  if [ -z "$cmd" ]; then cmd="$1"; else argfile="$1"; fi; shift ;;
  esac
done

case "${cmd:-toggle}" in
  toggle)
    if ! has_session && ! recorder_ready; then
      warn "not set up yet"
      confirm "run setup now?" && setup || info "run 'meetingbox setup' when you are ready"
    else
      take_lock
      if has_session; then stop_recording; release_lock; process "$STOPPED_AUDIO"
      else start_recording; fi
    fi ;;
  start)   take_lock; start_recording ;;
  stop)    take_lock; stop_recording; release_lock; process "$STOPPED_AUDIO" ;;
  process) [ -n "$argfile" ] || die "usage: meetingbox process <audio-or-transcript>"
           process "$argfile" ;;
  setup)   setup ;;
  doctor|check) doctor ;;
  mics|devices)
    recorder_ready || die "the recorder is not installed. Run: meetingbox setup"
    "$APP_BIN" -l ;;
  status)  if is_recording; then ok "recording -> $(cat "$DIR_FILE")"; else info "idle"; fi ;;
  reset)
    if [ "$RESET_TOOLS" = 1 ]; then reset_cmd tools; else reset_cmd state; fi ;;
  uninstall) reset_cmd all ;;
  help)    usage ;;
  *)       die "unknown command: $cmd (try: meetingbox help)" ;;
esac
