#!/usr/bin/env bash
#
# meetingbox: one key, whole meeting. Record, transcribe, summarise, all on device.
#
#   press once  -> records you and everyone else
#   press again -> stops, transcribes, writes the minutes
#
# Nothing leaves the Mac. No account, no API key, no upload, no per seat fee.
#
#   meetingbox.app    ->  audio.m4a          ScreenCaptureKit + your mic, one clock
#                         (+ mic.m4a, call.m4a: each side on its own)
#   speech-analyzer   ->  transcript.txt     Apple SpeechAnalyzer, on device
#     or whisper-cli  ->  transcript.txt     whisper.cpp, if you prefer
#   mb-transcript     ->  transcript.txt     each side transcribed alone, labelled Me and Them
#   fm respond        ->  notes.md + brief.json
#
# First run: meetingbox setup
# It checks what is missing and offers to install it. Nothing to do by hand.
#
# Written for bash 3.2 and BSD userland, so it runs on a stock Mac.

set -euo pipefail

VERSION="1.3.1"

# --------------------------------------------------------------- configuration

BASE_DIR="${MB_DIR:-$HOME/Meetings}"
DIR_ARG="${MB_DIR:-}"                    # sent to the app only when given
ENGINE="${MB_ENGINE:-auto}"              # auto | native | whisper
LOCALE="${MB_LOCALE:-en-GB}"
MIC="${MB_MIC:-}"                        # substring match, empty = system default
WHISPER_MODEL="${MB_WHISPER_MODEL:-}"
KEEP_AUDIO="${MB_KEEP_AUDIO:-1}"
SOUNDS="${MB_SOUNDS:-1}"                 # 0 = no start, stop and done sounds

STATE_DIR="${MB_STATE_DIR:-$HOME/.meetingbox}"
PID_FILE="$STATE_DIR/recording.pid"
DIR_FILE="$STATE_DIR/recording.dir"

BIN_DIR="${MB_BIN_DIR:-$HOME/.local/bin}"
SRC_DIR="${MB_SRC_DIR:-$HOME/.local/share/meetingbox}"
MODEL_DIR="${MB_MODEL_DIR:-$HOME/.local/share/whisper}"
WHISPER_FILE="$MODEL_DIR/ggml-large-v3-turbo.bin"
# where speech-analyzer's own install script puts itself
SA_LINK="$HOME/.local/bin/speech-analyzer"
SA_APP="$HOME/.local/libexec/SpeechAnalyzerCLI.app"
SAY_BIN="/usr/bin/say"   # macOS text to speech; `say` here is meetingbox's own logger

# The recorder runs inside meetingbox.app so that macOS files the Screen
# Recording and Microphone permissions under "meetingbox", not under whichever
# app happened to start it (Terminal, Shortcuts, Raycast). One executable, three
# modes: `--record` is the recorder, `--recover DIR` finishes an interrupted
# recording, and with neither it is the app.
APP_ID="com.jediconcepts.meetingbox"
APP_DIR="$HOME/Applications/meetingbox.app"
# The Swift source lives in this repo, under native/recorder and native/app. setup
# builds it from a clone of the release tag, or from MB_SOURCE_DIR if set.
SOURCE_DIR="${MB_SOURCE_DIR:-$SRC_DIR/meetingbox}"
APP_BIN="$APP_DIR/Contents/MacOS/meetingbox"
# Merges the mic and call transcripts into one labelled Me and Them. Built from
# native/transcript alongside the app.
TRANSCRIPT_BIN="$SRC_DIR/mb-transcript"
# The app is signed with a certificate setup makes in the login keychain. macOS
# ties the permissions to that certificate, so they survive a rebuild.
SIGN_NAME="meetingbox local signing"
SIGN_KEYCHAIN="$HOME/Library/Keychains/login.keychain-db"
# macOS's own openssl: Homebrew's OpenSSL 3 writes .p12 files security cannot read.
OPENSSL="/usr/bin/openssl"
# Registering the app with LaunchServices is what lets tccutil find it by ID.
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

MEETINGBOX_REPO="https://github.com/JediConcepts/meetingbox"
SPEECH_ANALYZER_REPO="https://github.com/simonw/speech-analyzer-cli"
WHISPER_MODEL_URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin"

CHUNK_WORDS="${MB_CHUNK_WORDS:-1500}"    # ~2000 tokens, leaves room for the answer
TOKEN_CEILING="${MB_TOKEN_CEILING:-2600}"

MAP_INSTRUCTIONS='You are taking minutes. This is one slice of a longer meeting transcript, so write no introduction and no conclusion. Extract only what is actually in this text, under these headings, omitting any heading with nothing under it: DECISIONS (only what was agreed), ACTIONS (only something someone said they would do; name the owner if one was named), NUMBERS AND DATES, OPEN QUESTIONS, NOTABLE QUOTES. Be terse. Invent nothing. If a point is ambiguous, say so rather than resolving it. Lines may start with the speaker: "Me" is the person who recorded the meeting, "Them" is everyone on the other end of the call. Keep those labels when naming who said or owns something.'

REDUCE_INSTRUCTIONS='These are notes from consecutive slices of one meeting. Merge them into a single set of minutes. Drop duplicates, keep every distinct decision and action, keep the owner against each action, and preserve all numbers, dates and names exactly as written. Add nothing that is not in the notes. Same headings: DECISIONS, ACTIONS, NUMBERS AND DATES, OPEN QUESTIONS. Lines may start with the speaker: "Me" is the person who recorded the meeting, "Them" is everyone on the other end of the call. Keep those labels when naming who said or owns something.'

FINAL_INSTRUCTIONS='Write the final minutes of this meeting from the notes below, in Markdown, under exactly these four headings in this order. SUMMARY: three lines on what the meeting was about and what came of it. DECISIONS: only things the people in this meeting agreed, during it, about what happens next. ACTIONS: only things someone said they will do after the meeting. A story about the past is neither: something agreed or done before the meeting is not a decision or an action. Put an owner first only when the notes name one (a name, Me or Them). End every decision and action with the words from the notes that show it, in quotes; if you cannot quote the words, it did not happen, so leave it out. OPEN QUESTIONS: only questions still unanswered at the end; a question that was answered is not open. Under a heading with nothing that fits, write None. Many calls, interviews and chats decide nothing, and that is fine. No preamble and no sign off. Add nothing that is not in the notes.'

BRIEF_INSTRUCTIONS='Extract the structured record of this meeting from the notes below. Every item must come from the notes. Leave an array empty rather than guessing.'

# -------------------------------------------------------------------- plumbing

if [ -t 2 ]; then
  c_dim=$'\033[2m'; c_b=$'\033[1m'; c_r=$'\033[0;31m'
  c_g=$'\033[0;32m'; c_y=$'\033[0;33m'; c_c=$'\033[0;36m'; c_0=$'\033[0m'
else
  c_dim=; c_b=; c_r=; c_g=; c_y=; c_c=; c_0=
fi

say()  { printf '%s\n' "${c_b}meetingbox${c_0} $*" >&2; }
info() { printf '%s\n' "${c_dim}           $*${c_0}" >&2; }
ok()   { printf '%s\n' "${c_g}         +${c_0} $*" >&2; }
miss() { printf '%s\n' "${c_y}         -${c_0} $*" >&2; }
warn() { printf '%s\n' "${c_y}      warn${c_0} $*" >&2; }
die()  { printf '%s\n' "${c_r}     error${c_0} $*" >&2; exit 1; }
rule() { printf '%s\n' "${c_dim}           ------------------------------------------------${c_0}" >&2; }

have() { command -v "$1" >/dev/null 2>&1; }

# A short system sound, so a hotkey press is heard to work: there is nothing on
# screen. In the background, so it never holds up the recording.
chime() {
  [ "$SOUNDS" = 1 ] && have afplay || return 0
  local f
  case "$1" in start) f=Tink ;; stop) f=Pop ;; done) f=Glass ;; *) return 0 ;; esac
  afplay "/System/Library/Sounds/$f.aiff" >/dev/null 2>&1 &
  return 0
}

notify() {
  have osascript || return 0
  osascript -e "display notification \"${2//\"/}\" with title \"${1//\"/}\"" >/dev/null 2>&1 || true
}

# yes/no, default yes. If stdin is not a terminal (piped, or `curl | bash`) it
# falls back to /dev/tty, because a question about installing things on someone's
# machine has to be answered by a person. With no terminal at all the answer is
# NO: silently assuming yes would install software nobody agreed to.
# `[ -r /dev/tty ]` is not good enough: the node can be readable while opening it
# fails with ENXIO (no controlling terminal). The only honest test is to open it.
tty_src() {
  [ -t 0 ] && { printf 'stdin'; return 0; }
  ( exec < /dev/tty ) 2>/dev/null && { printf '/dev/tty'; return 0; }
  return 1
}

#   confirm "question"       Enter means yes
#   confirm "question" no    Enter means no, for anything that removes things
confirm() {
  src="$(tty_src)" || {
    warn "no terminal to ask on, so leaving it alone: $1"
    info "run it in Terminal and it will ask properly"
    return 1
  }
  if [ "${2:-yes}" = no ]; then hint="[y/N]"; else hint="[Y/n]"; fi
  printf '%s' "${c_c}         ? ${c_0}$1 ${c_dim}$hint${c_0} " >&2
  if [ "$src" = stdin ]; then read -r reply || return 1
  else read -r reply < /dev/tty || return 1; fi
  case "$reply" in
    [yY]|[yY][eE][sS]) return 0 ;;
    [nN]|[nN][oO])     return 1 ;;
    *) [ "${2:-yes}" != no ] ;;
  esac
}

pause_for() {
  src="$(tty_src)" || return 0
  printf '%s' "${c_c}         > ${c_0}$1 ${c_dim}[enter]${c_0} " >&2
  if [ "$src" = stdin ]; then read -r _ || true
  else read -r _ < /dev/tty || true; fi
}

mkdir -p "$STATE_DIR"

# ------------------------------------------------------------ what setup made
#
# Setup writes down every path it creates, at the moment it creates it. reset
# and uninstall delete only paths on that list. So a folder that was already
# there (your own clone, your own whisper model, whatever an MB_* setting points
# at) is never deleted, and remove_installed is the only recursive delete of
# anything setup installed.

INSTALLED="$STATE_DIR/installed"

record_install()  { installed_by_us "$1" || printf '%s\n' "$1" >> "$INSTALLED"; }
installed_by_us() { grep -qxF -- "$1" "$INSTALLED" 2>/dev/null; }

remove_installed() {
  p="$1"
  case "$p" in
    ""|/|"$HOME"|"$HOME"/) warn "refusing to remove '$p'"; return 1 ;;
    /*) ;;
    *) warn "refusing to remove '$p': not a path"; return 1 ;;
  esac
  installed_by_us "$p" || return 1
  rm -rf -- "$p"
  forget_install "$p"
}

forget_install() {
  { grep -vxF -- "$1" "$INSTALLED" || true; } > "$INSTALLED.tmp"
  mv -f "$INSTALLED.tmp" "$INSTALLED"
}

# Clear a path for setup to create. Something meetingbox made before is replaced;
# anything else is left alone and setup stops.
claim_path() {
  if [ -e "$1" ] || [ -L "$1" ]; then
    installed_by_us "$1" || {
      warn "$1 already exists and meetingbox did not create it, so I will not replace it"
      info "move it somewhere else, then run: meetingbox setup"
      return 1
    }
    remove_installed "$1"
  fi
  record_install "$1"
}

# A meetingbox.app from v1.2.0, built before setup kept its list, is still ours:
# it carries meetingbox's bundle ID.
adopt_own_app() {
  [ -f "$APP_DIR/Contents/Info.plist" ] || return 0
  id="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$APP_DIR/Contents/Info.plist" 2>/dev/null || true)"
  [ "$id" = "$APP_ID" ] && record_install "$APP_DIR"
  return 0
}

macos_major() { sw_vers -productVersion 2>/dev/null | cut -d. -f1; }

open_privacy() {
  have open || return 0
  open "x-apple.systempreferences:com.apple.preference.security?Privacy_$1" >/dev/null 2>&1 || true
}

on_path() { case ":$PATH:" in *":$BIN_DIR:"*) return 0 ;; *) return 1 ;; esac; }

# Ready means built, and built by this version, so updating meetingbox rebuilds it.
recorder_ready() {
  [ -x "$APP_BIN" ] || return 1
  [ -x "$TRANSCRIPT_BIN" ] || return 1
  local built
  built="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$APP_DIR/Contents/Info.plist" 2>/dev/null || true)"
  [ "$built" = "$VERSION" ]
}

# Start the recorder through `open`, so it runs as meetingbox.app in its own
# right rather than as a child of this shell. macOS grants Screen Recording and
# Microphone to the app that launched a process, so a child of Terminal would be
# Terminal's, and from a hotkey Shortcuts'. This way there is one grant, listed
# as meetingbox, whatever starts it. Launched this way it also keeps a live
# SIGINT, which a `&` job in a script does not, so stopping finalises the m4a.
# stdout goes to /dev/null: the recorder once streamed raw PCM there whenever it
# was not a terminal. Prints the new recorder's PID.
#
# The first launch after a rebuild can be slow while macOS checks the new
# signature, so it waits up to 10s. If the recorder still has not shown up, any
# that turns up for this folder later is stopped, never left recording alone.
launch_recorder() {
  out="$1"; name="$2"; log="$3"; shift 3
  open -n -g --stdout /dev/null --stderr "$log" "$APP_DIR" --args --record -o "$out" -n "$name" "$@" \
    >/dev/null 2>&1 || return 1
  i=0
  while [ "$i" -lt 100 ]; do
    p="$(recorder_pids "$out" | head -n 1)"
    [ -n "$p" ] && { printf '%s' "$p"; return 0; }
    sleep 0.1; i=$((i + 1))
  done
  stop_recorders "$out"
  return 1
}

# PIDs of the recorders writing into one folder, or of every meetingbox recorder
# when the folder is "". Every launch gets a folder of its own, so this names the
# right process however late it started. Matched as a fixed string, since a
# folder name is not a pattern.
recorder_pids() { pids_with_prefix "$APP_BIN --record -o ${1:+$1 -n }"; }

# PIDs of the processes whose command line starts with $1, a fixed string.
pids_with_prefix() {
  ps -axo pid=,command= | NEEDLE="$1" awk '
    { pid = $1; sub(/^ *[0-9]+ /, "") }
    index($0, ENVIRON["NEEDLE"]) == 1 { print pid }'
}

# A recording is being made or saved: a recorder or a recovery is running, or a
# meeting's meeting.json says recording or finalising. Rebuilding or re-signing
# the app underneath it could cost the meeting.
recording_busy() {
  [ -n "$(recorder_pids "")" ] && return 0
  [ -n "$(pids_with_prefix "$APP_BIN --recover ")" ] && return 0
  for j in "$BASE_DIR"/*/meeting.json; do
    [ -f "$j" ] || continue
    grep -Eq '"state"[[:space:]]*:[[:space:]]*"(recording|finalising)"' "$j" && return 0
  done
  return 1
}

stop_recorders() { for p in $(recorder_pids "$1"); do stop_proc "$p" "${2:-150}"; done; }

# Ask nicely, then insist, then stop asking. The shell's own job notices are
# swallowed so the user never sees "line 215: 1952 Killed".
stop_proc() {
  p="$1"; grace="${2:-150}"
  kill -INT "$p" 2>/dev/null || true
  i=0; while kill -0 "$p" 2>/dev/null && [ "$i" -lt "$grace" ]; do sleep 0.1; i=$((i + 1)); done
  if kill -0 "$p" 2>/dev/null; then
    kill -TERM "$p" 2>/dev/null || true
    i=0; while kill -0 "$p" 2>/dev/null && [ "$i" -lt 30 ]; do sleep 0.1; i=$((i + 1)); done
  fi
  if kill -0 "$p" 2>/dev/null; then
    kill -9 "$p" 2>/dev/null || true
    # Not this shell's child when launched with `open`, so `wait` cannot wait for
    # it, and -9 lands asynchronously: poll until it is gone, up to 5s, so that
    # recovery does not race a recorder still holding its folder.
    i=0; while kill -0 "$p" 2>/dev/null && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
  fi
  { wait "$p"; } 2>/dev/null || true
}

# ------------------------------------------------------------------ setup steps

# swiftc is the thing actually needed, and `xcode-select -p` can report a path
# while the toolchain is still downloading, so test for the compiler itself.
need_xcode_clt()      { ! have swiftc; }
need_brew()           { ! have brew; }
need_recorder()       { ! recorder_ready; }
# fm rejects an empty prompt ("Missing prompt"), so the probe must send one or it
# reports the licence missing on every machine.
need_fm_license()     { have fm && ! printf 'ok' | fm respond -i 'Reply with the single word ok.' >/dev/null 2>&1; }

transcriber_present() { have speech-analyzer || have whisper-cli; }

brew_bin() {
  if [ -x /opt/homebrew/bin/brew ]; then printf '/opt/homebrew/bin/brew'
  elif [ -x /usr/local/bin/brew ]; then printf '/usr/local/bin/brew'
  else printf ''; fi
}

install_xcode_clt() {
  say "Xcode Command Line Tools"
  info "a one off Apple download, needed to compile the recorder"
  xcode-select --install >/dev/null 2>&1 || true
  info "an Apple installer window should have opened"
  pause_for "click through it, then come back here and press enter"
  if need_xcode_clt; then
    warn "still not detected. Finish the Apple installer, then run: meetingbox setup"
    return 1
  fi
  ok "Xcode Command Line Tools"
}

install_brew() {
  say "Homebrew"
  info "the package manager. It will ask for your Mac password."
  if ! /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"; then
    warn "Homebrew install did not finish"
    return 1
  fi
  b="$(brew_bin)"
  [ -n "$b" ] && eval "$("$b" shellenv)"
  have brew && ok "Homebrew" || { warn "Homebrew installed but not on PATH, reopen Terminal"; return 1; }
}

# Make sure the recorder's source is on disk. MB_SOURCE_DIR is used as it is and
# never recorded or deleted. Otherwise it is a clone of this version's tag.
fetch_source() {
  if [ -n "${MB_SOURCE_DIR:-}" ]; then
    [ -f "$SOURCE_DIR/native/app/Main.swift" ] \
      || { warn "no app source in $SOURCE_DIR/native/app"; return 1; }
    return 0
  fi
  mkdir -p "$SRC_DIR"
  if [ -d "$SOURCE_DIR/.git" ] && installed_by_us "$SOURCE_DIR"; then
    git -C "$SOURCE_DIR" fetch --depth 1 origin tag "v$VERSION" >/dev/null 2>&1 \
      && git -C "$SOURCE_DIR" checkout -q "v$VERSION" \
      || { warn "could not fetch v$VERSION of meetingbox"; return 1; }
  else
    claim_path "$SOURCE_DIR" || return 1
    git clone -q --depth 1 --branch "v$VERSION" "$MEETINGBOX_REPO" "$SOURCE_DIR" \
      || { warn "could not clone $MEETINGBOX_REPO at v$VERSION"; return 1; }
  fi
  [ -f "$SOURCE_DIR/native/app/Main.swift" ] \
    || { warn "no app source in $SOURCE_DIR/native/app"; return 1; }
}

install_recorder() {
  say "the recorder"
  info "captures the far side with ScreenCaptureKit and your mic together"
  info "no virtual audio driver, no aggregate device, nothing to reboot"
  mkdir -p "$SRC_DIR" "$BIN_DIR"
  have swiftc || {
    warn "no Swift compiler, so the Command Line Tools are not ready yet"
    info "finish the Apple installer window, then run: meetingbox setup"
    return 1
  }
  fetch_source || return 1
  build_dir="$(mktemp -d)" || return 1
  info "compiling. The first Swift build on a Mac caches Apple's frameworks and can"
  info "sit silent for a few minutes. It has not hung, leave it be."
  # Apple deprecates names each macOS release; warnings are noise here, errors still show.
  if ! swiftc -O -o "$build_dir/mb-transcript" "$SOURCE_DIR"/native/transcript/*.swift -suppress-warnings; then
    rm -rf -- "$build_dir"
    warn "compile failed, see the output above"
    return 1
  fi
  build_app || { rm -rf -- "$build_dir"; return 1; }
  if ! { claim_path "$TRANSCRIPT_BIN" && install -m 755 "$build_dir/mb-transcript" "$TRANSCRIPT_BIN"; }; then
    rm -rf -- "$build_dir"
    return 1
  fi
  rm -rf -- "$build_dir"
  ok "recorder -> $APP_DIR"
  ok "transcript helper -> $TRANSCRIPT_BIN"
}

# Build meetingbox.app: the recorder and the app compiled into one executable,
# the icon and the Info.plist, signed with the meetingbox certificate so the
# permissions survive a rebuild. Without it the app is signed ad hoc, and macOS
# asks again after each update.
#
# The whole bundle is made in a temporary folder first. The installed app is
# replaced only once the new one is complete, so a failed build leaves the user
# with the app they had, still able to record.
build_app() {
  local had_ad_hoc=0 build_tmp bundle iconset s
  # from the app being replaced, before it is
  [ -d "$APP_DIR" ] && ! app_signed_by_us && had_ad_hoc=1
  adopt_own_app
  build_tmp="$(mktemp -d)" || return 1
  bundle="$build_tmp/meetingbox.app"
  iconset="$build_tmp/meetingbox.iconset"
  mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Resources" "$iconset"
  # Apple deprecates names each macOS release; warnings are noise here, errors still show.
  if ! swiftc -O -parse-as-library -o "$bundle/Contents/MacOS/meetingbox" \
         "$SOURCE_DIR"/native/recorder/*.swift "$SOURCE_DIR"/native/app/*.swift \
         -framework ScreenCaptureKit -framework AVFoundation -framework CoreMedia \
         -framework AppKit -framework SwiftUI -suppress-warnings; then
    rm -rf -- "$build_tmp"
    warn "compile failed, see the output above"
    return 1
  fi
  # The icon: every size macOS asks for, from the one 1024 px png.
  for s in 16 32 128 256 512; do
    sips -z "$s" "$s" "$SOURCE_DIR/native/app/icon.png" --out "$iconset/icon_${s}x${s}.png" >/dev/null 2>&1 \
      && sips -z "$((s * 2))" "$((s * 2))" "$SOURCE_DIR/native/app/icon.png" --out "$iconset/icon_${s}x${s}@2x.png" >/dev/null 2>&1 \
      || { rm -rf -- "$build_tmp"; warn "could not make the app icon"; return 1; }
  done
  iconutil -c icns "$iconset" -o "$bundle/Contents/Resources/meetingbox.icns" >/dev/null 2>&1 \
    || { rm -rf -- "$build_tmp"; warn "could not make the app icon"; return 1; }
  cat > "$bundle/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>$APP_ID</string>
  <key>CFBundleName</key><string>meetingbox</string>
  <key>CFBundleDisplayName</key><string>meetingbox</string>
  <key>CFBundleExecutable</key><string>meetingbox</string>
  <key>CFBundleIconFile</key><string>meetingbox</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$VERSION</string>
  <key>CFBundleVersion</key><string>$VERSION</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>LSUIElement</key><true/>
  <key>NSHighResolutionCapable</key><true/>
  <key>MBScriptPath</key><string>$BIN_DIR/meetingbox</string>
  <key>NSMicrophoneUsageDescription</key><string>meetingbox records your side of the meeting.</string>
  <key>NSAudioCaptureUsageDescription</key><string>meetingbox records the other side of the meeting.</string>
</dict>
</plist>
PLIST
  # Complete: now, and only now, replace the installed app.
  # ~/Applications is the user's own folder, so it is made if missing but never recorded.
  mkdir -p "$(dirname "$APP_DIR")"
  claim_path "$APP_DIR" || { rm -rf -- "$build_tmp"; return 1; }
  if ! mv "$bundle" "$APP_DIR"; then
    rm -rf -- "$build_tmp"
    warn "could not put meetingbox.app in $(dirname "$APP_DIR")"
    return 1
  fi
  rm -rf -- "$build_tmp"
  if sign_app; then
    register_app
    if [ "$had_ad_hoc" = 1 ]; then forget_old_approvals; fi
  else
    warn "could not use the meetingbox signing certificate, so macOS will ask for permissions again after each update"
    codesign --force --sign - --identifier "$APP_ID" "$APP_DIR" >/dev/null 2>&1 \
      || { warn "could not sign the recorder app"; return 1; }
    register_app
  fi
}

# macOS ties Screen Recording and the Microphone to the app's signature. Once an
# app that was signed ad hoc is signed with the certificate, its old approvals
# still show as on in Privacy settings but no longer apply, and turning them off
# and on does not help. Clear them so macOS asks afresh, this one last time.
forget_old_approvals() {
  tccutil reset ScreenCapture "$APP_ID" >/dev/null 2>&1 || true
  tccutil reset Microphone "$APP_ID" >/dev/null 2>&1 || true
  info "meetingbox now has its own signature, so macOS will ask for Screen Recording and the Microphone once more"
}

# The one way the app is signed with the certificate: after a build, and by
# setup when the app is not signed by it (an earlier ad hoc fallback, or a
# certificate deleted since).
sign_app() {
  ensure_signing_identity || return 1
  tell_signing_prompt
  codesign --force --sign "$(signing_hash)" --keychain "$SIGN_KEYCHAIN" \
    --identifier "$APP_ID" "$APP_DIR" >/dev/null 2>&1
}

# setup's step for an app that is built but not signed by the certificate
resign_app() {
  say "the signing certificate"
  if sign_app; then
    register_app
    forget_old_approvals
    ok "meetingbox.app signed with the meetingbox certificate"
  else
    warn "could not use the meetingbox signing certificate, so macOS will ask for permissions again after each update"
  fi
}

# Adding the certificate to the keychain, and the first codesign with it, can
# each open a macOS dialog behind Terminal. Say so once, before either.
tell_signing_prompt() {
  [ "${SIGN_TOLD:-0}" = 1 ] && return 0
  info "macOS may ask for your login password so meetingbox can sign itself. Choose Always Allow."
  SIGN_TOLD=1
}

# Signed by the recorded certificate. For a self-signed certificate, codesign
# writes a designated requirement naming its SHA-1 (certificate leaf = H"..."),
# so this checks the very certificate, not a name.
app_signed_by_us() {
  local h req
  h="$(signing_hash)"
  is_sha1 "$h" || return 1
  req="$(codesign -d -r- "$APP_DIR" 2>&1)" || return 1
  h="$(printf '%s' "$h" | tr 'ABCDEF' 'abcdef')"
  req="$(printf '%s' "$req" | tr 'ABCDEF' 'abcdef')"
  case "$req" in *"H\"$h\""*) return 0 ;; esac
  return 1
}

register_app() {
  [ -x "$LSREGISTER" ] && "$LSREGISTER" -f "$APP_DIR" >/dev/null 2>&1 || true
}

# The certificate is known by its SHA-1 only, as recorded when setup made it.
# Its name is never used to find, sign with or delete it: security and codesign
# match a name as a substring, which could reach a certificate the user made.
is_sha1() {
  [ "${#1}" -eq 40 ] || return 1
  case "$1" in *[!0123456789ABCDEF]*) return 1 ;; esac
}
signing_hash() {
  sed -n '/^keychain:sha1:/{s/^keychain:sha1://;p;q;}' "$INSTALLED" 2>/dev/null || true
}

# Listed as an identity, so the private key is there too. Read into a variable
# first: grep -q closing a pipe early would kill security under pipefail. No -v,
# which hides a self-signed certificate that is not trusted.
identity_listed() {
  local ids
  is_sha1 "$1" || return 1
  ids="$(security find-identity -p codesigning "$SIGN_KEYCHAIN" 2>/dev/null)" || return 1
  case "$ids" in *" $1 "*) return 0 ;; esac
  return 1
}
have_signing_identity() { identity_listed "$(signing_hash)"; }

# A certificate setup did not make is never used or deleted, whatever its name.
# A self-signed one is enough: codesign does not need it trusted.
ensure_signing_identity() {
  local h tmp pw made=0
  # a development build recorded the name, not a particular certificate:
  # forget that line, and never delete by it
  if installed_by_us "keychain:$SIGN_NAME"; then forget_install "keychain:$SIGN_NAME"; fi
  have_signing_identity && return 0
  h="$(signing_hash)"
  if [ -n "$h" ]; then forget_install "keychain:sha1:$h"; fi
  tell_signing_prompt
  # an explicit template: macOS's mktemp -d on its own ignores TMPDIR
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/meetingbox-sign.XXXXXX")" || return 1
  # the private key is in $tmp until the import, so do not leave it on a Ctrl-C
  trap 'rm -rf -- "$tmp"; exit 130' INT
  trap 'rm -rf -- "$tmp"; exit 143' TERM
  # || true: head closing the pipe sends tr a SIGPIPE; the length check below
  # is what catches a short or empty password
  pw="$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c 24)" || true
  cat > "$tmp/cnf" <<CNF
[req]
distinguished_name = dn
x509_extensions = ext
prompt = no
[dn]
CN = $SIGN_NAME
[ext]
basicConstraints = critical, CA:false
keyUsage = critical, digitalSignature
extendedKeyUsage = critical, codeSigning
CNF
  if [ "${#pw}" -eq 24 ] \
     && "$OPENSSL" req -x509 -newkey rsa:2048 -nodes -days 3650 -config "$tmp/cnf" \
          -keyout "$tmp/key.pem" -out "$tmp/cert.pem" >/dev/null 2>&1 \
     && h="$("$OPENSSL" x509 -in "$tmp/cert.pem" -noout -fingerprint -sha1 2>/dev/null | sed 's/.*=//; s/://g')" \
     && is_sha1 "$h" \
     && "$OPENSSL" pkcs12 -export -inkey "$tmp/key.pem" -in "$tmp/cert.pem" \
          -name "$SIGN_NAME" -passout "pass:$pw" -out "$tmp/id.p12" >/dev/null 2>&1 \
     && security import "$tmp/id.p12" -k "$SIGN_KEYCHAIN" -P "$pw" -T /usr/bin/codesign >/dev/null 2>&1; then
    made=1
  fi
  rm -rf -- "$tmp"
  trap - INT TERM
  [ "$made" -eq 1 ] || return 1
  record_install "keychain:sha1:$h"
}

# Deletes only certificates recorded by hash. One already gone is forgotten.
remove_signing_identity() {
  local h rc=0
  if installed_by_us "keychain:$SIGN_NAME"; then forget_install "keychain:$SIGN_NAME"; fi
  while IFS= read -r h; do
    [ -n "$h" ] || continue
    if ! is_sha1 "$h"; then forget_install "keychain:sha1:$h"; continue; fi
    if security delete-identity -Z "$h" "$SIGN_KEYCHAIN" >/dev/null 2>&1 || ! identity_listed "$h"; then
      forget_install "keychain:sha1:$h"
    else
      warn "could not delete \"$SIGN_NAME\" ($h) from your login keychain. Delete it in Keychain Access"
      rc=1
    fi
  done <<< "$(sed -n 's/^keychain:sha1://p' "$INSTALLED" 2>/dev/null || true)"
  return "$rc"
}

install_speech_analyzer() {
  local sa build
  say "the transcriber (Apple SpeechAnalyzer)"
  info "the same on device engine behind Notes transcription. Fast, no model to download."
  mkdir -p "$SRC_DIR" "$BIN_DIR"
  sa="$SRC_DIR/speech-analyzer-cli"
  if [ -d "$sa/.git" ]; then
    git -C "$sa" pull -q --ff-only || true
  else
    claim_path "$sa" || return 1
    git clone -q --depth 1 "$SPEECH_ANALYZER_REPO" "$sa" \
      || { warn "could not clone $SPEECH_ANALYZER_REPO"; return 1; }
  fi
  # Built with swiftc, as the recorder is, not with its install script: that runs
  # `swift build`, and on some macOS 27 Command Line Tools SwiftPM cannot link at
  # all ("Invalid manifest"). The core library is its own module, so it goes first.
  build="$(mktemp -d "${TMPDIR:-/tmp}/mb-sa.XXXXXX")" || return 1
  if ! { swiftc -O -suppress-warnings -parse-as-library -module-name SpeechAnalyzerCore \
           -emit-module -emit-module-path "$build/SpeechAnalyzerCore.swiftmodule" \
           -emit-library -static -o "$build/libSpeechAnalyzerCore.a" "$sa"/Sources/SpeechAnalyzerCore/*.swift \
         && swiftc -O -suppress-warnings -parse-as-library -module-name SpeechAnalyzerCLI \
           -I "$build" -L "$build" -lSpeechAnalyzerCore \
           -o "$build/speech-analyzer" "$sa"/Sources/SpeechAnalyzerCLI/*.swift; }; then
    rm -rf -- "$build"
    warn "Apple's transcriber did not build, see the output above"
    return 1
  fi
  if ! { claim_path "$SA_APP" && claim_path "$SA_LINK"; }; then
    rm -rf -- "$build"
    return 1
  fi
  mkdir -p "$SA_APP/Contents/MacOS" "$(dirname "$SA_LINK")"
  cp "$sa/Resources/Info.plist" "$SA_APP/Contents/Info.plist"
  install -m 755 "$build/speech-analyzer" "$SA_APP/Contents/MacOS/speech-analyzer"
  rm -rf -- "$build"
  # An app bundle, so macOS can ask for Speech Recognition by name.
  codesign --force --sign - "$SA_APP" >/dev/null 2>&1 || warn "could not sign $SA_APP"
  ln -sfn "$SA_APP/Contents/MacOS/speech-analyzer" "$SA_LINK"
  have speech-analyzer && ok "speech-analyzer" || { warn "built but not on PATH"; return 1; }
}

install_whisper() {
  say "the transcriber (whisper.cpp)"
  have brew || { warn "needs Homebrew first"; return 1; }
  # whisper-cli needs 16kHz wav, which comes from ffmpeg. Skip brew's cache
  # cleanup, which otherwise deletes unrelated downloads as a side effect.
  pkgs="whisper-cpp"; have ffmpeg || pkgs="$pkgs ffmpeg"
  HOMEBREW_NO_INSTALL_CLEANUP=1 brew install $pkgs || { warn "brew install $pkgs failed"; return 1; }
  mkdir -p "$MODEL_DIR"
  if [ ! -s "$WHISPER_FILE" ]; then
    info "downloading the model, about 1.6GB, this is the slow bit"
    record_install "$WHISPER_FILE"
    curl -fL --progress-bar -o "$WHISPER_FILE.part" "$WHISPER_MODEL_URL" \
      || { warn "model download failed"; rm -f "$WHISPER_FILE.part"; return 1; }
    mv "$WHISPER_FILE.part" "$WHISPER_FILE"
  fi
  ok "whisper-cli + model"
}

accept_fm_license() {
  say "Apple model licence"
  info "one command, machine wide, asks for your Mac password"
  sudo fm license || { warn "licence not accepted"; return 1; }
  ok "fm licence accepted"
}

add_to_path() {
  on_path && return 0
  line="export PATH=\"\$HOME/.local/bin:\$PATH\""
  for rc in "$HOME/.zshrc" "$HOME/.bash_profile"; do
    [ -e "$rc" ] || [ "$rc" = "$HOME/.zshrc" ] || continue
    grep -qF '.local/bin' "$rc" 2>/dev/null || printf '\n# meetingbox\n%s\n' "$line" >> "$rc"
  done
  export PATH="$BIN_DIR:$PATH"
  ok "added $BIN_DIR to your PATH"
}

# One short recording to make macOS throw its permission prompts now, in setup,
# rather than halfway through a real meeting.
# The recorder gives up at once if Screen Recording is missing, so a non-empty
# audio.m4a means both sides are being captured.
PERM_DIR="$STATE_DIR/permcheck"
test_recording() {
  clear_permcheck; mkdir -p "$PERM_DIR"
  p="$(launch_recorder "$PERM_DIR" permcheck "$PERM_DIR/log")" || return 1
  sleep 4
  stop_proc "$p" 60
  [ -s "$PERM_DIR/audio.m4a" ] && { clear_permcheck; return 0; }
  return 1
}

# Only the files the test writes (the recorder's working files among them, and
# the one v1.2.2's test wrote), then the folder if that leaves it empty.
clear_permcheck() {
  rm -f "$PERM_DIR/audio.m4a" "$PERM_DIR/mic.m4a" "$PERM_DIR/call.m4a" "$PERM_DIR/log" \
        "$PERM_DIR/mic.caf" "$PERM_DIR/call.caf" "$PERM_DIR/.recording-complete" \
        "$PERM_DIR/.tmp-audio.m4a" "$PERM_DIR/.tmp-mic.m4a" "$PERM_DIR/.tmp-call.m4a" \
        "$PERM_DIR/.tmp-recording-complete" \
        "$PERM_DIR"/*_permcheck.m4a
  rmdir "$PERM_DIR" 2>/dev/null || true
}

# Speech Recognition for Apple's transcriber, asked for with a short spoken clip
# so macOS prompts now, during setup, not in the middle of the first meeting.
# whisper does not need it, so giving up here never fails setup.
prime_speech() {
  have speech-analyzer || return 0
  local tmp tries=0
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/mb-speech.XXXXXX")" || return 0
  if ! "$SAY_BIN" -o "$tmp/check.aiff" "meetingbox speech check" 2>/dev/null; then
    rm -rf -- "$tmp"; return 0
  fi
  say "Speech Recognition"
  info "macOS will ask to let ${c_b}speech-analyzer${c_0} (Apple's transcriber) use Speech Recognition. Allow it."
  while :; do
    if sa_run "$tmp/check.txt" "$tmp/check.aiff" 2>/dev/null; then ok "Speech Recognition works"; break; fi
    if [ "$tries" -ge 3 ]; then
      warn "Apple's transcriber still cannot run, so meetingbox will use whisper if it is installed"
      info "to try again later: turn on speech-analyzer under Speech Recognition, then run: ${c_b}meetingbox setup${c_0}"
      break
    fi
    tries=$((tries + 1))
    warn "Speech Recognition is not on for speech-analyzer yet"
    rule
    info "1. Opening Privacy settings at ${c_b}Speech Recognition${c_0}"
    info "2. Turn on ${c_b}speech-analyzer${c_0}"
    info "Already on? Turn it off and on again."
    rule
    open_privacy SpeechRecognition
    pause_for "press enter once it is on, and I will test again"
  done
  rm -rf -- "$tmp"
  return 0
}

# macOS asks for these one at a time, in the order the recorder uses them. The
# recorder starts system audio first and stops there if Screen Recording is off,
# so it never reaches the mic, and meetingbox cannot appear in the Microphone list
# until Screen Recording works. So: test, read which one failed, fix that one,
# test again.
prime_permissions() {
  say "permissions"
  info "macOS will ask to let ${c_b}meetingbox${c_0} use Screen Recording (that is how the"
  info "far side is captured), and then the Microphone. Allow both."
  tries=0
  while :; do
    if test_recording; then ok "recording works"; return 0; fi
    [ "$tries" -lt 3 ] || break
    tries=$((tries + 1))
    if grep -q 'start system audio' "$PERM_DIR/log" 2>/dev/null; then
      warn "Screen Recording is not on for meetingbox yet"
      rule
      info "1. Opening Privacy settings at ${c_b}Screen & System Audio Recording${c_0}"
      info "2. Turn on ${c_b}meetingbox${c_0} in the top list"
      info "   (not the 'System Audio Recording Only' list below it)"
      info "3. Not in the list? Drag the meetingbox app from the Finder window I am"
      info "   opening into that list, then turn it on"
      info "Already on? Turn it off and on again, or select it, remove it with the minus button and test again."
      info "The Microphone comes after this. macOS asks for it on the next test."
      rule
      open_privacy ScreenCapture
      open -R "$APP_DIR" >/dev/null 2>&1 || true
    elif grep -q 'start microphone' "$PERM_DIR/log" 2>/dev/null; then
      warn "the Microphone is not on for meetingbox yet"
      rule
      info "1. Opening Privacy settings at ${c_b}Microphone${c_0}"
      info "2. Turn on ${c_b}meetingbox${c_0}"
      info "Already on? Turn it off and on again, or select it, remove it with the minus button and test again."
      rule
      open_privacy Microphone
    else
      warn "the recorder did not start"
      [ -s "$PERM_DIR/log" ] && sed 's/^/           /' "$PERM_DIR/log" >&2
      break
    fi
    pause_for "press enter once it is on, and I will test again"
  done
  warn "still not recording"
  info "check Screen & System Audio Recording and Microphone are both on for meetingbox,"
  info "then run: ${c_b}meetingbox setup${c_0}"
  info "to start the permissions over: ${c_b}meetingbox reset${c_0}"
  return 1
}

make_shortcut_hint() {
  rule
  say "want it on a hotkey?"
  info "Shortcuts app, new shortcut, add a ${c_b}Run Shell Script${c_0} action, shell /bin/bash:"
  printf '\n' >&2
  printf '%s\n' "${c_c}             export PATH=\"\$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:\$PATH\"${c_0}" >&2
  printf '%s\n' "${c_c}             meetingbox${c_0}" >&2
  printf '\n' >&2
  info "then set a keyboard shortcut in the details pane and tick Pin in Menu Bar."
  info "First press records, second press writes the minutes."
  rule
}

setup() {
  printf '\n' >&2
  say "setup ${c_dim}v$VERSION${c_0}"
  rule

  if recording_busy; then
    warn "a recording is still being saved. Wait for it, or run: meetingbox stop"
    return 1
  fi

  v="$(macos_major)"
  if [ -z "$v" ]; then
    die "this only runs on macOS"
  elif [ "$v" -lt 27 ] 2>/dev/null; then
    miss "macOS $v. The on device model (fm) arrived in macOS 27."
    info "Recording and transcribing will still work, the summary will not."
  else
    ok "macOS $v"
  fi

  # --- survey, before asking for anything ---
  todo=""
  need_xcode_clt      && { miss "Xcode Command Line Tools"; todo="$todo clt"; }     || ok "Xcode Command Line Tools"
  need_recorder       && { miss "the recorder";             todo="$todo capture"; } || ok "the recorder"
  transcriber_present && ok "a transcriber" || { miss "a transcriber"; todo="$todo transcriber"; }
  # whisper alone works, but Apple's is faster and needs no model; offer it beside it
  if transcriber_present && ! have speech-analyzer && [ "${v:-0}" -ge 26 ] 2>/dev/null; then
    miss "Apple's transcriber (faster than whisper, which is used until then)"; todo="$todo native"
  fi
  # a build signs the app, so this matters for an app that is already built
  have_signing_identity && app_signed_by_us && ok "signing certificate" \
    || { miss "a signing certificate"; todo="$todo sign"; }
  if have fm; then
    if need_fm_license; then miss "Apple model licence not accepted"; todo="$todo license"
    else ok "fm, licence accepted"; fi
  else
    miss "fm not found (ships with macOS 27)"
  fi
  on_path || { miss "$BIN_DIR is not on your PATH"; todo="$todo path"; }

  rule
  if [ -z "$todo" ]; then
    say "everything is already in place"
    prime_permissions || return 1
    prime_speech
    install -m 755 "$0" "$BIN_DIR/meetingbox" 2>/dev/null || true
    make_shortcut_hint
    say "ready. Run ${c_b}meetingbox${c_0} to start a recording."
    return 0
  fi

  n="$(printf '%s' "$todo" | wc -w | tr -d ' ')"
  if [ "$n" = 1 ]; then say "one thing to install. I can do it from here."
  else say "$n things to install. I can do all of them from here."; fi
  info "some steps may ask for your Mac password, and Apple may open an installer window."
  confirm "go ahead?" || { info "nothing changed. Run 'meetingbox setup' when you are ready."; return 1; }
  rule

  case " $todo " in *" path "*) add_to_path ;; esac
  case " $todo " in *" clt "*)  install_xcode_clt || return 1 ;; esac

  case " $todo " in
    *" capture "*) install_recorder || return 1 ;;
    *" sign "*)    resign_app ;;
  esac

  case " $todo " in
    *" transcriber "*)
      if [ "${v:-0}" -ge 26 ] 2>/dev/null && confirm "use Apple's built in transcriber? (fast, no 1.6GB download)"; then
        install_speech_analyzer || {
          warn "the Apple transcriber did not build"
          # The fallback is Homebrew plus a 1.6GB model, a different thing to what
          # was agreed, so ask again rather than carry on.
          confirm "use whisper.cpp instead? (Homebrew, about 1.6GB download)" || return 1
          if need_brew; then install_brew || return 1; fi
          install_whisper || return 1
        }
      else
        need_brew && { confirm "whisper.cpp needs Homebrew, install it?" && install_brew || return 1; }
        install_whisper || return 1
      fi ;;
  esac

  case " $todo " in *" native "*) install_speech_analyzer || info "carrying on with whisper" ;; esac
  case " $todo " in *" license "*) accept_fm_license || true ;; esac

  rule
  install -m 755 "$0" "$BIN_DIR/meetingbox" 2>/dev/null \
    && ok "meetingbox -> $BIN_DIR/meetingbox" || true

  prime_permissions || return 1
  prime_speech
  make_shortcut_hint
  say "ready. Run ${c_b}meetingbox${c_0} to start a recording."
}

doctor() {
  say "check"
  v="$(macos_major)"; [ -n "$v" ] && ok "macOS $v" || miss "not macOS"
  recorder_ready      && ok "recorder (meetingbox.app)" || miss "recorder (meetingbox.app)"
  [ -x "$TRANSCRIPT_BIN" ] && ok "mb-transcript (labels Me and Them)" || miss "mb-transcript (labels Me and Them)"
  if ! have_signing_identity; then
    miss "signing certificate (permissions will be asked again after updates)"
  elif [ -d "$APP_DIR" ] && ! app_signed_by_us; then
    miss "meetingbox.app is signed ad hoc, so permissions will be asked again after updates. Run: meetingbox setup"
  else
    ok "signing certificate"
  fi
  have speech-analyzer && ok "speech-analyzer" || info "speech-analyzer not installed"
  have whisper-cli    && ok "whisper-cli"     || info "whisper-cli not installed"
  transcriber_present || miss "no transcriber at all"
  if have fm; then
    need_fm_license && miss "fm licence not accepted (sudo fm license)" || ok "fm"
  else miss "fm"; fi
  on_path && ok "$BIN_DIR on PATH" || miss "$BIN_DIR not on PATH"
  if recorder_ready; then
    info "microphones the recorder can see:"
    "$APP_BIN" --record -l 2>&1 | sed 's/^/             /' >&2 || true
  fi
  info "if anything is missing: meetingbox setup"
}

# ------------------------------------------------------------------- recording
#
# The app owns recording: it starts the recorder, signals it, finalises the audio,
# queues the meeting and keeps the state files. This command is its client. Each
# command is one request line over a private socket and one reply line back:
# `ok <state> <folder or ->` or `error <message>`. The state files are read here only
# when the app is not running, so `status` still tells the truth after a crash.

# The recorder is found by the folder it writes to, not by a saved PID, so a
# PID reused after a crash or reboot can never be mistaken for it.
session_dir()  { cat "$DIR_FILE" 2>/dev/null || true; }
is_recording() { d="$(session_dir)"; [ -n "$d" ] && [ -n "$(recorder_pids "$d")" ]; }

# The app keeps recording.dir while a recording is going or still being finished.
has_session() { [ -f "$DIR_FILE" ]; }

PAUSE_FILE="$STATE_DIR/paused"
# meetingbox 1.3 and earlier serialised start and stop with this lock; reset still
# clears one left behind.
LOCK="$STATE_DIR/busy"
release_lock() { rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null || true; }

CONTROL_SOCK="$STATE_DIR/control.sock"
APP_WAIT=10   # seconds to wait for an app that was not running

# Percent-encodes every byte except unreserved characters and /, so a request stays
# one line of plain words whatever a microphone name or folder holds.
pct_encode() {
  local out="" h
  for h in $(printf '%s' "$1" | od -An -v -tx1); do
    case "$h" in
      2d|2e|2f|3[0-9]|4[1-9a-f]|5[0-9a]|5f|6[1-9a-f]|7[0-9a]|7e) out="$out$(printf "\\x$h")" ;;
      *) out="$out%$(printf '%s' "$h" | tr 'a-f' 'A-F')" ;;
    esac
  done
  printf '%s' "$out"
}

# One request, the first line of the reply. Fails when nothing is listening (no
# socket, or one left by an app that has gone); a connection that is closed with
# no reply gives an empty line.
app_send() {
  local reply
  reply="$(nc -U -w 30 "$CONTROL_SOCK" <<< "$1" 2>/dev/null)" || return 1
  printf '%s' "${reply%%
*}"
}

# An app from meetingbox 1.3 or earlier is only a recorder: opened with no arguments
# it starts recording on its own, with nothing to answer. An app built for this
# command names the script in its Info.plist (MBScriptPath); only that one is opened.
app_is_client_aware() {
  [ -n "$(/usr/libexec/PlistBuddy -c 'Print :MBScriptPath' "$APP_DIR/Contents/Info.plist" 2>/dev/null || true)" ]
}

# Sends a request to the app, opening it in the background if it is not running and
# trying again for up to $APP_WAIT seconds. Only a failed connection is retried: a
# request that got through is never sent twice. An `error` reply ends the command
# with its text; an `ok` reply leaves "<state> <folder>" in APP_REPLY.
APP_REPLY=""
app_request() {
  local reply="" i=0
  if ! reply="$(app_send "$1")"; then
    [ -d "$APP_DIR" ] || die "meetingbox is not installed. Run: meetingbox setup"
    app_is_client_aware || die "the installed meetingbox app is older than this command. Run: meetingbox setup"
    open -g "$APP_DIR" >/dev/null 2>&1 || true
    while :; do
      [ "$i" -lt $((APP_WAIT * 2)) ] || die "meetingbox did not start. Run: meetingbox setup"
      sleep 0.5; i=$((i + 1))
      if reply="$(app_send "$1")"; then break; fi
    done
  fi
  case "$reply" in
    "ok "*)    APP_REPLY="${reply#ok }" ;;
    "error "*) die "${reply#error }" ;;
    "")        die "meetingbox did not answer. Try again in a moment" ;;
    *)         die "meetingbox gave an answer this command does not understand: $reply" ;;
  esac
}

# What an ok reply means, said the way status always has.
say_state() {
  local state="${APP_REPLY%% *}" folder="${APP_REPLY#* }"
  case "$state" in
    idle)              info "idle" ;;
    recording|paused)  ok "$state -> $folder" ;;
    finalising)        ok "stopped -> $folder"
                       info "the minutes will open in the meetingbox window when they are ready" ;;
    *)                 info "$APP_REPLY" ;;
  esac
}

# --mic and --dir (or MB_MIC and MB_DIR) travel inside the request when given;
# otherwise the app's own settings apply. A folder is sent as a full path.
recording_options() {
  local opts="" d="$DIR_ARG"
  if [ -n "$MIC" ]; then opts=" mic=$(pct_encode "$MIC")"; fi
  if [ -n "$d" ]; then
    case "$d" in
      /*) ;;
      "~")  d="$HOME" ;;
      "~/"*) d="$HOME/${d#\~/}" ;;
      *)    d="$PWD/$d" ;;
    esac
    opts="$opts dir=$(pct_encode "$d")"
  fi
  printf '%s' "$opts"
}

start_recording() {
  recorder_ready || die "the recorder is not installed yet. Run: meetingbox setup"
  app_request "start$(recording_options)"
  say_state
}

stop_recording() {
  app_request stop
  say_state
}

# Start, or stop the recording that is going.
toggle_recording() {
  app_request "toggle$(recording_options)"
  say_state
}

pause_recording() {
  # A recorder from meetingbox 1.2 writes <stamp>_meeting.m4a and has no pause:
  # SIGUSR1 would kill it and leave the audio unplayable. Refused before the app is asked.
  local d f
  d="$(session_dir)"
  if [ -n "$d" ]; then
    for f in "$d"/*_meeting.m4a; do
      if [ -e "$f" ]; then
        die "this recording was started by an older meetingbox and cannot pause. It is still recording; 'meetingbox stop' finishes it"
      fi
    done
  fi
  app_request pause
  say_state
}

resume_recording() {
  app_request resume
  say_state
}

# Asks the app, but never opens it. With no app answering (not running, crashed or
# force quit) it reads the state files the app left and looks for the recorder
# itself, which carries on recording without the app.
status_cmd() {
  local reply d
  if reply="$(app_send status)"; then
    case "$reply" in
      "ok "*)    APP_REPLY="${reply#ok }"; say_state; return 0 ;;
      "error "*) die "${reply#error }" ;;
    esac
  fi
  info "meetingbox is not running, so this is from the recording files"
  d="$(session_dir)"
  if is_recording; then
    if [ -e "$PAUSE_FILE" ]; then ok "paused -> $d"; else ok "recording -> $d"; fi
  else
    info "idle"
    if [ -n "$d" ]; then info "the recording in $d did not finish; open meetingbox to recover it"; fi
  fi
}

# The recorder writes mic.caf and call.caf while recording, and on stop turns them
# into the three .m4a, then writes .recording-complete, then removes them. Working
# files without the marker mean it was killed or crashed before it finished.
recording_unfinished() {
  [ ! -e "$1/.recording-complete" ] && { [ -e "$1/mic.caf" ] || [ -e "$1/call.caf" ]; }
}

# Finishes such a recording from its working files, with the recorder's own
# --recover (the same finalising it runs at stop). Says why if it cannot.
recover_dir() {
  if rec_out="$("$APP_BIN" --recover "$1" 2>&1)"; then return 0; fi
  [ -n "$rec_out" ] && printf '%s\n' "$rec_out" | sed 's/^/           /' >&2
  return 1
}

recover_cmd() {
  [ -d "$1" ] || die "no such folder: $1"
  rdir="$(cd "$1" && pwd)"
  [ -z "$(recorder_pids "$rdir")" ] || die "$rdir is still recording. To finish it: meetingbox stop"
  [ -x "$APP_BIN" ] || die "the recorder is not installed. Run: meetingbox setup"
  recover_dir "$rdir" || die "could not recover $rdir. Its files are left as they were"
  ok "recovered $rdir"
  info "to get its minutes: meetingbox process $rdir"
}


# ----------------------------------------------------------------- transcribing

pick_engine() {
  case "$ENGINE" in
    native)  have speech-analyzer || die "speech-analyzer not installed. Run: meetingbox setup"; printf 'native' ;;
    whisper) have whisper-cli     || die "whisper-cli not installed. Run: meetingbox setup";     printf 'whisper' ;;
    auto)
      if have speech-analyzer; then printf 'native'
      elif have whisper-cli;   then printf 'whisper'
      else die "no transcriber installed. Run: meetingbox setup"; fi ;;
    *) die "unknown engine: $ENGINE" ;;
  esac
}

find_whisper_model() {
  [ -n "$WHISPER_MODEL" ] && { printf '%s' "$WHISPER_MODEL"; return; }
  for c in \
    "$MODEL_DIR/ggml-large-v3-turbo.bin" \
    "$HOME/Models/ggml-large-v3-turbo.bin" \
    "$HOME/.whisper-models/ggml-large-v3-turbo.bin"
  do
    [ -f "$c" ] && { printf '%s' "$c"; return; }
  done
  printf ''
}

transcribe() {
  audio="$1"; out="$2"
  engine="$(pick_engine)"

  case "$engine" in
    native)
      say "transcribing on device (Apple SpeechAnalyzer)"
      if ! sa_run "$out" "$audio"; then
        have whisper-cli || die "transcription failed. Check Speech Recognition in Privacy settings, or run: meetingbox setup"
        warn "Apple's transcriber failed, trying whisper. To use Apple's again, check Speech Recognition is on for speech-analyzer"
        ENGINE=whisper
        transcribe "$audio" "$out"
        return
      fi
      ;;
    whisper)
      model="$(find_whisper_model)"
      [ -n "$model" ] || die "no whisper model found. Run: meetingbox setup"
      have ffmpeg || die "whisper.cpp needs ffmpeg for the 16kHz conversion. brew install ffmpeg"
      wav="${audio%.*}.16k.wav"
      say "transcribing on device (whisper.cpp, $(basename "$model"))"
      ffmpeg -hide_banner -loglevel error -y -i "$audio" -ar 16000 -ac 1 -c:a pcm_s16le "$wav"
      whisper-cli -m "$model" -f "$wav" --no-timestamps \
        --output-txt --output-file "${out%.txt}" >/dev/null || die "whisper-cli failed"
      rm -f "$wav"
      ;;
  esac

  [ -s "$out" ] || die "the transcript came out empty. Was there any sound?"
  ok "transcript: $(wc -w < "$out" | tr -d ' ') words"
}

# Apple's transcriber, started as its own app through `open` (as the recorder is),
# so macOS asks for Speech Recognition in its name. Run as a child of this shell,
# the request belongs to whatever started meetingbox, and one from a Shortcuts
# hotkey is refused without a prompt. A speech-analyzer meetingbox did not build
# has no app of ours, so it is run directly.
# Usage: sa_run OUT AUDIO [speech-analyzer options]
sa_run() {
  local out="$1" audio="$2" err; shift 2
  case "$out" in /*) ;; *) out="$PWD/$out" ;; esac
  case "$audio" in /*) ;; *) audio="$PWD/$audio" ;; esac
  if [ ! -d "$SA_APP" ]; then
    speech-analyzer --locale "$LOCALE" "$@" "$audio" > "$out"
    return
  fi
  err="$(mktemp)" || return 1
  rm -f "$out"
  open -W -n -g --stdout /dev/null --stderr "$err" "$SA_APP" \
    --args --locale "$LOCALE" "$@" -o "$out" "$audio" >/dev/null 2>&1 || true
  # open -W cannot always latch on (it says "Unable to block" when the app
  # finished first), so also wait until no transcriber is writing this file.
  # Matched through awk and the environment, so the search never finds itself.
  while ps -axo command= | NEEDLE="-o $out $audio" awk 'index($0, ENVIRON["NEEDLE"]) { f = 1 } END { exit !f }'; do
    sleep 0.2
  done
  # The transcriber is its own app and does not inherit our umask: make its output
  # private, whether or not it worked.
  [ ! -e "$out" ] || chmod 600 "$out"
  if [ -e "$out" ] && ! grep -q '^Error' "$err"; then rm -f "$err"; return 0; fi
  grep '^Error' "$err" >&2 || true   # its usage text after the error is noise here
  rm -f "$err"
  return 1
}

# One side of the call to word timed JSON, for mb-transcript. A side that will
# not transcribe is left empty with a warning, and returns 1: one side is better
# than none, but both failing is a different problem.
transcribe_words() {
  local audio="$1" out="$2" engine model wav
  engine="$(pick_engine)"
  case "$engine" in
    native)
      sa_run "$out" "$audio" -f json \
        || { warn "could not transcribe $(basename "$audio"), carrying on without it"; : > "$out"; return 1; }
      ;;
    whisper)
      model="$(find_whisper_model)"
      [ -n "$model" ] || die "no whisper model found. Run: meetingbox setup"
      have ffmpeg || die "whisper.cpp needs ffmpeg for the 16kHz conversion. brew install ffmpeg"
      wav="${audio%.*}.16k.wav"
      if ! { ffmpeg -hide_banner -loglevel error -y -i "$audio" -ar 16000 -ac 1 -c:a pcm_s16le "$wav" \
             && whisper-cli -m "$model" -f "$wav" -oj -ml 1 -sow --output-file "${out%.json}" >/dev/null; }; then
        warn "could not transcribe $(basename "$audio"), carrying on without it"; : > "$out"
        rm -f "$wav"; return 1
      fi
      rm -f "$wav"
      ;;
  esac
}

# Your side and the other side transcribed on their own, then merged by
# mb-transcript into lines labelled Me and Them.
transcribe_channels() {
  local dir="$1" out="$2" engine tmp err msg failed=0
  [ -x "$TRANSCRIPT_BIN" ] || die "mb-transcript is not installed. Run: meetingbox setup"
  engine="$(pick_engine)"
  case "$engine" in
    native)  say "transcribing each side on device (Apple SpeechAnalyzer)" ;;
    whisper) say "transcribing each side on device (whisper.cpp)" ;;
  esac
  # through ||, so set -e does not end the run on the first side that fails
  transcribe_words "$dir/mic.m4a" "$dir/mic.words.json" || failed=$((failed + 1))
  transcribe_words "$dir/call.m4a" "$dir/call.words.json" || failed=$((failed + 1))
  # Both failing is rarely a silent meeting: usually the engine cannot run at all.
  if [ "$failed" -eq 2 ] && [ "$engine" = native ] && have whisper-cli; then
    warn "Apple's transcriber failed on both sides, trying whisper. To use Apple's again, check Speech Recognition is on for speech-analyzer"
    ENGINE=whisper; engine=whisper; failed=0
    transcribe_words "$dir/mic.m4a" "$dir/mic.words.json" || failed=$((failed + 1))
    transcribe_words "$dir/call.m4a" "$dir/call.words.json" || failed=$((failed + 1))
  fi
  if [ "$failed" -eq 2 ]; then
    case "$engine" in
      native)  die "transcription failed on both sides. Check Speech Recognition in Privacy settings, or run: meetingbox setup" ;;
      whisper) die "whisper-cli failed on both sides, see its output above" ;;
    esac
  fi

  # Written aside and moved, so a failure leaves no half transcript behind.
  progress speakers
  tmp="$(mktemp)"; err="$(mktemp)"
  if ! "$TRANSCRIPT_BIN" --mic "$dir/mic.words.json" --call "$dir/call.words.json" > "$tmp" 2> "$err"; then
    msg="$(cat "$err")"; rm -f "$tmp" "$err"
    die "${msg:-mb-transcript failed}"
  fi
  # a side it could not read is a warning, not a failure
  while IFS= read -r msg; do warn "${msg#mb-transcript: }"; done < "$err"
  rm -f "$err"
  mv -f "$tmp" "$out"
  ok "transcript: $(wc -l < "$out" | tr -d ' ') turns, as Me and Them"
}

# ------------------------------------------------------------------ summarising

token_count() {
  if have fm; then
    n="$(fm count-tokens < "$1" 2>/dev/null | tr -dc '0-9\n' | grep -m1 '[0-9]' || true)"
    [ -n "$n" ] && { printf '%s' "$n"; return; }
  fi
  awk '{n += NF} END {printf "%d", n * 1.35}' "$1"
}

# fm ignores stdin if given a positional prompt, so the prompt goes in -i and
# the content arrives on stdin.
fm_run() {
  instr="$1"; input="$2"; shift 2
  fm respond -i "$instr" "$@" < "$input"
}

# A dense slice can need more answer than the window has room for, and fm then
# fails with "exceeded the model's context size". Dropping it would quietly lose
# decisions, so halve the slice and try again, down to a floor. Output is held
# until the call succeeds, because fm streams and a failed call prints half an answer.
fm_fold() {
  local instr="$1" input="$2" words="$3" sub c
  if fm_run "$instr" "$input" > "$input.out" 2>/dev/null; then
    cat "$input.out"; return 0
  fi
  [ "$words" -gt 200 ] || return 1
  info "  too dense for one pass, splitting it"
  sub="$input.split"
  split_chunks "$input" "$sub" $((words / 2)) > "$sub.list"
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    fm_fold "$instr" "$c" $((words / 2)) || return 1
    printf '\n'
  done < "$sub.list"
}

# Fold by word count, keeping the lines: each line of a transcript is one
# speaker's turn. Break at a line end once past the target, with a hard cap so a
# transcript that arrives as one long paragraph still splits.
split_chunks() {
  infile="$1"; outdir="$2"; n="$3"
  mkdir -p "$outdir"
  awk -v n="$n" -v dir="$outdir" '
    function newfile() { part++; w = 0; file = sprintf("%s/chunk-%03d.txt", dir, part) }
    BEGIN { part = 0; newfile() }
    {
      sep = ""
      for (i = 1; i <= NF; i++) {
        printf "%s%s", sep, $i > (file)
        sep = " "; w++
        if (w >= n * 1.5 && i < NF) {
          printf "\n" > (file); close(file); newfile(); sep = ""
        }
      }
      printf "\n" > (file)
      if (w >= n) { close(file); newfile() }
    }
    END { close(file) }
  ' "$infile"

  for f in "$outdir"/chunk-*.txt; do
    [ -e "$f" ] || continue
    if [ -s "$f" ] && grep -q '[^[:space:]]' "$f"; then printf '%s\n' "$f"; else rm -f "$f"; fi
  done
}

summarise() {
  transcript="$1"; dir="$2"
  have fm || die "fm not found. It ships with macOS 27. Run: meetingbox setup"

  # A fresh folder made here, so the clean up at the end can only delete that.
  work="$(mktemp -d "${dir:?}/.work.XXXXXX")" || die "could not make a working folder in $dir"
  merged="$work/merged.txt"

  # fm reads the words and the speakers. The times are for people, and only cost tokens.
  text="$work/transcript.txt"
  sed -E 's/^\[[0-9:]+\] //' "$transcript" > "$text"

  tokens="$(token_count "$text")"; tokens="${tokens:-0}"
  info "transcript is ~$tokens tokens, the on device window is ~4000"

  if [ "$tokens" -le "$TOKEN_CEILING" ]; then
    info "fits in one pass"
    cp "$text" "$merged"
  else
    # Chunk lists go through files, not bash arrays: stock macOS bash is 3.2,
    # where `mapfile` is missing and an empty array trips `set -u`.
    list="$work/chunks.list"
    split_chunks "$text" "$work/chunks" "$CHUNK_WORDS" > "$list"
    total="$(grep -c . "$list" 2>/dev/null || true)"
    [ "${total:-0}" -gt 0 ] || die "chunking produced nothing, the transcript may be unreadable"
    say "summarising in $total slices"

    : > "$merged"
    i=0
    while IFS= read -r c; do
      [ -n "$c" ] || continue
      i=$((i + 1))
      info "slice $i/$total"
      {
        printf '\n## slice %d of %d\n\n' "$i" "$total"
        fm_fold "$MAP_INSTRUCTIONS" "$c" "$CHUNK_WORDS" || {
          warn "slice $i could not be summarised, its text is kept verbatim in notes-raw.md"
          cat "$c"; }
      } >> "$merged"
    done < "$list"

    round=0
    while [ "$(token_count "$merged")" -gt "$TOKEN_CEILING" ]; do
      round=$((round + 1))
      if [ "$round" -gt 4 ]; then warn "still over the window after 4 rounds, going with what we have"; break; fi
      info "folding, round $round"
      rlist="$work/reduce-$round.list"
      # Merging keeps every item, so the answer is about as long as the input.
      # Half size slices leave room for both inside the window.
      split_chunks "$merged" "$work/reduce-$round" $((CHUNK_WORDS / 2)) > "$rlist"
      next="$work/merged.r$round.txt"
      : > "$next"
      while IFS= read -r c; do
        [ -n "$c" ] || continue
        # On failure carry the notes forward unmerged rather than drop them.
        fm_fold "$REDUCE_INSTRUCTIONS" "$c" $((CHUNK_WORDS / 2)) >> "$next" || cat "$c" >> "$next"
        printf '\n' >> "$next"
      done < "$rlist"
      merged="$next"
    done
  fi

  cp "$merged" "$dir/notes-raw.md"

  say "writing the minutes"
  # fm streams, so a failed pass would leave half a file. Write aside, then move.
  # If the notes are still too big for the window, ship them whole rather than nothing.
  if ! fm_run "$FINAL_INSTRUCTIONS" "$merged" > "$work/final.md" 2>/dev/null; then
    warn "too much in this meeting for one final pass, so notes.md holds the merged notes in full"
    cp "$merged" "$work/final.md"
  fi
  mv "$work/final.md" "$dir/notes.md"

  # Structured record beside the prose, so downstream tooling gets something it
  # can parse rather than something it has to interpret.
  schema="$work/schema.json"
  if fm schema object --name MeetingBrief \
       --string summary \
       --string decisions --array \
       --string actions --array \
       --string open_questions --array \
       --string numbers_and_dates --array > "$schema" 2>/dev/null
  then
    if fm_run "$BRIEF_INSTRUCTIONS" "$merged" --schema "$schema" > "$dir/brief.json" 2>/dev/null; then
      ok "brief.json"
    else
      warn "structured pass failed, the prose minutes are still good"
      rm -f "$dir/brief.json"
    fi
  fi

  [ "${MB_DEBUG:-0}" = "1" ] || rm -rf "$work"
  ok "minutes: $dir/notes.md"
}

# ------------------------------------------------------------------- processing

# One `process` per folder at a time. The lock is the folder <dir>/.processing,
# made with mkdir, holding `owner`: "<pid> <that pid's start time>", so a PID
# reused after a crash or reboot never passes for the owner. owner goes in with
# ln, which never replaces a file, so of two processes taking over one stale
# lock exactly one gets it. A lock with no owner yet (between mkdir and ln)
# counts as held for PROCESS_LOCK_GRACE seconds after its change time.
PROCESS_LOCK_GRACE=10
BUSY_EXIT=75   # EX_TEMPFAIL: refused because another process holds the folder
PROCESSING_LOCK=""
PROCESSING_OWNER=""
PROCESSING_DIR=""
PROCESSING_STARTED=""

# A PID's start time as ps gives it, or nothing when no such process runs. Read
# in UTC: ps prints local time, and two runs with different TZ settings must
# read one owner the same way.
pid_lstart() { LC_ALL=C TZ=UTC0 ps -o lstart= -p "$1" 2>/dev/null | sed 's/^ *//; s/ *$//' || true; }

# Held: the owner named in $2 (the owner file's text, empty for none) is running
# with the same start time, or there is no owner and the lock $1 is fresh.
processing_lock_alive() {
  local pid start changed
  if [ -n "$2" ]; then
    pid="${2%% *}"; start="${2#* }"
    case "$pid" in ''|*[!0-9]*) ;; *) [ "$(pid_lstart "$pid")" = "$start" ]; return ;; esac
  fi
  changed="$(stat -f %c "$1" 2>/dev/null)" || return 1
  [ $(( $(date +%s) - changed )) -lt "$PROCESS_LOCK_GRACE" ]
}

busy_die() { printf '%s\n' "${c_r}     error${c_0} $*" >&2; exit "$BUSY_EXIT"; }

take_processing_lock() {
  local dir="$1" lock="$1/.processing" tmp me start seen moved took tries=0
  tmp="$(mktemp "$dir/.processing-owner.XXXXXX")" || die "could not write in $dir"
  # This shell's PID: $$ is the parent's in a subshell, and bash 3.2 has no BASHPID.
  sh -c 'printf "%s" "$PPID"' > "$tmp"
  me="$(cat "$tmp")"
  start="$(pid_lstart "$me")"
  # Without it the owner would read as stale from birth, and anyone could take over.
  [ -n "$start" ] || { rm -f "$tmp"; die "could not read this process's start time"; }
  printf '%s %s\n' "$me" "$start" > "$tmp"
  while :; do
    tries=$((tries + 1))
    [ "$tries" -le 20 ] || { rm -f "$tmp"; busy_die "this meeting is already being processed: $dir"; }
    if mkdir "$lock" 2>/dev/null; then
      ln "$tmp" "$lock/owner" 2>/dev/null && break
      continue   # taken over while we were between mkdir and ln: look again
    fi
    seen="$(cat "$lock/owner" 2>/dev/null || true)"
    if processing_lock_alive "$lock" "$seen"; then
      rm -f "$tmp"
      busy_die "this meeting is already being processed: $dir"
    fi
    if [ -z "$seen" ]; then
      ln "$tmp" "$lock/owner" 2>/dev/null && break
      continue
    fi
    # A stale owner: move that file aside (only one taker can), then put ours in.
    # Ctrl-C or TERM are held off meanwhile, so a live owner moved aside by
    # mistake is always put back.
    moved="$(mktemp -u "$dir/.processing-stale.XXXXXX")"
    took=0
    trap '' INT TERM
    if mv "$lock/owner" "$moved" 2>/dev/null; then
      if [ "$(cat "$moved" 2>/dev/null || true)" != "$seen" ]; then
        # A newer owner, put in after we looked: give it back and look again.
        ln "$moved" "$lock/owner" 2>/dev/null || true
      else
        ln "$tmp" "$lock/owner" 2>/dev/null && took=1
      fi
      rm -f "$moved"
    fi
    trap - INT TERM
    [ "$took" = 0 ] || break
  done
  rm -f "$tmp"
  PROCESSING_LOCK="$lock"
  PROCESSING_OWNER="$(cat "$lock/owner")"
  PROCESSING_DIR="$dir"
  PROCESSING_STARTED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  trap 'end_processing $?' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
}

# Removes the lock only while it is still ours.
release_processing_lock() {
  [ -n "$PROCESSING_LOCK" ] || return 0
  if [ "$(cat "$PROCESSING_LOCK/owner" 2>/dev/null || true)" = "$PROCESSING_OWNER" ]; then
    rm -f "$PROCESSING_LOCK/owner"
    rmdir "$PROCESSING_LOCK" 2>/dev/null || true
  fi
  PROCESSING_LOCK=""
}

# The last act of a locked run, on success or failure: .process-result written
# aside and moved into place (so a reader never sees half of it), then the lock
# released. The app counts a result only when its attempt is the one it started.
end_processing() {
  local rc="$1" attempt result tmp_result
  trap - EXIT HUP INT TERM
  if [ -n "$PROCESSING_LOCK" ]; then
    attempt="$(printf '%s' "${MB_ATTEMPT:-}" | tr -cd 'A-Za-z0-9._-')"
    result="$PROCESSING_DIR/.process-result"
    if tmp_result="$(mktemp "$PROCESSING_DIR/.process-result.XXXXXX")"; then
      if printf 'attempt=%s status=%s started=%s finished=%s\n' "${attempt:-terminal}" "$rc" \
           "$PROCESSING_STARTED" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$tmp_result"; then
        mv -f "$tmp_result" "$result"
      else
        rm -f "$tmp_result"
      fi
    fi
    release_processing_lock
  fi
  return "$rc"
}

# With MB_PROGRESS_FILE set (the app sets it), each stage is appended to it.
progress() {
  [ -n "${MB_PROGRESS_FILE:-}" ] || return 0
  printf '%s\n' "$1" >> "$MB_PROGRESS_FILE" 2>/dev/null || true
}

process() {
  # transcripts and minutes are as private as the recording
  umask 077
  input="$1"
  # a meeting folder stands for its recording
  [ -d "$input" ] && input="${input%/}/audio.m4a"
  [ -d "$(dirname "$input")" ] || die "no such file: $input"
  dir="$(cd "$(dirname "$input")" && pwd)"
  take_processing_lock "$dir"
  case "${input##*.}" in
    txt|md|vtt|srt) ;;
    *) if recording_unfinished "$dir"; then
         die "this recording was not finished. Run: meetingbox recover $dir"
       fi ;;
  esac
  [ -e "$input" ] || die "no such file: $input"
  transcript="$dir/transcript.txt"
  # What --no-keep-audio removes once the minutes exist (summarise reuses $input).
  spent_audio=""; spent_sides=0

  case "${input##*.}" in
    txt|md|vtt|srt)
      [ "$input" = "$transcript" ] || cp "$input" "$transcript" ;;
    *)
      progress transcribing
      if [ -f "$dir/mic.m4a" ] && [ -f "$dir/call.m4a" ]; then
        transcribe_channels "$dir" "$transcript"
        spent_audio="$input"; spent_sides=1
      else
        transcribe "$input" "$transcript"
        spent_audio="$input"
      fi ;;
  esac

  progress minutes
  summarise "$transcript" "$dir"
  # --no-keep-audio: only now the minutes exist, so a failed run never loses audio.
  if [ "$KEEP_AUDIO" != "1" ] && [ -n "$spent_audio" ]; then
    rm -f "$spent_audio"
    [ "$spent_sides" = 0 ] || rm -f "$dir/mic.m4a" "$dir/call.m4a"
  fi
  progress done
  chime done
  notify "meetingbox" "Minutes ready"

  if [ -t 1 ]; then
    printf '\n'; cat "$dir/notes.md"; printf '\n'
    have open && open "$dir/notes.md" 2>/dev/null || true
  fi
  end_processing 0
}

# ----------------------------------------------------------------------- reset
#
#   reset            stuck recording state, and meetingbox's macOS permissions
#   reset --tools    also what setup built, so setup starts from scratch
#   uninstall        also meetingbox itself
#
# Recordings are never touched. Only paths on setup's list (see remove_installed)
# are deleted, so nothing that was already on the Mac is, wherever an MB_*
# setting points.

# The v1.1.0 recorder sat in $BIN_DIR. Only a byte for byte copy of the one
# setup compiled counts as ours.
old_recorder() {
  [ -f "$BIN_DIR/audio-capture" ] && [ -f "$SRC_DIR/audio-capture/audio-capture" ] \
    && cmp -s "$BIN_DIR/audio-capture" "$SRC_DIR/audio-capture/audio-capture"
}

reset_cmd() {
  level="$1"   # state | tools | all
  [ "$level" = state ] || adopt_own_app
  say "reset"
  rule
  info "this will:"
  info "  stop any recorder left running and clear the recording state"
  info "  reset the Screen Recording and Microphone permissions for meetingbox,"
  info "  so macOS asks again next time"
  if [ "$level" != state ]; then
    ours="$(cat "$INSTALLED" 2>/dev/null || true)"
    info "  delete what setup installed:"
    n=0
    while IFS= read -r p; do
      case "$p" in
        keychain:sha1:*)
          info "    the meetingbox signing certificate in your login keychain"; n=$((n + 1)) ;;
        /*) if [ -e "$p" ] || [ -L "$p" ]; then info "    $p"; n=$((n + 1)); fi ;;
      esac
    done <<< "$ours"
    if old_recorder; then info "    $BIN_DIR/audio-capture (from v1.1.0)"; n=$((n + 1)); fi
    [ "$n" -gt 0 ] || info "    nothing, setup has no record of installing anything"
    left=""
    for p in "$APP_DIR" "$TRANSCRIPT_BIN" "$SRC_DIR/meetingbox" "$SRC_DIR/audio-capture" "$SRC_DIR/speech-analyzer-cli" \
             "$SA_APP" "$SA_LINK" "$WHISPER_FILE"; do
      if { [ -e "$p" ] || [ -L "$p" ]; } && ! installed_by_us "$p"; then left="$left$p
"; fi
    done
    if [ -n "$left" ]; then
      info "  leave alone, meetingbox did not install these:"
      printf '%s' "$left" | while IFS= read -r p; do info "    $p"; done
    fi
  fi
  [ "$level" = all ] && info "  delete meetingbox itself:                 $BIN_DIR/meetingbox"
  info "your recordings in $BASE_DIR are not touched"
  rule
  confirm "go ahead?" no || { info "nothing changed"; return 1; }

  # recorder and state. Same 15s as stop, so a long recording can finish its file.
  stop_recorders ""
  if has_session; then
    info "the unfinished recording is kept in $(session_dir)"
  fi
  rm -f "$PID_FILE" "$DIR_FILE" "$PAUSE_FILE"   # recording.pid is from v1.2.0 and earlier
  clear_permcheck; release_lock
  ok "recording state cleared"

  # permissions, only meetingbox's own
  if [ -d "$APP_DIR" ]; then
    register_app
    if tccutil reset ScreenCapture "$APP_ID" >/dev/null 2>&1 \
       && tccutil reset Microphone "$APP_ID" >/dev/null 2>&1; then
      ok "permissions reset for meetingbox"
    else
      warn "could not reset permissions. Turn meetingbox off by hand in Privacy & Security"
    fi
  else
    info "the recorder app is not installed, so there are no meetingbox permissions to reset"
  fi

  if [ "$level" != state ]; then
    if installed_by_us "$APP_DIR" && [ -x "$LSREGISTER" ]; then
      "$LSREGISTER" -u "$APP_DIR" >/dev/null 2>&1 || true
    fi
    old_recorder && rm -f "$BIN_DIR/audio-capture"
    while IFS= read -r p; do
      case "$p" in /*) remove_installed "$p" || true ;; esac
    done <<< "$ours"
    remove_signing_identity || true
    # a half finished download of the model setup was fetching
    if printf '%s\n' "$ours" | grep -qxF -- "$WHISPER_FILE"; then rm -f "$WHISPER_FILE.part"; fi
    rmdir "$SRC_DIR" "$MODEL_DIR" 2>/dev/null || true
    ok "installed tools removed"
    if have brew && brew list whisper-cpp >/dev/null 2>&1; then
      info "Homebrew's whisper-cpp is left installed. To remove it: brew uninstall whisper-cpp"
    fi
  fi

  if [ "$level" = all ]; then
    rm -f "$BIN_DIR/meetingbox"
    [ -s "$INSTALLED" ] || rm -f "$INSTALLED"
    rmdir "$STATE_DIR" 2>/dev/null || true
    ok "meetingbox removed"
    info "the PATH line in your shell profile stays, other tools use ~/.local/bin too"
    return 0
  fi

  rule
  say "done. Run ${c_b}meetingbox setup${c_0} to set it up again."
}

usage() {
  cat <<'USAGE'
meetingbox: record, transcribe and summarise a meeting entirely on device.

  meetingbox setup                 install what is missing, next next next
  meetingbox                       toggle: start, or stop and write the minutes
  meetingbox start | stop | status
  meetingbox pause | resume
  meetingbox process <audio|txt>   run an existing file through the pipeline
  meetingbox recover <folder>      finish a recording that was interrupted
  meetingbox doctor                what is installed and what is not
  meetingbox mics                  microphones the recorder can see
  meetingbox reset                 clear a stuck recording, ask for permissions again
  meetingbox reset --tools         also remove what setup built, to start setup afresh
  meetingbox uninstall             remove meetingbox (recordings are kept)
  meetingbox help

Options
  --mic "USB"            microphone, substring match   (MB_MIC)
  --dir ~/Meetings       where recordings land         (MB_DIR)
  --locale en-GB         transcription locale          (MB_LOCALE)
  --whisper | --native   pick the transcriber          (MB_ENGINE)
  --model <path>         whisper ggml model            (MB_WHISPER_MODEL)
  --no-keep-audio        bin the m4a files once transcribed

Output lands in ~/Meetings/<date>_<time>/
  audio.m4a  mic.m4a  call.m4a       the mix, your side, the other side
  transcript.txt                     who said what, as Me and Them
  notes.md  notes-raw.md  brief.json
USAGE
}

# ------------------------------------------------------------------------ main

cmd=""
argfile=""
RESET_TOOLS=0
while [ $# -gt 0 ]; do
  case "$1" in
    --mic|--device) MIC="$2"; shift 2 ;;
    --dir)     BASE_DIR="$2"; DIR_ARG="$2"; shift 2 ;;
    --locale)  LOCALE="$2"; shift 2 ;;
    --model)   WHISPER_MODEL="$2"; ENGINE="whisper"; shift 2 ;;
    --whisper) ENGINE="whisper"; shift ;;
    --native)  ENGINE="native"; shift ;;
    --keep-audio)    KEEP_AUDIO=1; shift ;;
    --no-keep-audio) KEEP_AUDIO=0; shift ;;
    --tools)   RESET_TOOLS=1; shift ;;
    -v|--version) printf 'meetingbox %s\n' "$VERSION"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *)  if [ -z "$cmd" ]; then cmd="$1"; else argfile="$1"; fi; shift ;;
  esac
done

case "${cmd:-toggle}" in
  toggle)
    if ! has_session && ! recorder_ready; then
      warn "not set up yet"
      confirm "run setup now?" && setup || info "run 'meetingbox setup' when you are ready"
    else
      toggle_recording
    fi ;;
  start)   start_recording ;;
  stop)    stop_recording ;;
  process) [ -n "$argfile" ] || die "usage: meetingbox process <audio-or-transcript>"
           process "$argfile" ;;
  recover) [ -n "$argfile" ] || die "usage: meetingbox recover <folder>"
           recover_cmd "$argfile" ;;
  setup)   setup ;;
  doctor|check) doctor ;;
  mics|devices)
    recorder_ready || die "the recorder is not installed. Run: meetingbox setup"
    "$APP_BIN" --record -l ;;
  pause)   pause_recording ;;
  resume)  resume_recording ;;
  status)  status_cmd ;;
  reset)
    if [ "$RESET_TOOLS" = 1 ]; then reset_cmd tools; else reset_cmd state; fi ;;
  uninstall) reset_cmd all ;;
  help)    usage ;;
  *)       die "unknown command: $cmd (try: meetingbox help)" ;;
esac
