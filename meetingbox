#!/usr/bin/env bash
#
# meetingbox: one key, whole meeting. Record, transcribe, summarise, all on device.
#
#   press once  -> records you and everyone else
#   press again -> stops, transcribes, writes the minutes
#
# Nothing leaves the Mac. No account, no API key, no upload, no per seat fee.
#
#   meetingbox.app    ->  audio.m4a          ScreenCaptureKit + your mic, one clock
#                         (+ mic.m4a, call.m4a: each side on its own)
#   speech-analyzer   ->  transcript.txt     Apple SpeechAnalyzer, on device
#     or whisper-cli  ->  transcript.txt     whisper.cpp, if you prefer
#   mb-transcript     ->  transcript.txt     each side transcribed alone, labelled by speaker
#   fm respond        ->  notes.md + brief.json
#
# First run: meetingbox setup
# It checks what is missing and offers to install it. Nothing to do by hand.
#
# Written for bash 3.2 and BSD userland, so it runs on a stock Mac.

set -euo pipefail

VERSION="2.0.0"

# --------------------------------------------------------------- configuration

BASE_DIR="${MB_DIR:-$HOME/Meetings}"
DIR_ARG="${MB_DIR:-}"                    # sent to the app only when given
ENGINE="${MB_ENGINE:-auto}"              # auto | parakeet | native | whisper
TIDY="auto"                              # auto | 1 | 0: tidy transcript lines; auto is the app's choice, else 1
ROOM_COUNT=""                            # people in the room, 1 to 6; empty works it out
CALL_COUNT=""                            # people on the other end of the call, 1 to 6; empty works it out
WRITER="apple"                           # who writes the minutes: apple
WORK=""                                  # the run's private work folder, once made
STAGE=""                                 # the run's staging folder in the meeting folder, once made
RUN_DIR=""                               # the meeting folder a run holds, where it was when the run began
FINISHED_OTHER=0                         # 1 once a run has finished another kind's interrupted swap, until its own
MINUTES_FAILED=0                         # 1 when a process run's minutes failed and only the transcript goes in
LOCALE="${MB_LOCALE:-en-GB}"
MIC="${MB_MIC:-}"                        # substring match, empty = system default
WHISPER_MODEL="${MB_WHISPER_MODEL:-}"
KEEP_AUDIO="${MB_KEEP_AUDIO:-1}"
SOUNDS="${MB_SOUNDS:-1}"                 # 0 = no start, stop and done sounds

STATE_DIR="${MB_STATE_DIR:-$HOME/.meetingbox}"
PID_FILE="$STATE_DIR/recording.pid"
DIR_FILE="$STATE_DIR/recording.dir"

BIN_DIR="${MB_BIN_DIR:-$HOME/.local/bin}"
SRC_DIR="${MB_SRC_DIR:-$HOME/.local/share/meetingbox}"
MODEL_DIR="${MB_MODEL_DIR:-$HOME/.local/share/whisper}"
WHISPER_FILE="$MODEL_DIR/ggml-large-v3-turbo.bin"
# where speech-analyzer's own install script puts itself
SA_LINK="$HOME/.local/bin/speech-analyzer"
SA_APP="$HOME/.local/libexec/SpeechAnalyzerCLI.app"
SAY_BIN="/usr/bin/say"   # macOS text to speech; `say` here is meetingbox's own logger

# The recorder runs inside meetingbox.app so that macOS files the Screen
# Recording and Microphone permissions under "meetingbox", not under whichever
# app happened to start it (Terminal, Shortcuts, Raycast). One executable, three
# modes: `--record` is the recorder, `--recover DIR` finishes an interrupted
# recording, and with neither it is the app.
#
# The app runs the recorder from a copy of that executable in a helper bundle
# of its own, meetingbox.app/Contents/Helpers/meetingbox-recorder.app. A
# recorder connects to the window server, so LaunchServices registers the
# bundle its executable is in. From the app's own executable it was taken for
# the app itself, and a recorder left running by a crash made macOS refuse to
# open the app again. The helper has an identifier of its own, so it never is.
# It is still a child of the app, so macOS still files the permissions under
# meetingbox. The script's own calls (the setup permission check, `--record -l`
# and `--recover`) keep using the app's executable. A recorder started by an
# earlier build, from the app's executable, is still found and stopped.
APP_ID="com.jediconcepts.meetingbox"
REC_ID="$APP_ID.recorder"
APP_DIR="$HOME/Applications/meetingbox.app"
# The Swift source lives in this repo, under native/recorder and native/app. setup
# builds it from a clone of the release tag, or from MB_SOURCE_DIR if set.
SOURCE_DIR="${MB_SOURCE_DIR:-$SRC_DIR/meetingbox}"
APP_BIN="$APP_DIR/Contents/MacOS/meetingbox"
REC_APP="$APP_DIR/Contents/Helpers/meetingbox-recorder.app"
REC_BIN="$REC_APP/Contents/MacOS/meetingbox-recorder"
# meetingbox 1.3.1 and earlier installed the app in $SRC_DIR and ran the recorder from it. setup
# removes that app once the new one is in place, and only if setup recorded it. Nothing that
# replaces or removes the app goes ahead while a recorder from it is still running.
OLD_APP_DIR="$SRC_DIR/meetingbox.app"
OLD_REC_BIN="$OLD_APP_DIR/Contents/MacOS/audio-capture"
# Merges the mic and call transcripts into one, labelled by speaker. Built from
# native/transcript alongside the app.
TRANSCRIPT_BIN="$SRC_DIR/mb-transcript"
# Parakeet and speaker labels: the speech helper, built from native/speech with swift build, and
# the pinned models it checks before every use. The voice print is learnt from video calls.
SPEECH_BIN="$SRC_DIR/mb-speech"
SPEECH_MODELS="$SRC_DIR/models"
# SwiftPM's dependency cache for the helper's build: FluidAudio is fetched into it once, and later
# builds of the same pinned version reuse it.
SPEECH_DEPS="$SRC_DIR/swiftpm-cache"
VOICE_FILE="$STATE_DIR/voice.json"
# The one lock every writer of the voice print takes (mb-transcript with flock, `voice forget` with
# lockf, which is the same lock), and how long a writer waits for it. Kept: never removed by a writer.
VOICE_LOCK="$VOICE_FILE.lock"
VOICE_LOCK_WAIT=30
# The app is signed with a certificate setup makes in the login keychain. macOS
# ties the permissions to that certificate, so they survive a rebuild.
SIGN_NAME="meetingbox local signing"
SIGN_KEYCHAIN="$HOME/Library/Keychains/login.keychain-db"
# macOS's own openssl: Homebrew's OpenSSL 3 writes .p12 files security cannot read.
OPENSSL="/usr/bin/openssl"
# Registering the app with LaunchServices is what lets tccutil find it by ID.
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

MEETINGBOX_REPO="https://github.com/JediConcepts/meetingbox"
SPEECH_ANALYZER_REPO="https://github.com/simonw/speech-analyzer-cli"
WHISPER_MODEL_URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin"

CHUNK_WORDS="${MB_CHUNK_WORDS:-1500}"    # ~2000 tokens, leaves room for the answer
TOKEN_CEILING="${MB_TOKEN_CEILING:-2600}"

# What the speaker labels in a transcript mean, told to every minutes writer.
LABEL_INSTRUCTIONS='Speaker labels: "Me" is the person who recorded the meeting. "Room 1", "Room 2" and so on are people in the same room, numbered in the order they first spoke; if no line is labelled "Me", the person who recorded was not recognised and may be one of them. "Them", or "Them 1", "Them 2", are people on the other end of a call; a plain "Them" next to numbered ones is someone on the call who could not be told apart. "Unknown" means the speaker could not be told. Text in brackets such as "(Them: yeah)" is a short reply made during or just after someone else'\''s turn; it may be that person'\''s answer to a question. Keep these labels exactly as written and never guess a real name for a label.'

MAP_INSTRUCTIONS='You are taking minutes. This is one slice of a longer meeting transcript, so write no introduction and no conclusion. Extract only what is actually in this text, under these headings, omitting any heading with nothing under it: DECISIONS (only what was agreed), ACTIONS (only something someone said they would do; name the owner if one was named), NUMBERS AND DATES, OPEN QUESTIONS, NOTABLE QUOTES. Be terse. Invent nothing. If a point is ambiguous, say so rather than resolving it. '"$LABEL_INSTRUCTIONS"' Keep those labels when naming who said or owns something.'

REDUCE_INSTRUCTIONS='These are notes from consecutive slices of one meeting. Merge them into a single set of minutes. Drop duplicates, keep every distinct decision and action, keep the owner against each action, and preserve all numbers, dates and names exactly as written. Add nothing that is not in the notes. Same headings: DECISIONS, ACTIONS, NUMBERS AND DATES, OPEN QUESTIONS. '"$LABEL_INSTRUCTIONS"' Keep those labels when naming who said or owns something.'

FINAL_INSTRUCTIONS="$LABEL_INSTRUCTIONS"' Write the final minutes of this meeting from the notes below, in Markdown, under exactly these four headings in this order. SUMMARY: three lines on what the meeting was about and what came of it. DECISIONS: only things the people in this meeting agreed, during it, about what happens next. ACTIONS: only things someone said they will do after the meeting. A story about the past is neither: something agreed or done before the meeting is not a decision or an action. Put an owner first only when the notes name one (a name, or a speaker label exactly as written, such as Me, Room 1 or Them 2). End every decision and action with the words from the notes that show it, in quotes; if you cannot quote the words, it did not happen, so leave it out. OPEN QUESTIONS: only questions still unanswered at the end; a question that was answered is not open. Under a heading with nothing that fits, write None. Many calls, interviews and chats decide nothing, and that is fine. No preamble and no sign off. Add nothing that is not in the notes.'

BRIEF_INSTRUCTIONS='Extract the structured record of this meeting from the notes below. Every item must come from the notes. Leave an array empty rather than guessing.'

# -------------------------------------------------------------------- plumbing

if [ -t 2 ]; then
  c_dim=$'\033[2m'; c_b=$'\033[1m'; c_r=$'\033[0;31m'
  c_g=$'\033[0;32m'; c_y=$'\033[0;33m'; c_c=$'\033[0;36m'; c_0=$'\033[0m'
else
  c_dim=; c_b=; c_r=; c_g=; c_y=; c_c=; c_0=
fi

say()  { printf '%s\n' "${c_b}meetingbox${c_0} $*" >&2; }
info() { printf '%s\n' "${c_dim}           $*${c_0}" >&2; }
ok()   { printf '%s\n' "${c_g}         +${c_0} $*" >&2; }
miss() { printf '%s\n' "${c_y}         -${c_0} $*" >&2; }
warn() { printf '%s\n' "${c_y}      warn${c_0} $*" >&2; }
# A run that has finished another kind's interrupted swap has changed the folder, so its failure says so.
die()  {
  local m="$*"
  [ "$FINISHED_OTHER" != 1 ] || m="$m. The interrupted run's new files were put in place first; this run changed nothing else"
  printf '%s\n' "${c_r}     error${c_0} $m" >&2; exit 1
}
rule() { printf '%s\n' "${c_dim}           ------------------------------------------------${c_0}" >&2; }

have() { command -v "$1" >/dev/null 2>&1; }

# A short system sound, so a hotkey press is heard to work: there is nothing on
# screen. In the background, so it never holds up the recording.
chime() {
  [ "$SOUNDS" = 1 ] && have afplay || return 0
  local f
  case "$1" in start) f=Tink ;; stop) f=Pop ;; done) f=Glass ;; *) return 0 ;; esac
  afplay "/System/Library/Sounds/$f.aiff" >/dev/null 2>&1 &
  return 0
}

# Only for a run of the script's own: a job the app runs (MB_ATTEMPT set) gets the app's own
# Minutes ready, so a banner here would be a second one.
notify() {
  [ -z "${MB_ATTEMPT:-}" ] || return 0
  have osascript || return 0
  osascript -e "display notification \"${2//\"/}\" with title \"${1//\"/}\"" >/dev/null 2>&1 || true
}

# yes/no, default yes. If stdin is not a terminal (piped, or `curl | bash`) it
# falls back to /dev/tty, because a question about installing things on someone's
# machine has to be answered by a person. With no terminal at all the answer is
# NO: silently assuming yes would install software nobody agreed to.
# `[ -r /dev/tty ]` is not good enough: the node can be readable while opening it
# fails with ENXIO (no controlling terminal). The only honest test is to open it.
tty_src() {
  [ -t 0 ] && { printf 'stdin'; return 0; }
  ( exec < /dev/tty ) 2>/dev/null && { printf '/dev/tty'; return 0; }
  return 1
}

#   confirm "question"       Enter means yes
#   confirm "question" no    Enter means no, for anything that removes things
confirm() {
  src="$(tty_src)" || {
    warn "no terminal to ask on, so leaving it alone: $1"
    info "run it in Terminal and it will ask properly"
    return 1
  }
  if [ "${2:-yes}" = no ]; then hint="[y/N]"; else hint="[Y/n]"; fi
  printf '%s' "${c_c}         ? ${c_0}$1 ${c_dim}$hint${c_0} " >&2
  if [ "$src" = stdin ]; then read -r reply || return 1
  else read -r reply < /dev/tty || return 1; fi
  case "$reply" in
    [yY]|[yY][eE][sS]) return 0 ;;
    [nN]|[nN][oO])     return 1 ;;
    *) [ "${2:-yes}" != no ] ;;
  esac
}

pause_for() {
  src="$(tty_src)" || return 0
  printf '%s' "${c_c}         > ${c_0}$1 ${c_dim}[enter]${c_0} " >&2
  if [ "$src" = stdin ]; then read -r _ || true
  else read -r _ < /dev/tty || true; fi
}

mkdir -p "$STATE_DIR"

# ------------------------------------------------------------ what setup made
#
# Setup writes down every path it creates, at the moment it creates it. reset
# and uninstall delete only paths on that list. So a folder that was already
# there (your own clone, your own whisper model, whatever an MB_* setting points
# at) is never deleted, and remove_installed is the only recursive delete of
# anything setup installed.

INSTALLED="$STATE_DIR/installed"

record_install()  { installed_by_us "$1" || printf '%s\n' "$1" >> "$INSTALLED"; }
installed_by_us() { grep -qxF -- "$1" "$INSTALLED" 2>/dev/null; }

remove_installed() {
  p="$1"
  case "$p" in
    ""|/|"$HOME"|"$HOME"/) warn "refusing to remove '$p'"; return 1 ;;
    /*) ;;
    *) warn "refusing to remove '$p': not a path"; return 1 ;;
  esac
  installed_by_us "$p" || return 1
  rm -rf -- "$p"
  forget_install "$p"
}

forget_install() {
  { grep -vxF -- "$1" "$INSTALLED" || true; } > "$INSTALLED.tmp"
  mv -f "$INSTALLED.tmp" "$INSTALLED"
}

# Clear a path for setup to create. Something meetingbox made before is replaced;
# anything else is left alone and setup stops.
claim_path() {
  if [ -e "$1" ] || [ -L "$1" ]; then
    installed_by_us "$1" || {
      warn "$1 already exists and meetingbox did not create it, so I will not replace it"
      # A shortcut added to the Dock becomes ~/Applications/<its name>.app.
      if [ "$(plist_value "$1/Contents/Info.plist" CFBundleIdentifier)" = com.apple.shortcuts.droplet ]; then
        info "this is a Shortcuts app named meetingbox; rename the shortcut or remove it from the Dock"
      fi
      info "move it somewhere else, then run: meetingbox setup"
      return 1
    }
    remove_installed "$1"
  fi
  record_install "$1"
}

# One value from an Info.plist, or nothing.
plist_value() { /usr/libexec/PlistBuddy -c "Print :$2" "$1" 2>/dev/null || true; }

# Moves a bundle to a path that must not exist yet. mv onto a folder that exists would put the
# bundle inside it (meetingbox.app/meetingbox.app), so anything there is refused instead.
move_bundle() {
  if [ -e "$2" ] || [ -L "$2" ]; then
    warn "$2 is still there, so nothing was moved into it"
    return 1
  fi
  mv -- "$1" "$2"
}

# A meetingbox.app from v1.2.0, built before setup kept its list, is still ours:
# it carries meetingbox's bundle ID.
adopt_own_app() {
  [ -f "$APP_DIR/Contents/Info.plist" ] || return 0
  id="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$APP_DIR/Contents/Info.plist" 2>/dev/null || true)"
  [ "$id" = "$APP_ID" ] && record_install "$APP_DIR"
  return 0
}

macos_major() { sw_vers -productVersion 2>/dev/null | cut -d. -f1; }

open_privacy() {
  have open || return 0
  open "x-apple.systempreferences:com.apple.preference.security?Privacy_$1" >/dev/null 2>&1 || true
}

on_path() { case ":$PATH:" in *":$BIN_DIR:"*) return 0 ;; *) return 1 ;; esac; }

# Ready means built, and built by this version, so updating meetingbox rebuilds it. setup from
# MB_SOURCE_DIR also rebuilds an app built from other source than is there now (need_recorder):
# a build with the same VERSION would otherwise keep the old app.
recorder_ready() {
  [ -x "$APP_BIN" ] || return 1
  # an app built before the helper existed has the right version and no helper
  [ -x "$REC_BIN" ] || return 1
  [ -x "$TRANSCRIPT_BIN" ] || return 1
  local built
  built="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$APP_DIR/Contents/Info.plist" 2>/dev/null || true)"
  [ "$built" = "$VERSION" ]
}

# The source the app and mb-transcript are built from (the Swift and the icon) as one hash of
# each file's name, relative to the source folder, and contents, with the recipe that builds
# them: the compile lines and the two Info.plists, which live in this script's build_app and
# install_recorder (declare -f, so comments do not count). A build is stamped with it
# (MBSourceHash), so it is known by its source whatever VERSION says. Empty with no source.
source_hash() {
  local f
  [ -d "$SOURCE_DIR/native" ] || return 0
  set --
  for f in "$SOURCE_DIR"/native/recorder/*.swift "$SOURCE_DIR"/native/app/*.swift \
           "$SOURCE_DIR"/native/transcript/*.swift "$SOURCE_DIR/native/app/icon.png"; do
    if [ -f "$f" ]; then set -- "$@" "${f#"$SOURCE_DIR"/}"; fi
  done
  [ "$#" -gt 0 ] || return 0
  { { (cd "$SOURCE_DIR" && shasum -a 256 -- "$@")
      printf '%s  (build recipe)\n' "$(declare -f build_app install_recorder | shasum -a 256 | cut -d' ' -f1)"
    } | LC_ALL=C sort | shasum -a 256 | cut -d' ' -f1; } || true
}

# The source's commit, short, when the source folder is a git checkout of its own (not a folder
# inside another checkout). Empty otherwise, for example for a git archive.
source_commit() {
  local c
  [ -e "$SOURCE_DIR/.git" ] || return 0
  c="$(git -C "$SOURCE_DIR" rev-parse --short HEAD 2>/dev/null)" || return 0
  case "$c" in ""|*[!0-9a-f]*) return 0 ;; esac
  printf '%s' "$c"
}

# Built from the source on disk now. Only a build from MB_SOURCE_DIR is compared: a release
# clone is pinned by its tag, which VERSION names (recorder_ready compares that), and one left at
# an older tag is moved on by fetch_source only once a rebuild is under way. With no source on
# disk there is nothing to compare either.
built_from_source() {
  local now
  [ -n "${MB_SOURCE_DIR:-}" ] || return 0
  now="$(source_hash)"
  [ -z "$now" ] || [ "$now" = "$(plist_value "$APP_DIR/Contents/Info.plist" MBSourceHash)" ]
}

# Start the recorder through `open`, so it runs as meetingbox.app in its own
# right rather than as a child of this shell. macOS grants Screen Recording and
# Microphone to the app that launched a process, so a child of Terminal would be
# Terminal's, and from a hotkey Shortcuts'. This way there is one grant, listed
# as meetingbox, whatever starts it. Launched this way it also keeps a live
# SIGINT, which a `&` job in a script does not, so stopping finalises the m4a.
# stdout goes to /dev/null: the recorder once streamed raw PCM there whenever it
# was not a terminal. Prints the new recorder's PID.
#
# The first launch after a rebuild can be slow while macOS checks the new
# signature, so it waits up to 10s. If the recorder still has not shown up, any
# that turns up for this folder later is stopped, never left recording alone.
launch_recorder() {
  out="$1"; name="$2"; log="$3"; shift 3
  open -n -g --stdout /dev/null --stderr "$log" "$APP_DIR" --args --record -o "$out" -n "$name" "$@" \
    >/dev/null 2>&1 || return 1
  i=0
  while [ "$i" -lt 100 ]; do
    p="$(recorder_pids "$out" | head -n 1)"
    [ -n "$p" ] && { printf '%s' "$p"; return 0; }
    sleep 0.1; i=$((i + 1))
  done
  stop_recorders "$out"
  return 1
}

# PIDs of the recorders writing into one folder, or of every meetingbox recorder
# when the folder is "". Every launch gets a folder of its own, so this names the
# right process however late it started. Matched as a fixed string, since a
# folder name is not a pattern. Both executables count: the helper's, which is
# what the app starts, and the app's own, which is what the build before the
# helper started and what the setup permission check still starts.
recorder_pids() {
  pids_with_prefix "$REC_BIN --record -o ${1:+$1 -n }"
  pids_with_prefix "$APP_BIN --record -o ${1:+$1 -n }"
}

# PIDs of the recoveries running: the app's, from the helper, or the command's own.
recover_pids() {
  pids_with_prefix "$REC_BIN --recover "
  pids_with_prefix "$APP_BIN --recover "
}

# PIDs of the processes whose command line starts with $1, a fixed string.
pids_with_prefix() {
  ps -axo pid=,command= | NEEDLE="$1" awk '
    { pid = $1; sub(/^ *[0-9]+ /, "") }
    index($0, ENVIRON["NEEDLE"]) == 1 { print pid }'
}

# Recorders still running from the old app (OLD_REC_BIN), "<pid> <folder>" for each. Neither
# this command nor the new app can stop one: it is found here by its command line.
old_app_recorders() {
  ps -axo pid=,command= | NEEDLE="$OLD_REC_BIN -o " awk '
    { pid = $1; sub(/^ *[0-9]+ /, "") }
    index($0, ENVIRON["NEEDLE"]) == 1 {
      rest = substr($0, length(ENVIRON["NEEDLE"]) + 1)
      n = index(rest, " -n ")
      dir = n ? substr(rest, 1, n - 1) : rest
      print pid " " dir
    }'
}

# A recorder or a recovery is running: the app's, the command's own, or one from the old app.
capture_running() {
  [ -n "$(recorder_pids "")" ] || [ -n "$(recover_pids)" ] || [ -n "$(old_app_recorders)" ]
}

# The app's meetings folder, when its preference holds a full path; nothing otherwise.
app_meetings_folder() {
  local d
  d="$(defaults read "$APP_ID" meetingsFolder 2>/dev/null)" || return 0
  case "$d" in
    *"
"*) return 0 ;;
    /*) printf '%s' "$d" ;;
  esac
}

# A recording is being made or saved: a recorder or a recovery is running, a session is open
# (recording.dir, kept by the app while it records or finalises, and by meetingbox 1.3.1 while
# it recorded), or a meeting.json says recording or finalising, in the meetings folder this
# command uses or the one the app's preferences name. Rebuilding or re-signing the app
# underneath it could cost the meeting.
recording_busy() {
  local root j
  capture_running && return 0
  has_session && return 0
  for root in "$BASE_DIR" "$(app_meetings_folder)"; do
    [ -n "$root" ] || continue
    for j in "$root"/*/meeting.json; do
      [ -f "$j" ] || continue
      grep -Eq '"state"[[:space:]]*:[[:space:]]*"(recording|finalising)"' "$j" && return 0
    done
  done
  return 1
}

# setup, uninstall and reset --tools replace or remove the app, so none of them goes ahead while
# a recording is being made, finished or recovered. For a recorder from the old app the folder is
# named, and how to stop it keeping its audio. $1: the command, to run again afterwards.
refuse_while_busy() {
  local old p d
  old="$(old_app_recorders)"
  if [ -n "$old" ]; then
    while IFS= read -r p; do
      d="${p#* }"; p="${p%% *}"
      warn "an older meetingbox is still recording into $d"
      info "to stop it and keep what it recorded: kill -INT $p"
    done <<< "$old"
    info "then run: meetingbox $1"
    return 1
  fi
  recording_busy || return 0
  warn "a recording is still being saved. Wait for it, or run: meetingbox stop"
  # recording.dir with nothing recording and no app running. Left by meetingbox 1.3 or earlier
  # (no 2.0 app installed), reset clears it. Left by a 2.0 app that stopped with its recorder,
  # opening meetingbox recovers it, as status says.
  if has_session && ! capture_running && ! app_lock_held; then
    if app_is_client_aware; then
      info "the recording in $(session_dir) did not finish; open meetingbox to recover it"
    else
      info "nothing is recording into $(session_dir) now. If an older meetingbox left it there, clear it with: meetingbox reset"
    fi
  fi
  info "then run: meetingbox $1"
  return 1
}

# A running app is asked to quit, as its own Quit menu would, and given 10 s to go. Every caller
# is about to replace or remove the app, and setup can spend minutes asking, fetching and
# compiling first, so a recording started meanwhile is checked for here, before any Apple event
# is sent (the app's own quit dialog covers the moment between): then it refuses, as
# refuse_while_busy does. $1: the command, to run again afterwards. Only a running app is asked
# (app.lock is held for its whole life), so this never starts one. A recorder that outlives the
# app (Keep recording and quit) refuses too: nothing is replaced or removed, and the app stays
# closed.
quit_app() {
  local i=0
  refuse_while_busy "$1" || return 1
  app_lock_held || return 0
  info "quitting the meetingbox app"
  osascript -e "quit app id \"$APP_ID\"" >/dev/null 2>&1 || true
  while app_lock_held; do
    if [ "$i" -ge 100 ]; then
      warn "the meetingbox app did not quit. Quit it from its menu, then try again"
      return 1
    fi
    sleep 0.1; i=$((i + 1))
  done
  if capture_running; then
    warn "the app has quit but a recording is still running, so nothing was replaced or removed"
    info "open meetingbox and stop it, then run: meetingbox $1"
    return 1
  fi
}

# setup ends with the app running. Only an app built for this command is opened: one from
# meetingbox 1.3 or earlier, opened with no arguments, starts recording on its own.
open_app() {
  app_is_client_aware || return 0
  open "$APP_DIR" >/dev/null 2>&1 || warn "could not open $APP_DIR"
}

# Once the new app is in place, the old one goes, only if setup recorded it and nothing is
# recording from it. Unregistered first, so macOS stops offering it for the bundle ID.
remove_old_app() {
  installed_by_us "$OLD_APP_DIR" || return 0
  recorder_ready || return 0
  [ -z "$(old_app_recorders)" ] || return 0
  if [ -x "$LSREGISTER" ]; then "$LSREGISTER" -u "$OLD_APP_DIR" >/dev/null 2>&1 || true; fi
  if remove_installed "$OLD_APP_DIR"; then ok "removed the old app, $OLD_APP_DIR"; fi
}

stop_recorders() { for p in $(recorder_pids "$1"); do stop_proc "$p" "${2:-150}"; done; }

# Ask nicely, then insist, then stop asking. The shell's own job notices are
# swallowed so the user never sees "line 215: 1952 Killed".
stop_proc() {
  p="$1"; grace="${2:-150}"
  kill -INT "$p" 2>/dev/null || true
  i=0; while kill -0 "$p" 2>/dev/null && [ "$i" -lt "$grace" ]; do sleep 0.1; i=$((i + 1)); done
  if kill -0 "$p" 2>/dev/null; then
    kill -TERM "$p" 2>/dev/null || true
    i=0; while kill -0 "$p" 2>/dev/null && [ "$i" -lt 30 ]; do sleep 0.1; i=$((i + 1)); done
  fi
  if kill -0 "$p" 2>/dev/null; then
    kill -9 "$p" 2>/dev/null || true
    # Not this shell's child when launched with `open`, so `wait` cannot wait for
    # it, and -9 lands asynchronously: poll until it is gone, up to 5s, so that
    # recovery does not race a recorder still holding its folder.
    i=0; while kill -0 "$p" 2>/dev/null && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
  fi
  { wait "$p"; } 2>/dev/null || true
}

# ------------------------------------------------------------------ setup steps

# swiftc is the thing actually needed, and `xcode-select -p` can report a path
# while the toolchain is still downloading, so test for the compiler itself.
need_xcode_clt()      { ! have swiftc; }
need_brew()           { ! have brew; }
need_recorder()       { ! recorder_ready || ! built_from_source; }
# Checked whenever the recorder is due too, so a release update rebuilds a changed helper.
need_speech()         { need_recorder || ! speech_ready; }
# fm rejects an empty prompt ("Missing prompt"), so the probe must send one or it
# reports the licence missing on every machine.
need_fm_license()     { have fm && ! printf 'ok' | fm respond -i 'Reply with the single word ok.' >/dev/null 2>&1; }

transcriber_present() { have speech-analyzer || have whisper-cli; }

brew_bin() {
  if [ -x /opt/homebrew/bin/brew ]; then printf '/opt/homebrew/bin/brew'
  elif [ -x /usr/local/bin/brew ]; then printf '/usr/local/bin/brew'
  else printf ''; fi
}

install_xcode_clt() {
  say "Xcode Command Line Tools"
  info "a one off Apple download, needed to compile the recorder"
  xcode-select --install >/dev/null 2>&1 || true
  info "an Apple installer window should have opened"
  pause_for "click through it, then come back here and press enter"
  if need_xcode_clt; then
    warn "still not detected. Finish the Apple installer, then run: meetingbox setup"
    return 1
  fi
  ok "Xcode Command Line Tools"
}

install_brew() {
  say "Homebrew"
  info "the package manager. It will ask for your Mac password."
  if ! /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"; then
    warn "Homebrew install did not finish"
    return 1
  fi
  b="$(brew_bin)"
  [ -n "$b" ] && eval "$("$b" shellenv)"
  have brew && ok "Homebrew" || { warn "Homebrew installed but not on PATH, reopen Terminal"; return 1; }
}

# Make sure the recorder's source is on disk. MB_SOURCE_DIR is used as it is and
# never recorded or deleted. Otherwise it is a clone of this version's tag.
fetch_source() {
  if [ -n "${MB_SOURCE_DIR:-}" ]; then
    [ -f "$SOURCE_DIR/native/app/Main.swift" ] \
      || { warn "no app source in $SOURCE_DIR/native/app"; return 1; }
    return 0
  fi
  mkdir -p "$SRC_DIR"
  if [ -d "$SOURCE_DIR/.git" ] && installed_by_us "$SOURCE_DIR"; then
    git -C "$SOURCE_DIR" fetch --depth 1 origin tag "v$VERSION" >/dev/null 2>&1 \
      && git -C "$SOURCE_DIR" checkout -q "v$VERSION" \
      || { warn "could not fetch v$VERSION of meetingbox"; return 1; }
  else
    claim_path "$SOURCE_DIR" || return 1
    git clone -q --depth 1 --branch "v$VERSION" "$MEETINGBOX_REPO" "$SOURCE_DIR" \
      || { warn "could not clone $MEETINGBOX_REPO at v$VERSION"; return 1; }
  fi
  [ -f "$SOURCE_DIR/native/app/Main.swift" ] \
    || { warn "no app source in $SOURCE_DIR/native/app"; return 1; }
}

install_recorder() {
  say "the recorder"
  info "captures the far side with ScreenCaptureKit and your mic together"
  info "no virtual audio driver, no aggregate device, nothing to reboot"
  mkdir -p "$SRC_DIR" "$BIN_DIR"
  have swiftc || {
    warn "no Swift compiler, so the Command Line Tools are not ready yet"
    info "finish the Apple installer window, then run: meetingbox setup"
    return 1
  }
  fetch_source || return 1
  build_dir="$(mktemp -d)" || return 1
  info "compiling. The first Swift build on a Mac caches Apple's frameworks and can"
  info "sit silent for a few minutes. It has not hung, leave it be."
  # Apple deprecates names each macOS release; warnings are noise here, errors still show.
  if ! swiftc -O -o "$build_dir/mb-transcript" "$SOURCE_DIR"/native/transcript/*.swift -suppress-warnings; then
    rm -rf -- "$build_dir"
    warn "compile failed, see the output above"
    return 1
  fi
  build_app || { rm -rf -- "$build_dir"; return 1; }
  if ! { claim_path "$TRANSCRIPT_BIN" && install -m 755 "$build_dir/mb-transcript" "$TRANSCRIPT_BIN"; }; then
    rm -rf -- "$build_dir"
    return 1
  fi
  rm -rf -- "$build_dir"
  ok "recorder -> $APP_DIR"
  ok "transcript helper -> $TRANSCRIPT_BIN"
}

# The speech helper's source as one hash: Package.swift, Package.resolved and every
# Sources/mb-speech/*.swift but BuildStamp.swift (which carries the hash), each by name and
# contents, with the recipe that builds them (install_speech, declare -f, so comments do not
# count). Setup stamps the build with it and `mb-speech version` prints it. Empty with no source.
speech_hash() {
  local f
  [ -d "$SOURCE_DIR/native/speech" ] || return 0
  set -- native/speech/Package.swift native/speech/Package.resolved
  for f in "$SOURCE_DIR"/native/speech/Sources/mb-speech/*.swift; do
    case "$f" in */BuildStamp.swift) ;; *) [ -f "$f" ] && set -- "$@" "${f#"$SOURCE_DIR"/}" ;; esac
  done
  { { (cd "$SOURCE_DIR" && shasum -a 256 -- "$@")
      printf '%s  (build recipe)\n' "$(declare -f install_speech | shasum -a 256 | cut -d' ' -f1)"
    } | LC_ALL=C sort | shasum -a 256 | cut -d' ' -f1; } || true
}

# Usable: the helper runs and its models pass its own check (every file at its size, each folder's
# revision markers). Ready: usable, built from the source on disk, and with the source's manifest.
speech_usable() { [ -x "$SPEECH_BIN" ] && "$SPEECH_BIN" check "$SPEECH_MODELS" >/dev/null 2>&1; }
speech_ready() {
  local hash
  speech_usable || return 1
  hash="$(speech_hash)"
  [ -n "$hash" ] && [ "$("$SPEECH_BIN" version 2>/dev/null | cut -d' ' -f3)" = "$hash" ] \
    && cmp -s "$SPEECH_MODELS/models.json" "$SOURCE_DIR/native/speech/models.json"
}

# The folder Core ML keeps the helper's prepared models in, as the helper reports it. Printed only
# when that is one line holding an absolute path that ends in /Library/Caches/mb-speech with no
# '..' part, so a shared folder is never recorded, and so never removed.
speech_cache() {
  local c
  c="$("$SPEECH_BIN" cache-dir 2>/dev/null)" || return 1
  case "$c" in
    *"
"*|*/../*|*/..) return 1 ;;
    /*/Library/Caches/mb-speech) printf '%s\n' "$c" ;;
    *) return 1 ;;
  esac
}

speech_failed() { warn "Parakeet could not be set up: $1. Carrying on with Apple's transcriber."; }
# Any failure in the step: a helper that is still usable goes on being used, so it says that.
speech_step_failed() {
  if speech_usable; then warn "Parakeet could not be updated: $1. The installed version is still used."
  else speech_failed "$1"; fi
}

# Parakeet and speaker labels (on device). Builds mb-speech in a temporary folder that holds every
# SwiftPM clone and setting, so nothing lands in the user's shared Swift folders, and replaces the
# installed helper only once the build has worked. The one thing kept between builds is the
# fetched FluidAudio, in meetingbox's own dependency cache (SPEECH_DEPS). Then fetches the pinned
# models when they fail the helper's check or differ from the source's manifest, and warms them.
# Any failure says so and returns 1; setup carries on, and a working helper or model is kept.
install_speech() {
  local tmp bin cache reason hash tries try
  say "Parakeet and speaker labels (on device)"
  info "a more accurate transcriber and speaker labels, about 630 MB of models"
  have swift || { speech_step_failed "swift build is not installed"; return 1; }
  fetch_source || { speech_step_failed "the meetingbox source could not be fetched"; return 1; }
  [ -f "$SOURCE_DIR/native/speech/Package.swift" ] || { speech_step_failed "no speech helper source in $SOURCE_DIR"; return 1; }
  hash="$(speech_hash)"
  # Rebuilt only when its own source changed: a recorded helper stamped with this hash is kept.
  if installed_by_us "$SPEECH_BIN" && [ -x "$SPEECH_BIN" ] \
     && [ "$("$SPEECH_BIN" version 2>/dev/null | cut -d' ' -f3)" = "$hash" ]; then
    ok "speech helper is up to date"
  else
    # The dependency cache keeps FluidAudio's fetched source, so a rebuild of the same pinned
    # version does not fetch it again. The versions in Package.resolved are forced, so the cache
    # never changes what is built. It is made and recorded the first time (a record whose folder
    # could not be made is forgotten), and after that used as it is: never claimed, which would
    # empty it. A folder there that meetingbox did not make, or any link, even a recorded one, is
    # not used or touched, and the build caches in its temporary folder, as before.
    tries=temp
    if [ ! -e "$SPEECH_DEPS" ] && [ ! -L "$SPEECH_DEPS" ]; then
      if mkdir -p "$SRC_DIR" && record_install "$SPEECH_DEPS"; then
        if mkdir -m 700 "$SPEECH_DEPS"; then tries="deps temp"; else forget_install "$SPEECH_DEPS"; fi
      fi
    elif [ ! -L "$SPEECH_DEPS" ] && installed_by_us "$SPEECH_DEPS"; then
      tries="deps temp"
    else
      info "$SPEECH_DEPS is not meetingbox's, so the build fetches FluidAudio as before"
    fi
    if [ "$tries" = temp ]; then info "compiling. The first build fetches FluidAudio and takes a few minutes."
    else info "compiling. The first build fetches FluidAudio and takes a few minutes. Later builds reuse it."; fi
    # A build that fails with the cache removes it (the next setup makes it again) and is tried
    # once more as before, from a fresh temporary folder. Only that one failing is a failure.
    for try in $tries; do
      tmp="$(mktemp -d)" || { speech_step_failed "no temporary folder"; return 1; }
      cp -R "$SOURCE_DIR/native/speech" "$tmp/speech" \
        && printf 'let buildVersion = "%s"\nlet speechHash = "%s"\n' "$VERSION" "$hash" \
             > "$tmp/speech/Sources/mb-speech/BuildStamp.swift" \
        || { rm -rf -- "$tmp"; speech_step_failed "the source could not be copied"; return 1; }
      if [ "$try" = deps ]; then set -- --cache-path "$SPEECH_DEPS"
      else set -- --cache-path "$tmp/cache" --disable-dependency-cache; fi
      set -- --package-path "$tmp/speech" --scratch-path "$tmp/build" --config-path "$tmp/config" \
        --security-path "$tmp/security" --manifest-cache local --force-resolved-versions "$@"
      # Whatever those flags say, swift build still makes folders and URL caches under HOME
      # (~/.swiftpm, ~/Library/org.swift.swiftpm, ~/Library/Caches) and lock files in TMPDIR, so it
      # runs with both, and the home Foundation reads, inside the temporary folder as well.
      mkdir "$tmp/home" "$tmp/tmp" || { rm -rf -- "$tmp"; speech_step_failed "no temporary folder"; return 1; }
      if HOME="$tmp/home" CFFIXED_USER_HOME="$tmp/home" TMPDIR="$tmp/tmp/" swift build -c release "$@" >&2 \
         && bin="$(HOME="$tmp/home" CFFIXED_USER_HOME="$tmp/home" TMPDIR="$tmp/tmp/" \
                   swift build -c release "$@" --show-bin-path)" \
         && [ -x "$bin/mb-speech" ]; then
        break
      fi
      rm -rf -- "$tmp"
      [ "$try" = deps ] || { speech_step_failed "the speech helper did not build"; return 1; }
      remove_installed "$SPEECH_DEPS"
      info "the build with meetingbox's FluidAudio cache failed, so it is tried once more without the cache"
    done
    # A recorded helper is replaced by a rename over it, never removed first, so a failed
    # install leaves the old one working. The first install claims the path.
    if installed_by_us "$SPEECH_BIN" && { [ -e "$SPEECH_BIN" ] || [ -L "$SPEECH_BIN" ]; }; then
      install -m 755 "$bin/mb-speech" "$SPEECH_BIN.new" && mv -f "$SPEECH_BIN.new" "$SPEECH_BIN"
    else
      mkdir -p "$SRC_DIR" && claim_path "$SPEECH_BIN" && install -m 755 "$bin/mb-speech" "$SPEECH_BIN"
    fi || {
      rm -f "$SPEECH_BIN.new"; rm -rf -- "$tmp"
      speech_step_failed "the speech helper could not be installed"
      return 1
    }
    rm -rf -- "$tmp"
    ok "speech helper -> $SPEECH_BIN"
  fi

  # Recorded only if it is not there yet: a folder of the user's own is never claimed.
  if cache="$(speech_cache)" && [ ! -e "$cache" ] && [ ! -L "$cache" ]; then record_install "$cache"; fi
  if [ ! -e "$VOICE_FILE" ] && [ ! -L "$VOICE_FILE" ]; then record_install "$VOICE_FILE"; fi
  # The voice print's lock: when absent, or when a writer already made it beside a voice print setup
  # recorded (a plain file in the state folder, never a link), so reset and uninstall never leave it.
  if { [ ! -e "$VOICE_LOCK" ] && [ ! -L "$VOICE_LOCK" ]; } \
     || { [ -f "$VOICE_LOCK" ] && [ ! -L "$VOICE_LOCK" ] && [ "$(dirname "$VOICE_LOCK")" = "$STATE_DIR" ] \
          && installed_by_us "$VOICE_FILE"; }; then
    record_install "$VOICE_LOCK"
  fi

  if [ -e "$SPEECH_MODELS" ] || [ -L "$SPEECH_MODELS" ]; then
    installed_by_us "$SPEECH_MODELS" || { claim_path "$SPEECH_MODELS"; speech_step_failed "the models folder is not meetingbox's"; return 1; }
  else
    { claim_path "$SPEECH_MODELS" && mkdir -m 700 "$SPEECH_MODELS"; } \
      || { speech_step_failed "$SPEECH_MODELS could not be made"; return 1; }
  fi
  if ! "$SPEECH_BIN" check "$SPEECH_MODELS" >/dev/null 2>&1 \
     || ! cmp -s "$SPEECH_MODELS/models.json" "$SOURCE_DIR/native/speech/models.json"; then
    info "downloading the pinned models, about 630 MB"
    reason="$("$SPEECH_BIN" fetch "$SPEECH_MODELS" "$SOURCE_DIR/native/speech/models.json" 2>&1 >/dev/null)" \
      || { speech_step_failed "${reason#mb-speech: }"; return 1; }
  fi
  ok "speech models -> $SPEECH_MODELS"
  info "preparing the models once, about 30 seconds"
  reason="$("$SPEECH_BIN" warm "$SPEECH_MODELS" 2>&1 >/dev/null)" || { speech_step_failed "${reason#mb-speech: }"; return 1; }
  ok "Parakeet and speaker labels"
}

# Build meetingbox.app: the recorder and the app compiled into one executable,
# the icon and the Info.plist, signed with the meetingbox certificate so the
# permissions survive a rebuild. Without it the app is signed ad hoc, and macOS
# asks again after each update. The same executable, copied, is the recorder
# helper (see REC_BIN above): one compile, a second bundle with its own
# identifier.
#
# The whole bundle is made in a temporary folder first. The installed app is
# replaced only once the new one is complete, so a failed build leaves the user
# with the app they had, still able to record.
#
# Every build says which it is, in both Info.plists: the version, the time it was
# built as YYYYMMDDHHMM (CFBundleVersion, numeric so it only grows), the hash of the
# source it was built from (MBSourceHash) and, from a git checkout, the commit
# (MBCommit). The app shows them as one line (BuildInfo.swift), and so does
# `meetingbox version`.
build_app() {
  local had_ad_hoc=0 build_tmp bundle helper iconset s hash built commit commit_key=""
  # from the app being replaced, before it is
  [ -d "$APP_DIR" ] && ! app_signed_by_us && had_ad_hoc=1
  adopt_own_app
  hash="$(source_hash)"
  built="$(date +%Y%m%d%H%M)"
  commit="$(source_commit)"
  if [ -n "$commit" ]; then commit_key="<key>MBCommit</key><string>$commit</string>"; fi
  build_tmp="$(mktemp -d)" || return 1
  bundle="$build_tmp/meetingbox.app"
  helper="$bundle/Contents/Helpers/meetingbox-recorder.app"
  iconset="$build_tmp/meetingbox.iconset"
  mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Resources" "$helper/Contents/MacOS" "$iconset"
  # Apple deprecates names each macOS release; warnings are noise here, errors still show.
  if ! swiftc -O -parse-as-library -o "$bundle/Contents/MacOS/meetingbox" \
         "$SOURCE_DIR"/native/recorder/*.swift "$SOURCE_DIR"/native/app/*.swift \
         -framework ScreenCaptureKit -framework AVFoundation -framework CoreMedia \
         -framework AppKit -framework SwiftUI -suppress-warnings; then
    rm -rf -- "$build_tmp"
    warn "compile failed, see the output above"
    return 1
  fi
  # The recorder helper: a copy of that executable, not a second compile.
  install -m 755 "$bundle/Contents/MacOS/meetingbox" "$helper/Contents/MacOS/meetingbox-recorder" \
    || { rm -rf -- "$build_tmp"; warn "could not make the recorder helper"; return 1; }
  # The icon: every size macOS asks for, from the one 1024 px png.
  for s in 16 32 128 256 512; do
    sips -z "$s" "$s" "$SOURCE_DIR/native/app/icon.png" --out "$iconset/icon_${s}x${s}.png" >/dev/null 2>&1 \
      && sips -z "$((s * 2))" "$((s * 2))" "$SOURCE_DIR/native/app/icon.png" --out "$iconset/icon_${s}x${s}@2x.png" >/dev/null 2>&1 \
      || { rm -rf -- "$build_tmp"; warn "could not make the app icon"; return 1; }
  done
  iconutil -c icns "$iconset" -o "$bundle/Contents/Resources/meetingbox.icns" >/dev/null 2>&1 \
    || { rm -rf -- "$build_tmp"; warn "could not make the app icon"; return 1; }
  cat > "$bundle/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>$APP_ID</string>
  <key>CFBundleName</key><string>meetingbox</string>
  <key>CFBundleDisplayName</key><string>meetingbox</string>
  <key>CFBundleExecutable</key><string>meetingbox</string>
  <key>CFBundleIconFile</key><string>meetingbox</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$VERSION</string>
  <key>CFBundleVersion</key><string>$built</string>
  <key>MBSourceHash</key><string>$hash</string>
  $commit_key
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>LSUIElement</key><true/>
  <key>NSHighResolutionCapable</key><true/>
  <key>MBScriptPath</key><string>$BIN_DIR/meetingbox</string>
  <key>NSMicrophoneUsageDescription</key><string>meetingbox records your side of the meeting.</string>
  <key>NSAudioCaptureUsageDescription</key><string>meetingbox records the other side of the meeting.</string>
</dict>
</plist>
PLIST
  # No icon and no script path: nothing shows it, and it runs only --record and --recover.
  cat > "$helper/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>$REC_ID</string>
  <key>CFBundleName</key><string>meetingbox recorder</string>
  <key>CFBundleDisplayName</key><string>meetingbox recorder</string>
  <key>CFBundleExecutable</key><string>meetingbox-recorder</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$VERSION</string>
  <key>CFBundleVersion</key><string>$built</string>
  <key>MBSourceHash</key><string>$hash</string>
  $commit_key
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>LSUIElement</key><true/>
  <key>NSMicrophoneUsageDescription</key><string>meetingbox records your side of the meeting.</string>
  <key>NSAudioCaptureUsageDescription</key><string>meetingbox records the other side of the meeting.</string>
</dict>
</plist>
PLIST
  # Complete: now, and only now, replace the installed app. A running copy is quit
  # first, so an old one never runs on after an install; one that will not quit is
  # left as it was. The new bundle goes only where nothing is left (move_bundle).
  # ~/Applications is the user's own folder, so it is made if missing but never recorded.
  mkdir -p "$(dirname "$APP_DIR")"
  quit_app setup || { rm -rf -- "$build_tmp"; return 1; }
  claim_path "$APP_DIR" || { rm -rf -- "$build_tmp"; return 1; }
  if ! move_bundle "$bundle" "$APP_DIR"; then
    rm -rf -- "$build_tmp"
    warn "could not put meetingbox.app in $(dirname "$APP_DIR")"
    return 1
  fi
  rm -rf -- "$build_tmp"
  if sign_app; then
    register_app
    if [ "$had_ad_hoc" = 1 ]; then forget_old_approvals; fi
  else
    warn "could not use the meetingbox signing certificate, so macOS will ask for permissions again after each update"
    sign_ad_hoc || { warn "could not sign the recorder app"; return 1; }
    register_app
  fi
}

# The signature without the certificate, for when the certificate cannot be used. The helper
# first, as with the certificate: the app's signature seals the helper's. Both, always, so the seal
# is whole whatever the certificate did or did not manage before it failed.
sign_ad_hoc() {
  { codesign --force --sign - --identifier "$REC_ID" "$REC_APP" \
      && codesign --force --sign - --identifier "$APP_ID" "$APP_DIR"; } >/dev/null 2>&1
}

# macOS ties Screen Recording and the Microphone to the app's signature. Once an
# app that was signed ad hoc is signed with the certificate, its old approvals
# still show as on in Privacy settings but no longer apply, and turning them off
# and on does not help. Clear them so macOS asks afresh, this one last time.
forget_old_approvals() {
  tccutil reset ScreenCapture "$APP_ID" >/dev/null 2>&1 || true
  tccutil reset Microphone "$APP_ID" >/dev/null 2>&1 || true
  info "meetingbox now has its own signature, so macOS will ask for Screen Recording and the Microphone once more"
}

# The one way the app is signed with the certificate: after a build, and by
# setup when the app is not signed by it (an earlier ad hoc fallback, or a
# certificate deleted since). Inside out, without --deep: the helper is signed
# first, with an identifier of its own, because the app's signature seals what
# is inside it. A helper that cannot be signed leaves the app unsigned, and is
# reported by the caller as the app is.
sign_app() {
  local hash
  ensure_signing_identity || return 1
  tell_signing_prompt
  hash="$(signing_hash)"
  codesign --force --sign "$hash" --keychain "$SIGN_KEYCHAIN" \
    --identifier "$REC_ID" "$REC_APP" >/dev/null 2>&1 || return 1
  codesign --force --sign "$hash" --keychain "$SIGN_KEYCHAIN" \
    --identifier "$APP_ID" "$APP_DIR" >/dev/null 2>&1
}

# setup's step for an app that is built but not signed by the certificate
resign_app() {
  say "the signing certificate"
  # Signing rewrites the bundle, so a running app is quit first, as for a build.
  quit_app setup || return 1
  if sign_app; then
    register_app
    forget_old_approvals
    ok "meetingbox.app signed with the meetingbox certificate"
  else
    warn "could not use the meetingbox signing certificate, so macOS will ask for permissions again after each update"
    # A certificate that signed the helper and then failed on the app has left the app's seal
    # naming a helper that has changed. Ad hoc for both makes it whole again.
    sign_ad_hoc || { warn "could not sign the recorder app"; return 1; }
    register_app
  fi
}

# Adding the certificate to the keychain, and the first codesign with it, can
# each open a macOS dialog behind Terminal. Say so once, before either.
tell_signing_prompt() {
  [ "${SIGN_TOLD:-0}" = 1 ] && return 0
  info "macOS may ask for your login password so meetingbox can sign itself. Choose Always Allow."
  SIGN_TOLD=1
}

# Signed by the recorded certificate. For a self-signed certificate, codesign
# writes a designated requirement naming its SHA-1 (certificate leaf = H"..."),
# so this checks the very certificate, not a name.
app_signed_by_us() {
  local h req
  h="$(signing_hash)"
  is_sha1 "$h" || return 1
  req="$(codesign -d -r- "$APP_DIR" 2>&1)" || return 1
  h="$(printf '%s' "$h" | tr 'ABCDEF' 'abcdef')"
  req="$(printf '%s' "$req" | tr 'ABCDEF' 'abcdef')"
  case "$req" in *"H\"$h\""*) return 0 ;; esac
  return 1
}

register_app() {
  [ -x "$LSREGISTER" ] && "$LSREGISTER" -f "$APP_DIR" >/dev/null 2>&1 || true
}

# The certificate is known by its SHA-1 only, as recorded when setup made it.
# Its name is never used to find, sign with or delete it: security and codesign
# match a name as a substring, which could reach a certificate the user made.
is_sha1() {
  [ "${#1}" -eq 40 ] || return 1
  case "$1" in *[!0123456789ABCDEF]*) return 1 ;; esac
}
signing_hash() {
  sed -n '/^keychain:sha1:/{s/^keychain:sha1://;p;q;}' "$INSTALLED" 2>/dev/null || true
}

# Listed as an identity, so the private key is there too. Read into a variable
# first: grep -q closing a pipe early would kill security under pipefail. No -v,
# which hides a self-signed certificate that is not trusted.
identity_listed() {
  local ids
  is_sha1 "$1" || return 1
  ids="$(security find-identity -p codesigning "$SIGN_KEYCHAIN" 2>/dev/null)" || return 1
  case "$ids" in *" $1 "*) return 0 ;; esac
  return 1
}
have_signing_identity() { identity_listed "$(signing_hash)"; }

# A certificate setup did not make is never used or deleted, whatever its name.
# A self-signed one is enough: codesign does not need it trusted.
ensure_signing_identity() {
  local h tmp pw made=0
  # a development build recorded the name, not a particular certificate:
  # forget that line, and never delete by it
  if installed_by_us "keychain:$SIGN_NAME"; then forget_install "keychain:$SIGN_NAME"; fi
  have_signing_identity && return 0
  h="$(signing_hash)"
  if [ -n "$h" ]; then forget_install "keychain:sha1:$h"; fi
  tell_signing_prompt
  # an explicit template: macOS's mktemp -d on its own ignores TMPDIR
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/meetingbox-sign.XXXXXX")" || return 1
  # the private key is in $tmp until the import, so do not leave it on a Ctrl-C
  trap 'rm -rf -- "$tmp"; exit 130' INT
  trap 'rm -rf -- "$tmp"; exit 143' TERM
  # || true: head closing the pipe sends tr a SIGPIPE; the length check below
  # is what catches a short or empty password
  pw="$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c 24)" || true
  cat > "$tmp/cnf" <<CNF
[req]
distinguished_name = dn
x509_extensions = ext
prompt = no
[dn]
CN = $SIGN_NAME
[ext]
basicConstraints = critical, CA:false
keyUsage = critical, digitalSignature
extendedKeyUsage = critical, codeSigning
CNF
  if [ "${#pw}" -eq 24 ] \
     && "$OPENSSL" req -x509 -newkey rsa:2048 -nodes -days 3650 -config "$tmp/cnf" \
          -keyout "$tmp/key.pem" -out "$tmp/cert.pem" >/dev/null 2>&1 \
     && h="$("$OPENSSL" x509 -in "$tmp/cert.pem" -noout -fingerprint -sha1 2>/dev/null | sed 's/.*=//; s/://g')" \
     && is_sha1 "$h" \
     && "$OPENSSL" pkcs12 -export -inkey "$tmp/key.pem" -in "$tmp/cert.pem" \
          -name "$SIGN_NAME" -passout "pass:$pw" -out "$tmp/id.p12" >/dev/null 2>&1 \
     && security import "$tmp/id.p12" -k "$SIGN_KEYCHAIN" -P "$pw" -T /usr/bin/codesign >/dev/null 2>&1; then
    made=1
  fi
  rm -rf -- "$tmp"
  trap - INT TERM
  [ "$made" -eq 1 ] || return 1
  record_install "keychain:sha1:$h"
}

# Deletes only certificates recorded by hash. One already gone is forgotten.
remove_signing_identity() {
  local h rc=0
  if installed_by_us "keychain:$SIGN_NAME"; then forget_install "keychain:$SIGN_NAME"; fi
  while IFS= read -r h; do
    [ -n "$h" ] || continue
    if ! is_sha1 "$h"; then forget_install "keychain:sha1:$h"; continue; fi
    if security delete-identity -Z "$h" "$SIGN_KEYCHAIN" >/dev/null 2>&1 || ! identity_listed "$h"; then
      forget_install "keychain:sha1:$h"
    else
      warn "could not delete \"$SIGN_NAME\" ($h) from your login keychain. Delete it in Keychain Access"
      rc=1
    fi
  done <<< "$(sed -n 's/^keychain:sha1://p' "$INSTALLED" 2>/dev/null || true)"
  return "$rc"
}

install_speech_analyzer() {
  local sa build
  say "the transcriber (Apple SpeechAnalyzer)"
  info "the same on device engine behind Notes transcription. Fast, no model to download."
  mkdir -p "$SRC_DIR" "$BIN_DIR"
  sa="$SRC_DIR/speech-analyzer-cli"
  if [ -d "$sa/.git" ]; then
    git -C "$sa" pull -q --ff-only || true
  else
    claim_path "$sa" || return 1
    git clone -q --depth 1 "$SPEECH_ANALYZER_REPO" "$sa" \
      || { warn "could not clone $SPEECH_ANALYZER_REPO"; return 1; }
  fi
  # Built with swiftc, as the recorder is, not with its install script: that runs
  # `swift build`, and on some macOS 27 Command Line Tools SwiftPM cannot link at
  # all ("Invalid manifest"). The core library is its own module, so it goes first.
  build="$(mktemp -d "${TMPDIR:-/tmp}/mb-sa.XXXXXX")" || return 1
  if ! { swiftc -O -suppress-warnings -parse-as-library -module-name SpeechAnalyzerCore \
           -emit-module -emit-module-path "$build/SpeechAnalyzerCore.swiftmodule" \
           -emit-library -static -o "$build/libSpeechAnalyzerCore.a" "$sa"/Sources/SpeechAnalyzerCore/*.swift \
         && swiftc -O -suppress-warnings -parse-as-library -module-name SpeechAnalyzerCLI \
           -I "$build" -L "$build" -lSpeechAnalyzerCore \
           -o "$build/speech-analyzer" "$sa"/Sources/SpeechAnalyzerCLI/*.swift; }; then
    rm -rf -- "$build"
    warn "Apple's transcriber did not build, see the output above"
    return 1
  fi
  if ! { claim_path "$SA_APP" && claim_path "$SA_LINK"; }; then
    rm -rf -- "$build"
    return 1
  fi
  mkdir -p "$SA_APP/Contents/MacOS" "$(dirname "$SA_LINK")"
  cp "$sa/Resources/Info.plist" "$SA_APP/Contents/Info.plist"
  install -m 755 "$build/speech-analyzer" "$SA_APP/Contents/MacOS/speech-analyzer"
  rm -rf -- "$build"
  # An app bundle, so macOS can ask for Speech Recognition by name.
  codesign --force --sign - "$SA_APP" >/dev/null 2>&1 || warn "could not sign $SA_APP"
  ln -sfn "$SA_APP/Contents/MacOS/speech-analyzer" "$SA_LINK"
  have speech-analyzer && ok "speech-analyzer" || { warn "built but not on PATH"; return 1; }
}

install_whisper() {
  say "the transcriber (whisper.cpp)"
  have brew || { warn "needs Homebrew first"; return 1; }
  # whisper-cli needs 16kHz wav, which comes from ffmpeg. Skip brew's cache
  # cleanup, which otherwise deletes unrelated downloads as a side effect.
  pkgs="whisper-cpp"; have ffmpeg || pkgs="$pkgs ffmpeg"
  HOMEBREW_NO_INSTALL_CLEANUP=1 brew install $pkgs || { warn "brew install $pkgs failed"; return 1; }
  mkdir -p "$MODEL_DIR"
  if [ ! -s "$WHISPER_FILE" ]; then
    info "downloading the model, about 1.6GB, this is the slow bit"
    record_install "$WHISPER_FILE"
    curl -fL --progress-bar -o "$WHISPER_FILE.part" "$WHISPER_MODEL_URL" \
      || { warn "model download failed"; rm -f "$WHISPER_FILE.part"; return 1; }
    mv "$WHISPER_FILE.part" "$WHISPER_FILE"
  fi
  ok "whisper-cli + model"
}

accept_fm_license() {
  say "Apple model licence"
  info "one command, machine wide, asks for your Mac password"
  sudo fm license || { warn "licence not accepted"; return 1; }
  ok "fm licence accepted"
}

add_to_path() {
  on_path && return 0
  line="export PATH=\"\$HOME/.local/bin:\$PATH\""
  for rc in "$HOME/.zshrc" "$HOME/.bash_profile"; do
    [ -e "$rc" ] || [ "$rc" = "$HOME/.zshrc" ] || continue
    grep -qF '.local/bin' "$rc" 2>/dev/null || printf '\n# meetingbox\n%s\n' "$line" >> "$rc"
  done
  export PATH="$BIN_DIR:$PATH"
  ok "added $BIN_DIR to your PATH"
}

# One short recording to make macOS throw its permission prompts now, in setup,
# rather than halfway through a real meeting.
# The recorder gives up at once if Screen Recording is missing, so a non-empty
# audio.m4a means both sides are being captured.
PERM_DIR="$STATE_DIR/permcheck"
test_recording() {
  clear_permcheck; mkdir -p "$PERM_DIR"
  p="$(launch_recorder "$PERM_DIR" permcheck "$PERM_DIR/log")" || return 1
  sleep 4
  stop_proc "$p" 60
  [ -s "$PERM_DIR/audio.m4a" ] && { clear_permcheck; return 0; }
  return 1
}

# Only the files the test writes (the recorder's working files among them, and
# the one v1.2.2's test wrote), then the folder if that leaves it empty.
clear_permcheck() {
  rm -f "$PERM_DIR/audio.m4a" "$PERM_DIR/mic.m4a" "$PERM_DIR/call.m4a" "$PERM_DIR/log" \
        "$PERM_DIR/mic.caf" "$PERM_DIR/call.caf" "$PERM_DIR/.recording-complete" \
        "$PERM_DIR/.tmp-audio.m4a" "$PERM_DIR/.tmp-mic.m4a" "$PERM_DIR/.tmp-call.m4a" \
        "$PERM_DIR/.tmp-recording-complete" \
        "$PERM_DIR"/*_permcheck.m4a
  rmdir "$PERM_DIR" 2>/dev/null || true
}

# Speech Recognition for Apple's transcriber, asked for with a short spoken clip
# so macOS prompts now, during setup, not in the middle of the first meeting.
# whisper does not need it, so giving up here never fails setup.
prime_speech() {
  have speech-analyzer || return 0
  local tmp tries=0
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/mb-speech.XXXXXX")" || return 0
  if ! "$SAY_BIN" -o "$tmp/check.aiff" "meetingbox speech check" 2>/dev/null; then
    rm -rf -- "$tmp"; return 0
  fi
  say "Speech Recognition"
  info "macOS will ask to let ${c_b}speech-analyzer${c_0} (Apple's transcriber) use Speech Recognition. Allow it."
  while :; do
    if sa_run "$tmp/check.txt" "$tmp/check.aiff" 2>/dev/null; then ok "Speech Recognition works"; break; fi
    if [ "$tries" -ge 3 ]; then
      warn "Apple's transcriber still cannot run, so meetingbox will use whisper if it is installed"
      info "to try again later: turn on speech-analyzer under Speech Recognition, then run: ${c_b}meetingbox setup${c_0}"
      break
    fi
    tries=$((tries + 1))
    warn "Speech Recognition is not on for speech-analyzer yet"
    rule
    info "1. Opening Privacy settings at ${c_b}Speech Recognition${c_0}"
    info "2. Turn on ${c_b}speech-analyzer${c_0}"
    info "Already on? Turn it off and on again."
    rule
    open_privacy SpeechRecognition
    pause_for "press enter once it is on, and I will test again"
  done
  rm -rf -- "$tmp"
  return 0
}

# macOS asks for these one at a time, in the order the recorder uses them. The
# recorder starts system audio first and stops there if Screen Recording is off,
# so it never reaches the mic, and meetingbox cannot appear in the Microphone list
# until Screen Recording works. So: test, read which one failed, fix that one,
# test again.
prime_permissions() {
  say "permissions"
  info "macOS will ask to let ${c_b}meetingbox${c_0} use Screen Recording (that is how the"
  info "far side is captured), and then the Microphone. Allow both."
  tries=0
  while :; do
    if test_recording; then ok "recording works"; return 0; fi
    [ "$tries" -lt 3 ] || break
    tries=$((tries + 1))
    # No display (the screen asleep or locked) also fails to start system audio, and is no
    # missing permission: the screen just has to be woken.
    if grep -q 'No display found' "$PERM_DIR/log" 2>/dev/null; then
      warn "The screen is asleep or locked, so the call side cannot be recorded. Wake the screen and try again."
      pause_for "press enter once the screen is awake, and I will test again"
      continue
    elif grep -q 'start system audio' "$PERM_DIR/log" 2>/dev/null; then
      warn "Screen Recording is not on for meetingbox yet"
      rule
      info "1. Opening Privacy settings at ${c_b}Screen & System Audio Recording${c_0}"
      info "2. Turn on ${c_b}meetingbox${c_0} in the top list"
      info "   (not the 'System Audio Recording Only' list below it)"
      info "3. Not in the list? Drag the meetingbox app from the Finder window I am"
      info "   opening into that list, then turn it on"
      info "Already on? Turn it off and on again, or select it, remove it with the minus button and test again."
      info "The Microphone comes after this. macOS asks for it on the next test."
      rule
      open_privacy ScreenCapture
      open -R "$APP_DIR" >/dev/null 2>&1 || true
    elif grep -q 'start microphone' "$PERM_DIR/log" 2>/dev/null; then
      warn "the Microphone is not on for meetingbox yet"
      rule
      info "1. Opening Privacy settings at ${c_b}Microphone${c_0}"
      info "2. Turn on ${c_b}meetingbox${c_0}"
      info "Already on? Turn it off and on again, or select it, remove it with the minus button and test again."
      rule
      open_privacy Microphone
    else
      warn "the recorder did not start"
      [ -s "$PERM_DIR/log" ] && sed 's/^/           /' "$PERM_DIR/log" >&2
      break
    fi
    pause_for "press enter once it is on, and I will test again"
  done
  if grep -q 'No display found' "$PERM_DIR/log" 2>/dev/null; then
    warn "still not recording: the screen is asleep or locked"
    info "wake the screen, then run: ${c_b}meetingbox setup${c_0}"
    return 1
  fi
  warn "still not recording"
  info "check Screen & System Audio Recording and Microphone are both on for meetingbox,"
  info "then run: ${c_b}meetingbox setup${c_0}"
  info "to start the permissions over: ${c_b}meetingbox reset${c_0}"
  return 1
}

make_shortcut_hint() {
  rule
  say "want it on a hotkey?"
  info "Shortcuts app, new shortcut, add a ${c_b}Run Shell Script${c_0} action, shell /bin/bash:"
  printf '\n' >&2
  printf '%s\n' "${c_c}             export PATH=\"\$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:\$PATH\"${c_0}" >&2
  printf '%s\n' "${c_c}             meetingbox${c_0}" >&2
  printf '\n' >&2
  info "then set a keyboard shortcut in the details pane and tick Pin in Menu Bar."
  info "First press records, second press writes the minutes."
  rule
}

setup() {
  printf '\n' >&2
  say "setup ${c_dim}v$VERSION${c_0}"
  rule

  refuse_while_busy setup || return 1

  v="$(macos_major)"
  if [ -z "$v" ]; then
    die "this only runs on macOS"
  elif [ "$v" -lt 27 ] 2>/dev/null; then
    miss "macOS $v. The on device model (fm) arrived in macOS 27."
    info "Recording and transcribing will still work, the summary will not."
  else
    ok "macOS $v"
  fi

  # --- survey, before asking for anything ---
  todo=""
  need_xcode_clt      && { miss "Xcode Command Line Tools"; todo="$todo clt"; }     || ok "Xcode Command Line Tools"
  need_recorder       && { miss "the recorder";             todo="$todo capture"; } || ok "the recorder"
  need_speech         && { miss "Parakeet (more accurate transcripts and speaker labels, about 630 MB)"
                           todo="$todo parakeet"; } || ok "Parakeet"
  transcriber_present && ok "a transcriber" || { miss "a transcriber"; todo="$todo transcriber"; }
  # whisper alone works, but Apple's is faster and needs no model; offer it beside it
  if transcriber_present && ! have speech-analyzer && [ "${v:-0}" -ge 26 ] 2>/dev/null; then
    miss "Apple's transcriber (faster than whisper, which is used until then)"; todo="$todo native"
  fi
  # a build signs the app, so this matters for an app that is already built
  have_signing_identity && app_signed_by_us && ok "signing certificate" \
    || { miss "a signing certificate"; todo="$todo sign"; }
  if have fm; then
    if need_fm_license; then miss "Apple model licence not accepted"; todo="$todo license"
    else ok "fm, licence accepted"; fi
  else
    miss "fm not found (ships with macOS 27)"
  fi
  on_path || { miss "$BIN_DIR is not on your PATH"; todo="$todo path"; }

  rule
  if [ -z "$todo" ]; then
    say "everything is already in place"
    remove_old_app
    prime_permissions || return 1
    prime_speech
    install -m 755 "$0" "$BIN_DIR/meetingbox" 2>/dev/null || true
    make_shortcut_hint
    say "ready. Run ${c_b}meetingbox${c_0} to start a recording."
    open_app
    return 0
  fi

  n="$(printf '%s' "$todo" | wc -w | tr -d ' ')"
  if [ "$n" = 1 ]; then say "one thing to install. I can do it from here."
  else say "$n things to install. I can do all of them from here."; fi
  info "some steps may ask for your Mac password, and Apple may open an installer window."
  confirm "go ahead?" || { info "nothing changed. Run 'meetingbox setup' when you are ready."; return 1; }
  rule

  case " $todo " in *" path "*) add_to_path ;; esac
  case " $todo " in *" clt "*)  install_xcode_clt || return 1 ;; esac

  case " $todo " in
    *" capture "*) install_recorder || return 1 ;;
    *" sign "*)    resign_app || return 1 ;;
  esac
  # Optional: Apple's transcriber is used without it, so a failure never stops setup.
  case " $todo " in *" parakeet "*) install_speech || true ;; esac

  case " $todo " in
    *" transcriber "*)
      if [ "${v:-0}" -ge 26 ] 2>/dev/null && confirm "use Apple's built in transcriber? (fast, no 1.6GB download)"; then
        install_speech_analyzer || {
          warn "the Apple transcriber did not build"
          # The fallback is Homebrew plus a 1.6GB model, a different thing to what
          # was agreed, so ask again rather than carry on.
          confirm "use whisper.cpp instead? (Homebrew, about 1.6GB download)" || return 1
          if need_brew; then install_brew || return 1; fi
          install_whisper || return 1
        }
      else
        need_brew && { confirm "whisper.cpp needs Homebrew, install it?" && install_brew || return 1; }
        install_whisper || return 1
      fi ;;
  esac

  case " $todo " in *" native "*) install_speech_analyzer || info "carrying on with whisper" ;; esac
  case " $todo " in *" license "*) accept_fm_license || true ;; esac

  remove_old_app
  rule
  install -m 755 "$0" "$BIN_DIR/meetingbox" 2>/dev/null \
    && ok "meetingbox -> $BIN_DIR/meetingbox" || true

  prime_permissions || return 1
  prime_speech
  make_shortcut_hint
  say "ready. Run ${c_b}meetingbox${c_0} to start a recording."
  open_app
}

# The voice print, read from VOICE_FILE with jq: "<whole seconds> <meetings> learnt|sample", or "none"
# when there is no print or it cannot be read. `engines` prints it as its voice line.
voice_line() {
  local line
  line="$(jq -r -s 'if length == 1 and (.[0] | type) == "object" then .[0] else empty end
    | select((.seconds | type) == "number" and .seconds >= 0 and (.meetings | type) == "number" and .meetings >= 1)
    | "\(.seconds | floor) \(.meetings | floor) \(if .sample == true then "sample" else "learnt" end)"' \
    "$VOICE_FILE" 2>/dev/null)" || line=""
  printf '%s' "${line:-none}"
}

# The voice print in Preferences' words (spec 6.2): whole minutes of speech, with singulars.
voice_words() {
  local seconds meetings kind minutes calls
  read -r seconds meetings kind <<< "$(voice_line)"
  if [ "$seconds" = none ]; then
    printf '%s' "Not learnt yet: meetingbox learns it from your video calls, or record a sample"
    return
  fi
  # to the nearest minute, a half up, as Preferences rounds them
  minutes=$(((seconds + 30) / 60)); [ "$minutes" = 1 ] && minutes="1 minute" || minutes="$minutes minutes"
  if [ "$kind" = sample ]; then calls=$((meetings - 1)); else calls="$meetings"; fi
  [ "$calls" = 1 ] && calls="1 call" || calls="$calls calls"
  if [ "$kind" = learnt ]; then printf 'Your voice: learnt from %s (%s of speech)' "$calls" "$minutes"
  elif [ "$meetings" -le 1 ]; then printf 'Your voice: from a recorded sample (%s of speech)' "$minutes"
  else printf 'Your voice: from a recorded sample and %s (%s of speech)' "$calls" "$minutes"
  fi
}

# ------------------------------------------------- the app's engine commands
#
# What the app runs through its engine commands (EngineCommands in the app): `engines`, `voice add` and
# `voice forget`. The app reads only stdout, so each answers there; each starts with umask 077, as
# process does.

voice_says() { printf '%s\n' "$1"; }

# Which transcribers can be used, and the voice print, one line each: `parakeet ready` or `parakeet
# unavailable <reason>`, `apple ready` or `apple unavailable <reason>`, and `voice none` or `voice
# <seconds> <meetings> learnt|sample`. Nothing reaches the network.
engines_cmd() {
  local reason=""
  umask 077
  if speech_usable; then
    echo "parakeet ready"
  elif [ ! -x "$SPEECH_BIN" ]; then
    echo "parakeet unavailable the speech helper is not installed"
  else
    reason="$("$SPEECH_BIN" check "$SPEECH_MODELS" 2>&1 >/dev/null | head -n 1 | tr -d '[:cntrl:]')" || true
    reason="${reason#mb-speech: }"
    echo "parakeet unavailable ${reason:-its models did not pass their check}"
  fi
  if have speech-analyzer; then echo "apple ready"; else echo "apple unavailable speech-analyzer is not installed"; fi
  printf 'voice %s\n' "$(voice_line)"
}

# `voice add <audio>` (spec 6.2, "Record a voice sample…"): the speakers in the app's sample.caf, found
# without a count, become the voice print, replacing any. The WAV and the speakers file (it holds voice
# vectors) live only in a private temporary folder, removed before it answers. The answer is one line:
# mb-transcript's `sample <seconds>`, or why the sample was refused; the status is mb-transcript's.
voice_add() {
  local audio="$1" base tmp speakers line rc=0
  umask 077
  if ! speech_usable; then voice_says "Parakeet is not set up, so a voice sample cannot be used. Run meetingbox setup."; return 1; fi
  if ! installed_by_us "$VOICE_FILE"; then voice_says "$VOICE_FILE was not made by meetingbox, so a voice sample is not saved there."; return 1; fi
  if [ ! -x "$TRANSCRIPT_BIN" ]; then voice_says "mb-transcript is not installed. Run meetingbox setup."; return 1; fi
  if [ ! -f "$audio" ]; then voice_says "There is no sample at $audio."; return 1; fi
  # an explicit template: macOS's mktemp -d on its own ignores TMPDIR
  base="${TMPDIR:-/tmp}"
  tmp="$(mktemp -d "${base%/}/meetingbox-voice.XXXXXX")" \
    || { voice_says "The voice sample could not be used: no temporary folder could be made."; return 1; }
  trap 'rm -rf -- "$tmp"; exit 129' HUP
  trap 'rm -rf -- "$tmp"; exit 130' INT
  trap 'rm -rf -- "$tmp"; exit 143' TERM
  # afconvert into the folder, then mb-speech there with TMPDIR that folder, and no count
  speakers="$tmp/sample.speakers.json"
  speech_run "$tmp" "$audio" speakers "$speakers" || rc=$?
  case "$rc" in
    0)
      "$TRANSCRIPT_BIN" --voice-sample "$speakers" --voice "$VOICE_FILE" > "$tmp/answer" 2> "$tmp/reason" || rc=$?
      if [ "$rc" -eq 0 ]; then line="$(grep -m 1 . "$tmp/answer")" || line=""
      else line="$(grep -m 1 . "$tmp/reason")" || line=""; line="${line#mb-transcript: }"; fi
      [ -n "$line" ] || line="mb-transcript stopped without giving a reason (exit $rc)" ;;
    2) line="The recorded sample could not be read."; rc=1 ;;
    *) line="Your voice could not be found in the sample: $SPEECH_REASON"; rc=1 ;;
  esac
  rm -rf -- "$tmp"
  trap - HUP INT TERM
  voice_says "$line"
  return "$rc"
}

# `voice forget` ("Forget my voice"): removes the voice print and its voice.json.tmp under the voice
# print's lock, the one mb-transcript takes to save, so a save in progress finishes first, and a learn
# that read the print before finds it gone and writes nothing. The record line stays, so the voice can
# be learnt again. A lock still held after VOICE_LOCK_WAIT seconds is refused, forgetting nothing.
voice_forget() {
  local rc=0
  umask 077
  if ! installed_by_us "$VOICE_FILE"; then voice_says "$VOICE_FILE was not made by meetingbox, so it is left alone."; return 1; fi
  # lockf would follow a link there: the lock is only ever a plain file
  if [ -L "$VOICE_LOCK" ] || { [ -e "$VOICE_LOCK" ] && [ ! -f "$VOICE_LOCK" ]; }; then
    voice_says "$VOICE_LOCK is not a plain file, so your voice was not forgotten."
    return 1
  fi
  /usr/bin/lockf -s -k -t "$VOICE_LOCK_WAIT" "$VOICE_LOCK" rm -f -- "$VOICE_FILE" "$VOICE_FILE.tmp" || rc=$?
  case "$rc" in
    0)  ok "your voice print is forgotten"; return 0 ;;
    75) voice_says "Your voice print is being saved right now, so it was not forgotten. Try again." ;;
    *)  voice_says "Your voice could not be forgotten (exit $rc)." ;;
  esac
  return 1
}

# The meeting folders, by name, one a line, holding a stage or a work folder that a stopped run left:
# they hold copies, new files and, in a work folder, voice vectors. The next run in each removes them.
leftover_staging() {
  local root d f
  for root in "$BASE_DIR" "$(app_meetings_folder)"; do
    [ -n "$root" ] && [ -d "$root" ] || continue
    for d in "$root"/*/; do
      for f in "$d".stage.?????? "$d".work.??????; do
        if [ -d "$f" ] && [ ! -L "$f" ]; then (cd "$d" && pwd -P); break; fi
      done
    done
  done | LC_ALL=C sort -u | sed 's|.*/||'
}

doctor() {
  say "check"
  v="$(macos_major)"; [ -n "$v" ] && ok "macOS $v" || miss "not macOS"
  recorder_ready      && ok "recorder (meetingbox.app)" || miss "recorder (meetingbox.app)"
  [ -x "$TRANSCRIPT_BIN" ] && ok "mb-transcript (labels the speakers)" || miss "mb-transcript (labels the speakers)"
  if speech_ready; then ok "Parakeet (mb-speech)"
  elif speech_usable; then miss "Parakeet is out of date. Run: meetingbox setup"   # still used meanwhile
  elif [ -x "$SPEECH_BIN" ]; then miss "Parakeet is not ready, so Apple's transcriber is used. Run: meetingbox setup"
  else info "Parakeet is not set up, so Apple's transcriber is used"; fi
  if [ -x "$SPEECH_BIN" ]; then
    r="$("$SPEECH_BIN" check "$SPEECH_MODELS" 2>&1)" && ok "speech models in $SPEECH_MODELS" || miss "speech models: ${r#mb-speech: }"
    c="$(speech_cache)" && ok "model cache $c" \
      || miss "model cache: the helper names no folder meetingbox can record, so none is recorded"
  fi
  case "$(voice_line)" in
    none) info "$(voice_words)" ;;
    *)    ok "$(voice_words)" ;;
  esac
  if { [ -e "$VOICE_FILE" ] || [ -L "$VOICE_FILE" ]; } && ! installed_by_us "$VOICE_FILE"; then
    miss "$VOICE_FILE was not made by meetingbox, so your voice is not learnt into it"
  fi
  if ! have_signing_identity; then
    miss "signing certificate (permissions will be asked again after updates)"
  elif [ -d "$APP_DIR" ] && ! app_signed_by_us; then
    miss "meetingbox.app is signed ad hoc, so permissions will be asked again after updates. Run: meetingbox setup"
  else
    ok "signing certificate"
  fi
  have speech-analyzer && ok "speech-analyzer" || info "speech-analyzer not installed"
  have whisper-cli    && ok "whisper-cli"     || info "whisper-cli not installed"
  transcriber_present || miss "no transcriber at all"
  if have fm; then
    need_fm_license && miss "fm licence not accepted (sudo fm license)" || ok "fm"
  else miss "fm"; fi
  on_path && ok "$BIN_DIR on PATH" || miss "$BIN_DIR not on PATH"
  left="$(leftover_staging)"
  if [ -z "$left" ]; then
    ok "no staging left by a stopped run in the meeting folders"
  else
    miss "staging left by a stopped run in: $(printf '%s\n' "$left" | paste -sd ',' - | sed 's/,/, /g'). The next run on that meeting removes it"
  fi
  if recorder_ready; then
    info "microphones the recorder can see:"
    "$APP_BIN" --record -l 2>&1 | sed 's/^/             /' >&2 || true
  fi
  info "if anything is missing: meetingbox setup"
}

# ------------------------------------------------------------------- recording
#
# The app owns recording: it starts the recorder, signals it, finalises the audio,
# queues the meeting and keeps the state files. This command is its client. Each
# command is one request line over a private socket and one reply line back:
# `ok <state> <folder or ->` or `error <message>`. The state files are read here only
# when the app is not running, so `status` still tells the truth after a crash.

# The recorder is found by the folder it writes to, not by a saved PID, so a
# PID reused after a crash or reboot can never be mistaken for it.
session_dir()  { cat "$DIR_FILE" 2>/dev/null || true; }
is_recording() { d="$(session_dir)"; [ -n "$d" ] && [ -n "$(recorder_pids "$d")" ]; }

# The app keeps recording.dir while a recording is going or still being finished.
has_session() { [ -f "$DIR_FILE" ]; }

PAUSE_FILE="$STATE_DIR/paused"
# meetingbox 1.3 and earlier serialised start and stop with this lock; reset still
# clears one left behind.
LOCK="$STATE_DIR/busy"
release_lock() { rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null || true; }

CONTROL_SOCK="$STATE_DIR/control.sock"
APP_WAIT=10   # seconds to wait for an app that was not running

# Percent-encodes every byte except unreserved characters and /, so a request stays
# one line of plain words whatever a microphone name or folder holds.
pct_encode() {
  local out="" h
  for h in $(printf '%s' "$1" | od -An -v -tx1); do
    case "$h" in
      2d|2e|2f|3[0-9]|4[1-9a-f]|5[0-9a]|5f|6[1-9a-f]|7[0-9a]|7e) out="$out$(printf "\\x$h")" ;;
      *) out="$out%$(printf '%s' "$h" | tr 'a-f' 'A-F')" ;;
    esac
  done
  printf '%s' "$out"
}

# One request, the first line of the reply, waiting up to $2 seconds (30 by default).
# Fails when nothing is listening (no socket, or one left by an app that has gone);
# a connection that is closed with no reply gives an empty line.
app_send() {
  local reply
  reply="$(nc -U -w "${2:-30}" "$CONTROL_SOCK" <<< "$1" 2>/dev/null)" || return 1
  printf '%s' "${reply%%
*}"
}

# An app from meetingbox 1.3 or earlier is only a recorder: opened with no arguments
# it starts recording on its own, with nothing to answer. An app built for this
# command names the script in its Info.plist (MBScriptPath); only that one is opened.
app_is_client_aware() {
  [ -n "$(/usr/libexec/PlistBuddy -c 'Print :MBScriptPath' "$APP_DIR/Contents/Info.plist" 2>/dev/null || true)" ]
}

# A running meetingbox holds app.lock for its whole life. lockf opens it only to read
# (-n: never creates it, -k: never removes it) and, when it is free, holds it for no
# longer than it takes to run true.
app_lock_held() {
  local rc=0
  [ -e "$STATE_DIR/app.lock" ] || return 1
  lockf -n -k -s -t 0 "$STATE_DIR/app.lock" true >/dev/null 2>&1 || rc=$?
  [ "$rc" -eq 75 ]
}
NOT_ANSWERING="meetingbox is running but not answering. Quit it and open it again."
# Installed, not holding its lock, and still not answering after the wait: it was quitting, or
# is still starting. setup would not help, so it is not offered.
STARTING_OR_QUITTING="meetingbox is starting or quitting. Try again in a moment."

# Sends a request to the app, opening it in the background if it is not running and
# trying again for up to $APP_WAIT seconds. Only a failed connection is retried: a
# request that got through is never sent twice. An `error` reply ends the command
# with its text; an `ok` reply leaves "<state> <folder>" in APP_REPLY.
APP_REPLY=""
app_request() {
  local reply="" i=0 why=""
  if ! reply="$(app_send "$1")"; then
    [ -d "$APP_DIR" ] || die "meetingbox is not installed. Run: meetingbox setup"
    app_is_client_aware || die "the installed meetingbox app is older than this command. Run: meetingbox setup"
    # Running but not listening yet (starting or quitting) or not at all: opening it again
    # changes nothing, so only wait. NOT_ANSWERING is said when the wait runs out. An app that
    # cannot be opened at all (a damaged bundle) is said at once, in open's words (less a closing
    # full stop, inside the brackets): setup puts it back.
    if ! app_lock_held && ! why="$(open -g "$APP_DIR" 2>&1)"; then
      die "meetingbox could not be opened (${why%.}). Run: meetingbox setup"
    fi
    while :; do
      if [ "$i" -ge $((APP_WAIT * 2)) ]; then
        if app_lock_held; then die "$NOT_ANSWERING"; fi
        die "$STARTING_OR_QUITTING"
      fi
      sleep 0.5; i=$((i + 1))
      if reply="$(app_send "$1")"; then break; fi
    done
  fi
  case "$reply" in
    "ok "*)    APP_REPLY="${reply#ok }" ;;
    "error "*) die "${reply#error }" ;;
    "")        die "meetingbox did not answer. Try again in a moment" ;;
    *)         die "meetingbox gave an answer this command does not understand: $reply" ;;
  esac
}

# What an ok reply means, said the way status always has.
say_state() {
  local state="${APP_REPLY%% *}" folder="${APP_REPLY#* }"
  case "$state" in
    idle)              info "idle" ;;
    recording|paused)  ok "$state -> $folder" ;;
    finalising)        ok "stopped -> $folder"
                       info "the minutes will open in the meetingbox window when they are ready" ;;
    *)                 info "$APP_REPLY" ;;
  esac
}

# --mic and --dir (or MB_MIC and MB_DIR) travel inside the request when given;
# otherwise the app's own settings apply. A folder is sent as a full path.
recording_options() {
  local opts="" d="$DIR_ARG"
  if [ -n "$MIC" ]; then opts=" mic=$(pct_encode "$MIC")"; fi
  if [ -n "$d" ]; then
    case "$d" in
      /*) ;;
      "~")  d="$HOME" ;;
      "~/"*) d="$HOME/${d#\~/}" ;;
      *)    d="$PWD/$d" ;;
    esac
    opts="$opts dir=$(pct_encode "$d")"
  fi
  printf '%s' "$opts"
}

start_recording() {
  recorder_ready || die "the recorder is not installed yet. Run: meetingbox setup"
  app_request "start$(recording_options)"
  say_state
}

stop_recording() {
  app_request stop
  say_state
}

# Start, or stop the recording that is going.
toggle_recording() {
  app_request "toggle$(recording_options)"
  say_state
}

pause_recording() {
  # A recorder from meetingbox 1.2 writes <stamp>_meeting.m4a and has no pause:
  # SIGUSR1 would kill it and leave the audio unplayable. Refused before the app is asked.
  local d f
  d="$(session_dir)"
  if [ -n "$d" ]; then
    for f in "$d"/*_meeting.m4a; do
      if [ -e "$f" ]; then
        die "this recording was started by an older meetingbox and cannot pause. It is still recording; 'meetingbox stop' finishes it"
      fi
    done
  fi
  app_request pause
  say_state
}

resume_recording() {
  app_request resume
  say_state
}

# Asks the app, but never opens it. With no app answering (not running, crashed or
# force quit) it reads the state files the app left and looks for the recorder
# itself, which carries on recording without the app.
status_cmd() {
  local reply d
  if reply="$(app_send status 5)"; then
    case "$reply" in
      "ok "*)    APP_REPLY="${reply#ok }"; say_state; return 0 ;;
      "error "*) die "${reply#error }" ;;
    esac
    # Connected, but no answer within 5 s: the app may be running, so it is not called gone.
    info "meetingbox did not answer; from the recording files:"
  else
    info "meetingbox is not running, so this is from the recording files"
  fi
  d="$(session_dir)"
  if is_recording; then
    if [ -e "$PAUSE_FILE" ]; then ok "paused -> $d"; else ok "recording -> $d"; fi
  else
    info "idle"
    if [ -n "$d" ]; then info "the recording in $d did not finish; open meetingbox to recover it"; fi
  fi
}

# The recorder writes mic.caf and call.caf while recording, and on stop turns them
# into the three .m4a, then writes .recording-complete, then removes them. Working
# files without the marker mean it was killed or crashed before it finished.
recording_unfinished() {
  [ ! -e "$1/.recording-complete" ] && { [ -e "$1/mic.caf" ] || [ -e "$1/call.caf" ]; }
}

# Finishes such a recording from its working files, with the recorder's own
# --recover (the same finalising it runs at stop). Says why if it cannot.
recover_dir() {
  if rec_out="$("$APP_BIN" --recover "$1" 2>&1)"; then return 0; fi
  [ -n "$rec_out" ] && printf '%s\n' "$rec_out" | sed 's/^/           /' >&2
  return 1
}

recover_cmd() {
  [ -d "$1" ] || die "no such folder: $1"
  rdir="$(cd "$1" && pwd)"
  [ -z "$(recorder_pids "$rdir")" ] || die "$rdir is still recording. To finish it: meetingbox stop"
  [ -x "$APP_BIN" ] || die "the recorder is not installed. Run: meetingbox setup"
  recover_dir "$rdir" || die "could not recover $rdir. Its recording files are kept"
  ok "recovered $rdir"
  info "to get its minutes, open meetingbox and choose Process on it (or run: meetingbox process $rdir)"
}


# ----------------------------------------------------------------- transcribing

# The transcriber a run starts with: a flag, else MB_ENGINE, else the app's choice, else Parakeet.
# Parakeet only when it is set up and the meeting is in English; otherwise Apple's, and the log
# says why. A chosen transcriber that is not installed gives way to the other, also said; with
# none installed, the run stops. Prints parakeet, native or whisper.
pick_engine() {
  local choice="$ENGINE"
  if [ "$choice" = auto ]; then
    case "$(defaults read com.jediconcepts.meetingbox transcriber 2>/dev/null || true)" in
      apple) choice=native ;;
      *)     choice=parakeet ;;
    esac
  fi
  case "$choice" in
    parakeet)
      case "$LOCALE" in
        en|en[-_]*) ;;
        *) info "Parakeet is used for English meetings only, and this one is set to $LOCALE, so Apple's transcriber is used"
           choice=native ;;
      esac ;;
    native|whisper) ;;
    *) die "unknown engine: $choice" ;;
  esac
  if [ "$choice" = parakeet ] && ! speech_usable; then
    warn "Parakeet is not set up, so Apple's transcriber is used. Run meetingbox setup."
    choice=native
  fi
  if [ "$choice" = native ] && ! have speech-analyzer; then
    have whisper-cli || die "no transcriber installed. Run: meetingbox setup"
    warn "Apple's transcriber is not installed, so whisper is used. Run meetingbox setup."
    choice=whisper
  elif [ "$choice" = whisper ] && ! have whisper-cli; then
    have speech-analyzer || die "no transcriber installed. Run: meetingbox setup"
    warn "whisper is not installed, so Apple's transcriber is used. Run meetingbox setup."
    choice=native
  fi
  printf '%s' "$choice"
}

# Whether transcript lines are tidied (spec 6.3): a flag, else the app's choice, else yes. Off,
# mb-transcript gets --plain: a line per turn, every word kept.
tidy_lines() {
  case "$TIDY" in
    1) return 0 ;;
    0) return 1 ;;
  esac
  case "$(defaults read com.jediconcepts.meetingbox tidyLines 2>/dev/null || true)" in
    0|[Nn][Oo]|[Ff][Aa][Ll][Ss][Ee]) return 1 ;;
    *) return 0 ;;
  esac
}

# The transcribers tried on each side, in order: the chosen one, then Apple's, then whisper.
engine_chain() {
  case "$1" in
    parakeet) echo "parakeet native whisper" ;;
    native)   echo "native whisper" ;;
    whisper)  echo "whisper native" ;;
  esac
}
engine_name()  { case "$1" in parakeet) echo "Parakeet" ;; native) echo "Apple's transcriber" ;; *) echo "whisper" ;; esac; }
engine_title() { case "$1" in parakeet) echo "NVIDIA Parakeet" ;; native) echo "Apple SpeechAnalyzer" ;; *) echo "whisper.cpp" ;; esac; }

# The run's private work folder, made inside OUT (a run's stage), for WAVs, speakers files and the
# speech helper's own temporary files. drop_work removes it, and so does the stage's removal whatever
# happens.
make_work() {
  [ -n "$WORK" ] && [ -d "$WORK" ] && return 0
  WORK="$(mktemp -d "${1:?}/.work.XXXXXX")" || die "could not make a working folder in $1"
}
drop_work() { local w="$WORK"; WORK=""; remove_own_folder "$w" || true; }

# Removes a folder meetingbox made with mktemp -d: a stage or a work folder, whose last part is
# .stage. or .work. and six characters, and which is a real folder, not a link. Anything else is left
# alone. A removal that fails is a warning, never the end of a run: the next run in that meeting
# folder removes it under the lock.
remove_own_folder() {
  local path="$1"
  [ -n "$path" ] || return 0
  case "${path##*/}" in
    .stage.??????|.work.??????) ;;
    *) warn "$path is not a staging or work folder, so it is left alone"; return 1 ;;
  esac
  [ -d "$path" ] && [ ! -L "$path" ] || return 0
  rm -rf -- "$path" || { warn "could not remove $path; the next run in that folder removes it"; return 1; }
}

find_whisper_model() {
  [ -n "$WHISPER_MODEL" ] && { printf '%s' "$WHISPER_MODEL"; return; }
  for c in \
    "$MODEL_DIR/ggml-large-v3-turbo.bin" \
    "$HOME/Models/ggml-large-v3-turbo.bin" \
    "$HOME/.whisper-models/ggml-large-v3-turbo.bin"
  do
    [ -f "$c" ] && { printf '%s' "$c"; return; }
  done
  printf ''
}

# A v1.2 meeting's one mixed file to plain text: Parakeet's words joined, else Apple's, else whisper.
transcribe() {
  local audio="$1" out="$2" engine text model wav
  engine="$(pick_engine)" || exit 1   # pick_engine has said why
  if [ "$engine" = parakeet ]; then
    say "transcribing on device (NVIDIA Parakeet)"
    make_work "$(dirname "$out")"
    if pk_run "$audio" "$WORK/words.json" \
       && text="$(jq -r '[.words[].text] | join(" ")' "$WORK/words.json" 2>/dev/null)" && [ -n "$text" ]; then
      printf '%s\n' "$text" > "$out"
      drop_work
      ok "transcript: $(wc -w < "$out" | tr -d ' ') words"
      return 0
    fi
    drop_work
    if have speech-analyzer; then engine=native
    elif have whisper-cli; then engine=whisper
    else die "Parakeet could not transcribe $(basename "$audio"), and no other transcriber is installed. Run: meetingbox setup"
    fi
    warn "Parakeet could not transcribe $(basename "$audio"), trying $(engine_name "$engine")"
  fi

  case "$engine" in
    native)
      say "transcribing on device (Apple SpeechAnalyzer)"
      if ! sa_run "$out" "$audio"; then
        have whisper-cli || die "transcription failed. Check Speech Recognition in Privacy settings, or run: meetingbox setup"
        warn "Apple's transcriber failed, trying whisper. To use Apple's again, check Speech Recognition is on for speech-analyzer"
        ENGINE=whisper
        transcribe "$audio" "$out"
        return
      fi
      ;;
    whisper)
      model="$(find_whisper_model)"
      [ -n "$model" ] || die "no whisper model found. Run: meetingbox setup"
      have ffmpeg || die "whisper.cpp needs ffmpeg for the 16kHz conversion. brew install ffmpeg"
      make_work "$(dirname "$out")"
      wav="$WORK/$(basename "${audio%.*}").16k.wav"
      say "transcribing on device (whisper.cpp, $(basename "$model"))"
      ffmpeg -hide_banner -loglevel error -y -i "$audio" -ar 16000 -ac 1 -c:a pcm_s16le "$wav"
      whisper-cli -m "$model" -f "$wav" --no-timestamps \
        --output-txt --output-file "${out%.txt}" >/dev/null || { drop_work; die "whisper-cli failed"; }
      drop_work
      ;;
  esac

  [ -s "$out" ] || die "the transcript came out empty. Was there any sound?"
  ok "transcript: $(wc -w < "$out" | tr -d ' ') words"
}

# Apple's transcriber, started as its own app through `open` (as the recorder is),
# so macOS asks for Speech Recognition in its name. Run as a child of this shell,
# the request belongs to whatever started meetingbox, and one from a Shortcuts
# hotkey is refused without a prompt. A speech-analyzer meetingbox did not build
# has no app of ours, so it is run directly.
# Usage: sa_run OUT AUDIO [speech-analyzer options]
sa_run() {
  local out="$1" audio="$2" err; shift 2
  case "$out" in /*) ;; *) out="$PWD/$out" ;; esac
  case "$audio" in /*) ;; *) audio="$PWD/$audio" ;; esac
  if [ ! -d "$SA_APP" ]; then
    speech-analyzer --locale "$LOCALE" "$@" "$audio" > "$out"
    return
  fi
  err="$(mktemp)" || return 1
  rm -f "$out"
  open -W -n -g --stdout /dev/null --stderr "$err" "$SA_APP" \
    --args --locale "$LOCALE" "$@" -o "$out" "$audio" >/dev/null 2>&1 || true
  # open -W cannot always latch on (it says "Unable to block" when the app
  # finished first), so also wait until no transcriber is writing this file.
  # Matched through awk and the environment, so the search never finds itself.
  while ps -axo command= | NEEDLE="-o $out $audio" awk 'index($0, ENVIRON["NEEDLE"]) { f = 1 } END { exit !f }'; do
    sleep 0.2
  done
  # The transcriber is its own app and does not inherit our umask: make its output
  # private, whether or not it worked.
  [ ! -e "$out" ] || chmod 600 "$out"
  if [ -e "$out" ] && ! grep -q '^Error' "$err"; then rm -f "$err"; return 0; fi
  grep '^Error' "$err" >&2 || true   # its usage text after the error is noise here
  rm -f "$err"
  return 1
}

# The speech helper on one side, for Parakeet and for speakers alike: AUDIO made the 16 kHz mono WAV
# mb-speech reads, in the run's work folder WORK, then `mb-speech COMMAND <models> <wav> OUT [ARGS]`
# run with its own temporary files in WORK too. The WAV and the helper's error file are removed
# either way. Returns 0 when the helper succeeded, 2 when the audio could not be read, and 1 when the
# helper failed, with SPEECH_REASON set to its one line without the "mb-speech: " prefix, or, when it
# gave none, to a fixed line naming its exit status. WORK may be relative to the meeting folder a run
# is in; the helper's TMPDIR is always a full path.
# Usage: speech_run WORK AUDIO COMMAND OUT [ARGS...]
speech_run() {
  local work="$1" audio="$2" command="$3" out="$4" wav tmpdir rc=0
  shift 4
  wav="$work/$(basename "${audio%.*}").wav"
  case "$work" in /*) tmpdir="$work" ;; *) tmpdir="$PWD/$work" ;; esac
  SPEECH_REASON=""
  afconvert -f WAVE -d LEI16@16000 -c 1 "$audio" "$wav" >/dev/null 2>&1 || { rm -f "$wav"; return 2; }
  TMPDIR="$tmpdir" "$SPEECH_BIN" "$command" "$SPEECH_MODELS" "$wav" "$out" "$@" >/dev/null 2>"$wav.err" || rc=$?
  if [ "$rc" -ne 0 ]; then
    SPEECH_REASON="$(head -n 1 "$wav.err")"; SPEECH_REASON="${SPEECH_REASON#mb-speech: }"
    SPEECH_REASON="${SPEECH_REASON:-the speech helper stopped without giving a reason (exit $rc)}"
  fi
  rm -f "$wav" "$wav.err"
  [ "$rc" -eq 0 ] || return 1
}

# Parakeet on one side: speech_run writes the words JSON. Its one-line reason for a failure goes to
# the log.
pk_run() {
  local audio="$1" out="$2" rc=0
  [ -n "$WORK" ] && [ -d "$WORK" ] || { info "Parakeet has no work folder for $(basename "$audio")"; return 1; }
  speech_run "$WORK" "$audio" transcribe "$out" || rc=$?
  case "$rc" in
    0) return 0 ;;
    2) info "Parakeet could not read $(basename "$audio")" ;;
    *) info "Parakeet: $SPEECH_REASON" ;;
  esac
  return 1
}

# whisper.cpp on one side, its WAV in the work folder.
whisper_words() {
  local audio="$1" out="$2" model wav rc=0
  model="$(find_whisper_model)"
  [ -n "$model" ] || { info "no whisper model found. Run: meetingbox setup"; return 1; }
  have ffmpeg || { info "whisper.cpp needs ffmpeg for the 16kHz conversion. brew install ffmpeg"; return 1; }
  [ -n "$WORK" ] && [ -d "$WORK" ] || { info "whisper has no work folder for $(basename "$audio")"; return 1; }
  wav="$WORK/$(basename "${audio%.*}").16k.wav"
  if ! { ffmpeg -hide_banner -loglevel error -y -i "$audio" -ar 16000 -ac 1 -c:a pcm_s16le "$wav" \
         && whisper-cli -m "$model" -f "$wav" -oj -ml 1 -sow --output-file "${out%.json}" >/dev/null; }; then
    rc=1
  fi
  rm -f "$wav"
  return "$rc"
}

# mb-transcript's loadWords filter, in jq: kept_words is the entries it keeps from a words file in any
# transcriber's shape (Apple's or Parakeet's "words", whisper's "transcription"). It keeps an entry
# with numeric times whose text, trimmed, is neither empty nor in brackets, like [BLANK_AUDIO].
KEPT_WORDS_JQ='
  def num: type == "number";
  def kept: (.text | type) == "string"
    and (.text | gsub("\\A\\s+|\\s+\\z"; "") | . != "" and ((startswith("[") and endswith("]") and length > 1) | not));
  def entries(list): list | if type == "array" then .[] | objects else empty end;
  def kept_words: [entries(.words) | select((.start | num) and (.end | num) and kept)]
    + [entries(.transcription) | select((.offsets | type) == "object" and (.offsets.from | num)
                                        and (.offsets.to | num) and kept)];'

# True when a side's transcription worked but heard no words: nothing in it that loadWords keeps. A
# file of only white space has no words. A side every transcriber failed on says "engine": "none" and
# is not this, and nor is a file that cannot be read.
heard_nothing() {
  jq -e -s "$KEPT_WORDS_JQ"'
    if length == 0 then true
    elif length > 1 or (.[0] | type) != "object" then false
    else .[0] | (.engine // "") != "none" and (kept_words | length) == 0
    end' "$1" >/dev/null 2>&1
}

# True when a words file holds at least one word that loadWords keeps.
has_words() {
  jq -e -s "$KEPT_WORDS_JQ"'
    length == 1 and (.[0] | type) == "object" and (.[0] | kept_words | length) > 0' "$1" >/dev/null 2>&1
}

# The speakers on one side (spec 6.2): speech_run writes WORK/SIDE.speakers.json from the side's
# audio in SRC, and nothing is written anywhere else. COUNT is the people on that side: 2 to 6 asks
# for that many, 1 means no labels there so nothing runs, and anything else works it out. A failure
# is a warning, with the helper's reason, and leaves no file behind: that side keeps its plain label.
# Usage: find_speakers SRC WORK SIDE COUNT
find_speakers() {
  local src="$1" work="$2" side="$3" count="$4" out rc=0
  case "$count" in
    1) return 0 ;;
    [2-6]) ;;
    *) count="" ;;
  esac
  [ -n "$work" ] && [ -d "$work" ] || { info "finding speakers has no work folder for the $side side"; return 1; }
  say "finding speakers on the $side side on device (FluidAudio)"
  out="$work/$side.speakers.json"
  speech_run "$work" "$src/$side.m4a" speakers "$out" ${count:+--count "$count"} || rc=$?
  [ "$rc" -ne 0 ] || return 0
  rm -f "$out" "$work/.part-$side.speakers.json"
  if [ "$rc" -eq 2 ]; then info "finding speakers: $side.m4a could not be read"
  else info "finding speakers: $SPEECH_REASON"
  fi
  warn "could not find speakers on the $side side, carrying on without labels there"
  return 1
}

# One side of the call to word timed JSON in OUT, for mb-transcript: each transcriber in turn. A
# transcriber that says it worked but wrote something that is not a JSON object has failed too. A
# side every transcriber fails on is written as no words, with a warning, and returns 1: one side
# is better than none, but both failing is a different problem.
transcribe_words() {
  local audio="$1" out="$2" first="$3" e tried="" worked
  for e in $(engine_chain "$first"); do
    case "$e" in
      native)  have speech-analyzer || continue ;;
      whisper) have whisper-cli || continue ;;
    esac
    [ -z "$tried" ] || warn "$(engine_name "$tried") could not transcribe $(basename "$audio"), trying $(engine_name "$e")"
    tried="$e"
    worked=0
    case "$e" in
      parakeet) pk_run "$audio" "$out" && worked=1 ;;
      native)   sa_run "$out" "$audio" -f json && worked=1 ;;
      whisper)  whisper_words "$audio" "$out" && worked=1 ;;
    esac
    if [ "$worked" = 1 ]; then
      jq -e 'type == "object"' "$out" >/dev/null 2>&1 && return 0
      info "$(engine_name "$e") wrote $(basename "$out"), but it cannot be read"
    fi
  done
  warn "could not transcribe $(basename "$audio"), carrying on without it"
  printf '{"engine": "none", "words": []}\n' > "$out"
  chmod 600 "$out"
  return 1
}

# The meeting's id, as the voice print's sources name it: meeting.json's id, or the folder's name.
meeting_id() {
  local id=""
  if [ -f "$1/meeting.json" ]; then
    id="$(jq -r '.id | select(type == "string" and length > 0 and length <= 200 and (test("[[:cntrl:]]") | not))' \
            "$1/meeting.json" 2>/dev/null)" || id=""
  fi
  printf '%s' "${id:-$(basename "$(cd "$1" && pwd -P)")}"
}

# Your side and the other side transcribed on their own from the audio in SRC, then merged by
# mb-transcript into labelled lines: Me, Room N, Them, Them N or Unknown, from the speakers found on
# each side and the voice print. Every output goes in OUT (a run's stage), with the WAVs and speakers
# files in the run's work folder there: nothing in SRC is changed. The people counts, ROOM_COUNT and
# CALL_COUNT, go to mb-transcript as --mic-count and --call-count. With MEETING_ID (process only, never
# a redo), a call may add to the voice print, but only to one on the install record.
# Usage: transcribe_channels SRC OUT [MEETING_ID]
transcribe_channels() {
  local src="$1" dest="$2" learn="${3:-}" engine tmp err line held="" status=0 failed=0 plain="" side
  local labels=() counts=()
  [ -x "$TRANSCRIPT_BIN" ] || die "mb-transcript is not installed. Run: meetingbox setup"
  engine="$(pick_engine)" || exit 1   # pick_engine has said why
  say "transcribing each side on device ($(engine_title "$engine"))"
  make_work "$dest"
  # through ||, so set -e does not end the run on the first side that fails
  transcribe_words "$src/mic.m4a" "$dest/mic.words.json" "$engine" || failed=$((failed + 1))
  transcribe_words "$src/call.m4a" "$dest/call.words.json" "$engine" || failed=$((failed + 1))
  # Both failing is rarely a silent meeting: usually no transcriber can run at all.
  if [ "$failed" -eq 2 ]; then
    drop_work
    die "transcription failed on both sides. Check Speech Recognition in Privacy settings, or run: meetingbox setup"
  fi

  # The speakers on each side, with either transcriber's words. Their files hold voice vectors, so
  # they stay in the work folder, which goes as soon as mb-transcript is done.
  progress speakers
  if speech_usable; then
    heard_nothing "$dest/mic.words.json" || find_speakers "$src" "$WORK" mic "$ROOM_COUNT" || true
    heard_nothing "$dest/call.words.json" || find_speakers "$src" "$WORK" call "$CALL_COUNT" || true
  else
    info "Parakeet is not set up, so speakers are not told apart: the transcript says Me and Them"
  fi

  # The speakers files that were made, and with any, the voice print: used to name the speakers, and
  # learnt into only on a first processing and only when setup recorded it.
  for side in mic call; do
    [ ! -f "$WORK/$side.speakers.json" ] || labels+=("--$side-speakers" "$WORK/$side.speakers.json")
  done
  if [ "${#labels[@]}" -gt 0 ]; then
    labels+=(--voice "$VOICE_FILE")
    if [ -n "$learn" ]; then
      if installed_by_us "$VOICE_FILE"; then labels+=(--learn "$learn")
      elif [ -e "$VOICE_FILE" ] || [ -L "$VOICE_FILE" ]; then
        info "your voice is not learnt from this meeting: $VOICE_FILE was not made by meetingbox, so it is left alone"
      fi
    fi
  fi

  # A count of 1 leaves that side unlabelled (there are no speakers for it), and 2 to 6 is that many.
  case "$ROOM_COUNT" in [1-6]) counts+=(--mic-count "$ROOM_COUNT") ;; esac
  case "$CALL_COUNT" in [1-6]) counts+=(--call-count "$CALL_COUNT") ;; esac

  # Written aside and moved, so a failure leaves no half transcript behind.
  tmp="$WORK/transcript.txt"; err="$WORK/transcript.err"
  tidy_lines || plain="--plain"
  "$TRANSCRIPT_BIN" --mic "$dest/mic.words.json" --call "$dest/call.words.json" ${labels[@]+"${labels[@]}"} \
    ${counts[@]+"${counts[@]}"} ${plain:+"$plain"} > "$tmp" 2> "$err" || status=$?
  # The voice vectors go as soon as mb-transcript is done.
  rm -f "$WORK/mic.speakers.json" "$WORK/call.speakers.json"
  # Its "mb-transcript: " lines are warnings (a side it could not read is not a failure), and the last
  # one is the reason when it failed; its other lines are the meeting's log, about speakers and the voice.
  while IFS= read -r line; do
    case "$line" in
      "mb-transcript: "*) [ -z "$held" ] || warn "$held"; held="${line#mb-transcript: }" ;;
      *) info "$line" ;;
    esac
  done < "$err"
  if [ "$status" -ne 0 ]; then
    drop_work
    die "${held:-mb-transcript failed}"
  fi
  [ -z "$held" ] || warn "$held"
  mv -f "$tmp" "$dest/transcript.txt"
  drop_work
  ok "transcript: $(wc -l < "$dest/transcript.txt" | tr -d ' ') lines"
}

# ------------------------------------------------------------------ summarising

token_count() {
  if have fm; then
    n="$(fm count-tokens < "$1" 2>/dev/null | tr -dc '0-9\n' | grep -m1 '[0-9]' || true)"
    [ -n "$n" ] && { printf '%s' "$n"; return; }
  fi
  awk '{n += NF} END {printf "%d", n * 1.35}' "$1"
}

# fm ignores stdin if given a positional prompt, so the prompt goes in -i and
# the content arrives on stdin.
fm_run() {
  instr="$1"; input="$2"; shift 2
  fm respond -i "$instr" "$@" < "$input"
}

# A dense slice can need more answer than the window has room for, and fm then
# fails with "exceeded the model's context size". Dropping it would quietly lose
# decisions, so halve the slice and try again, down to a floor. Output is held
# until the call succeeds, because fm streams and a failed call prints half an answer.
fm_fold() {
  local instr="$1" input="$2" words="$3" sub c
  if fm_run "$instr" "$input" > "$input.out" 2>/dev/null; then
    cat "$input.out"; return
  fi
  [ "$words" -gt 200 ] || return 1
  info "  too dense for one pass, splitting it"
  sub="$input.split"
  split_chunks "$input" "$sub" $((words / 2)) > "$sub.list" || return 1
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    fm_fold "$instr" "$c" $((words / 2)) || return 1
    printf '\n' || return 1
  done < "$sub.list"
}

# Fold by word count, keeping the lines: each line of a transcript is one
# speaker's turn. Break at a line end once past the target, with a hard cap so a
# transcript that arrives as one long paragraph still splits. False when the chunks could not be
# written whole.
split_chunks() {
  infile="$1"; outdir="$2"; n="$3"
  mkdir -p "$outdir" || return 1
  awk -v n="$n" -v dir="$outdir" '
    function newfile() { part++; w = 0; file = sprintf("%s/chunk-%03d.txt", dir, part) }
    BEGIN { part = 0; newfile() }
    {
      sep = ""
      for (i = 1; i <= NF; i++) {
        printf "%s%s", sep, $i > (file)
        sep = " "; w++
        if (w >= n * 1.5 && i < NF) {
          printf "\n" > (file); close(file); newfile(); sep = ""
        }
      }
      printf "\n" > (file)
      if (w >= n) { close(file); newfile() }
    }
    END { close(file) }
  ' "$infile" || return 1

  for f in "$outdir"/chunk-*.txt; do
    [ -e "$f" ] || continue
    if [ -s "$f" ] && grep -q '[^[:space:]]' "$f"; then printf '%s\n' "$f"; else rm -f "$f"; fi
  done
}

# summarise's way out of a failure: MINUTES_WHY says why, and its work folder goes. It reads `work`
# from the summarise that calls it.
minutes_failed() { MINUTES_WHY="$1"; remove_own_folder "$work" || true; }

# The minutes of TRANSCRIPT, written into OUT, a run's stage: notes-raw.md, notes.md, brief.json when
# the structured pass gives a JSON object, and .notes-written, the SHA-256 of that notes.md on one
# line. They are built in a work folder made inside OUT; the minutes and the brief move out of it only
# once whole, so a failed brief leaves no file. It is called as a condition, so errexit is off inside
# it: every write is checked here. Returns 1, with MINUTES_WHY saying why, when there are no minutes to
# write, or one of its writes failed.
# Usage: summarise TRANSCRIPT OUT
summarise() {
  local transcript="$1" dir="$2" work merged text tokens list total i c notes round rlist next schema
  MINUTES_WHY=""
  if ! have fm; then MINUTES_WHY="fm not found. It ships with macOS 27. Run: meetingbox setup"; return 1; fi

  # A fresh folder made here, so the clean up at the end can only delete that.
  if ! work="$(mktemp -d "${dir:?}/.work.XXXXXX")"; then MINUTES_WHY="could not make a working folder in $dir"; return 1; fi
  merged="$work/merged.txt"

  # fm reads the words and the speakers. The times are for people, and only cost tokens.
  text="$work/transcript.txt"
  sed -E 's/^\[[0-9:]+\] //' "$transcript" > "$text" || { minutes_failed "could not read the transcript"; return 1; }

  tokens="$(token_count "$text")"; tokens="${tokens:-0}"
  info "transcript is ~$tokens tokens, the on device window is ~4000"

  if [ "$tokens" -le "$TOKEN_CEILING" ]; then
    info "fits in one pass"
    cp "$text" "$merged" || { minutes_failed "could not write the notes to work from"; return 1; }
  else
    # Chunk lists go through files, not bash arrays: stock macOS bash is 3.2,
    # where `mapfile` is missing and an empty array trips `set -u`.
    list="$work/chunks.list"
    split_chunks "$text" "$work/chunks" "$CHUNK_WORDS" > "$list" || { minutes_failed "could not slice the transcript"; return 1; }
    total="$(grep -c . "$list" 2>/dev/null || true)"
    if [ "${total:-0}" -le 0 ]; then
      minutes_failed "chunking produced nothing, the transcript may be unreadable"
      return 1
    fi
    say "summarising in $total slices"

    : > "$merged" || { minutes_failed "could not write the notes to work from"; return 1; }
    i=0
    while IFS= read -r c; do
      [ -n "$c" ] || continue
      i=$((i + 1))
      info "slice $i/$total"
      notes="$c.notes"
      if ! fm_fold "$MAP_INSTRUCTIONS" "$c" "$CHUNK_WORDS" > "$notes"; then
        warn "slice $i could not be summarised, its text is kept verbatim in notes-raw.md"
        cp "$c" "$notes" || { minutes_failed "could not write the notes of slice $i"; return 1; }
      fi
      { printf '\n## slice %d of %d\n\n' "$i" "$total" && cat "$notes"; } >> "$merged" \
        || { minutes_failed "could not write the notes of slice $i"; return 1; }
    done < "$list"

    round=0
    while [ "$(token_count "$merged")" -gt "$TOKEN_CEILING" ]; do
      round=$((round + 1))
      if [ "$round" -gt 4 ]; then warn "still over the window after 4 rounds, going with what we have"; break; fi
      info "folding, round $round"
      rlist="$work/reduce-$round.list"
      # Merging keeps every item, so the answer is about as long as the input.
      # Half size slices leave room for both inside the window.
      split_chunks "$merged" "$work/reduce-$round" $((CHUNK_WORDS / 2)) > "$rlist" \
        || { minutes_failed "could not slice the notes"; return 1; }
      next="$work/merged.r$round.txt"
      : > "$next" || { minutes_failed "could not write the folded notes"; return 1; }
      while IFS= read -r c; do
        [ -n "$c" ] || continue
        # On failure carry the notes forward unmerged rather than drop them.
        notes="$c.notes"
        fm_fold "$REDUCE_INSTRUCTIONS" "$c" $((CHUNK_WORDS / 2)) > "$notes" || cp "$c" "$notes" \
          || { minutes_failed "could not write the folded notes"; return 1; }
        { cat "$notes" && printf '\n'; } >> "$next" || { minutes_failed "could not write the folded notes"; return 1; }
      done < "$rlist"
      merged="$next"
    done
  fi

  cp "$merged" "$dir/notes-raw.md" || { minutes_failed "could not write notes-raw.md"; return 1; }

  say "writing the minutes"
  # fm streams, so a failed pass would leave half a file. Write aside, then move.
  # If the notes are still too big for the window, ship them whole rather than nothing.
  if ! fm_run "$FINAL_INSTRUCTIONS" "$merged" > "$work/final.md" 2>/dev/null; then
    warn "too much in this meeting for one final pass, so notes.md holds the merged notes in full"
    cp "$merged" "$work/final.md" || { minutes_failed "could not write the minutes"; return 1; }
  fi
  if [ ! -s "$work/final.md" ]; then
    minutes_failed "the minutes came out empty"
    return 1
  fi
  mv "$work/final.md" "$dir/notes.md" || { minutes_failed "could not write notes.md"; return 1; }

  # Structured record beside the prose, so downstream tooling gets something it
  # can parse rather than something it has to interpret. Written aside, and moved
  # beside the minutes only when it reads as a JSON object.
  schema="$work/schema.json"
  if fm schema object --name MeetingBrief \
       --string summary \
       --string decisions --array \
       --string actions --array \
       --string open_questions --array \
       --string numbers_and_dates --array > "$schema" 2>/dev/null
  then
    if fm_run "$BRIEF_INSTRUCTIONS" "$merged" --schema "$schema" > "$work/brief.json" 2>/dev/null \
       && jq -e 'type == "object"' "$work/brief.json" >/dev/null 2>&1 && mv "$work/brief.json" "$dir/brief.json"; then
      ok "brief.json"
    else
      warn "structured pass failed, the prose minutes are still good"
    fi
  fi

  # What meetingbox wrote, so a later run can tell a notes.md edited by hand.
  { shasum -a 256 "$dir/notes.md" | cut -d' ' -f1 > "$dir/.notes-written"; } \
    || { minutes_failed "could not write .notes-written"; return 1; }

  [ "${MB_DEBUG:-0}" = "1" ] || remove_own_folder "$work" || true
  ok "minutes written"
}

# ------------------------------------------------------------------- processing

# One run (process, notes or redo) per folder at a time. The lock is the folder <dir>/.processing,
# made with mkdir, holding `owner`: "<pid> <that pid's start time>", so a PID
# reused after a crash or reboot never passes for the owner. owner goes in with
# ln, which never replaces a file, so of two processes taking over one stale
# lock exactly one gets it. A lock with no owner yet (between mkdir and ln)
# counts as held for PROCESS_LOCK_GRACE seconds after its change time.
PROCESS_LOCK_GRACE=10
BUSY_EXIT=75   # EX_TEMPFAIL: refused because another process holds the folder
PROCESSING_LOCK=""
PROCESSING_OWNER=""
PROCESSING_DIR=""
PROCESSING_STARTED=""

# A PID's start time as ps gives it, or nothing when no such process runs. Read
# in UTC: ps prints local time, and two runs with different TZ settings must
# read one owner the same way.
pid_lstart() { LC_ALL=C TZ=UTC0 ps -o lstart= -p "$1" 2>/dev/null | sed 's/^ *//; s/ *$//' || true; }

# Held: the owner named in $2 (the owner file's text, empty for none) is running
# with the same start time, or there is no owner and the lock $1 is fresh.
processing_lock_alive() {
  local pid start changed
  if [ -n "$2" ]; then
    pid="${2%% *}"; start="${2#* }"
    case "$pid" in ''|*[!0-9]*) ;; *) [ "$(pid_lstart "$pid")" = "$start" ]; return ;; esac
  fi
  changed="$(stat -f %c "$1" 2>/dev/null)" || return 1
  [ $(( $(date +%s) - changed )) -lt "$PROCESS_LOCK_GRACE" ]
}

busy_die() { printf '%s\n' "${c_r}     error${c_0} $*" >&2; exit "$BUSY_EXIT"; }

# A run's own answers to a signal: the exit trap then writes the result and releases the lock.
run_traps() {
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
}

# Takes the lock in DIR; SHOWN is how messages name the folder (DIR itself unless given).
# Usage: take_processing_lock DIR [SHOWN]
take_processing_lock() {
  local dir="$1" shown="${2:-$1}" lock="$1/.processing" tmp me start owner seen moved took tries=0
  tmp="$(mktemp "$dir/.processing-owner.XXXXXX")" || die "could not write in $shown"
  # This shell's PID: $$ is the parent's in a subshell, and bash 3.2 has no BASHPID.
  sh -c 'printf "%s" "$PPID"' > "$tmp"
  me="$(cat "$tmp")"
  start="$(pid_lstart "$me")"
  # Without it the owner would read as stale from birth, and anyone could take over.
  [ -n "$start" ] || { rm -f "$tmp"; die "could not read this process's start time"; }
  owner="$me $start"
  printf '%s\n' "$owner" > "$tmp"
  while :; do
    tries=$((tries + 1))
    [ "$tries" -le 20 ] || { rm -f "$tmp"; busy_die "this meeting is already being processed: $shown"; }
    if mkdir "$lock" 2>/dev/null; then
      ln "$tmp" "$lock/owner" 2>/dev/null && break
      continue   # taken over while we were between mkdir and ln: look again
    fi
    seen="$(cat "$lock/owner" 2>/dev/null || true)"
    if processing_lock_alive "$lock" "$seen"; then
      rm -f "$tmp"
      busy_die "this meeting is already being processed: $shown"
    fi
    if [ -z "$seen" ]; then
      ln "$tmp" "$lock/owner" 2>/dev/null && break
      continue
    fi
    # A stale owner: move that file aside (only one taker can), then put ours in.
    # Ctrl-C or TERM are held off meanwhile, so a live owner moved aside by
    # mistake is always put back.
    moved="$(mktemp -u "$dir/.processing-stale.XXXXXX")"
    took=0
    trap '' INT TERM
    if mv "$lock/owner" "$moved" 2>/dev/null; then
      if [ "$(cat "$moved" 2>/dev/null || true)" != "$seen" ]; then
        # A newer owner, put in after we looked: give it back and look again.
        ln "$moved" "$lock/owner" 2>/dev/null || true
      else
        ln "$tmp" "$lock/owner" 2>/dev/null && took=1
      fi
      rm -f "$moved"
    fi
    trap - INT TERM
    [ "$took" = 0 ] || break
  done
  rm -f "$tmp"
  PROCESSING_LOCK="$lock"
  # Our own text, not a re-read: a loser may hold the shared file aside just now.
  PROCESSING_OWNER="$owner"
  PROCESSING_DIR="$dir"
  PROCESSING_STARTED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  trap 'end_processing $?' EXIT
  run_traps
}

# Removes the lock only while it is still ours.
release_processing_lock() {
  [ -n "$PROCESSING_LOCK" ] || return 0
  if [ "$(cat "$PROCESSING_LOCK/owner" 2>/dev/null || true)" = "$PROCESSING_OWNER" ]; then
    rm -f "$PROCESSING_LOCK/owner"
    rmdir "$PROCESSING_LOCK" 2>/dev/null || true
  fi
  PROCESSING_LOCK=""
}

# The last act of a locked run, on success or failure: the run's work folder and stage removed (a
# stage that a .swap names stays, for the next run to finish from), then .process-result written aside
# and moved into place (so a reader never sees half of it), then the lock released. The run is ending,
# so nothing here may stop it: errexit is off, and a removal that fails is a warning. The app counts a
# result only when its attempt is the one it started.
end_processing() {
  local rc="$1" attempt result tmp_result
  trap - EXIT HUP INT TERM
  set +e
  drop_work
  drop_stage
  if [ -n "$PROCESSING_LOCK" ]; then
    attempt="$(printf '%s' "${MB_ATTEMPT:-}" | tr -cd 'A-Za-z0-9._-')"
    result="$PROCESSING_DIR/.process-result"
    if tmp_result="$(mktemp "$PROCESSING_DIR/.process-result.XXXXXX")"; then
      if printf 'attempt=%s status=%s started=%s finished=%s\n' "${attempt:-terminal}" "$rc" \
           "$PROCESSING_STARTED" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$tmp_result"; then
        mv -f "$tmp_result" "$result"
      else
        rm -f "$tmp_result"
      fi
    fi
    release_processing_lock
  fi
  return "$rc"
}

# With MB_PROGRESS_FILE set (the app sets it), each stage is appended to it.
progress() {
  [ -n "${MB_PROGRESS_FILE:-}" ] || return 0
  printf '%s\n' "$1" >> "$MB_PROGRESS_FILE" 2>/dev/null || true
}

# ------------------------------------------------ every run keeps what it replaces
#
# process, notes and redo all write a meeting folder the same way (spec 6.4). A run builds its new
# files in a staging folder of its own inside the meeting folder. Only once they are all there and
# whole does it copy each file it will overwrite into earlier/<YYYY-MM-DD HHMM>/, and then swap the new
# files in, one rename at a time, under a .swap marker; a listed file it did not make is moved into
# that earlier folder instead. A run killed before the swap has changed nothing. One killed during it
# leaves the marker, and the next run on the folder finishes that swap first. Only the files on a
# replace list are ever replaced, and none before its copy is in earlier/. Everything else in the
# folder (the audio, meeting.json, transcripts others wrote) is never touched.

# The replace lists, in the order the swap moves them in: .notes-written always last.
TRANSCRIPTION_FILES="transcript.txt mic.words.json call.words.json"
MINUTES_FILES="notes-raw.md brief.json notes.md .notes-written"
SWAP_EXIT=3   # the swap could not finish, so .swap is left for the next run to finish

swap_die() { printf '%s\n' "${c_r}     error${c_0} $*" >&2; exit "$SWAP_EXIT"; }

# A file on a replace list, by its name in the meeting folder.
listed_file() {
  case "$1" in transcript.txt|mic.words.json|call.words.json|notes-raw.md|brief.json|notes.md|.notes-written) return 0 ;; esac
  return 1
}

# The meeting folder is still where the run found it: RUN_DIR, the path the run was given, still leads
# to the folder the run is in. A run works in it by relative paths, so one that was moved would still
# write into it, but the app and the user would be looking elsewhere.
still_here() { [ "$(stat -f %d:%i . 2>/dev/null)" = "$(stat -L -f %d:%i "$RUN_DIR" 2>/dev/null)" ]; }

# Stops a run whose meeting folder was moved. Nothing of this run's is in it; after another kind's
# swap was finished, that one's files are, and die says so.
moved_die() {
  if [ "$FINISHED_OTHER" = 1 ]; then die "the meeting folder was moved"; fi
  die "the meeting folder was moved, nothing was changed"
}

# DIR (a full path) is the earlier/ folder of a meeting folder (one holding meeting.json or audio.m4a),
# or a version kept in it. A folder named earlier anywhere else is a folder like any other.
kept_versions() {
  local e
  case "$(basename -- "$1")" in
    earlier) e="$1" ;;
    *) [ "$(basename -- "$(dirname -- "$1")")" = earlier ] || return 1; e="$(dirname -- "$1")" ;;
  esac
  [ -e "$(dirname -- "$e")/meeting.json" ] || [ -e "$(dirname -- "$e")/audio.m4a" ]
}

# Steps 1 to 5 of every run: the lock, taken in the folder itself; a swap a killed run left, finished
# or discarded; leftovers cleared; an unfinished recording refused; and the run's stage, in STAGE. A
# version kept in earlier/ is refused before anything is written in it. KIND is the run's own:
# process, minutes or transcribe. From here on the run is in the meeting folder, and every path is
# relative to it.
# Usage: begin_run DIR KIND (DIR a full path)
begin_run() {
  local dir="$1" kind="$2"
  cd -P "$dir" || die "no such folder: $dir"
  if kept_versions "$dir" || kept_versions "$(pwd -P)"; then
    die "$dir is a meeting's earlier/ folder, or a version kept in it, not a meeting folder, so it is left as it is"
  fi
  RUN_DIR="$dir"
  take_processing_lock . "$RUN_DIR"
  still_here || moved_die
  finish_swap "$kind"
  clear_leftovers
  if recording_unfinished .; then
    die "this recording was not finished. Run: meetingbox recover $RUN_DIR"
  fi
  STAGE="$(mktemp -d .stage.XXXXXX)" || die "could not make a staging folder in $RUN_DIR"
}

# Reads the marker .swap into SWAP_KIND, SWAP_STAGE, SWAP_EARLIER, SWAP_MOVES, SWAP_DISPLACES and
# SWAP_STATUS. False, with SWAP_WHY saying why and what that means, unless it ends with its end line
# and names only what a run writes: a kind, a staging folder of the meeting's own that is there, an
# earlier folder's name (or - for none), files on the replace lists, and at most one status line.
read_swap() {
  local line key value n=0 ended=0
  SWAP_KIND=""; SWAP_STAGE=""; SWAP_EARLIER=""; SWAP_MOVES=""; SWAP_DISPLACES=""; SWAP_STATUS=""; SWAP_WHY=""
  if [ -L .swap ] || [ ! -f .swap ]; then SWAP_WHY="is not a plain file, so none of its files is moved in"; return 1; fi
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    if [ "$ended" = 1 ]; then SWAP_WHY="goes on after its end line, so none of its files is moved in"; return 1; fi
    key="${line%% *}"; value="${line#* }"
    case "$n:$key" in
      1:kind)    SWAP_KIND="$value" ;;
      2:stage)   SWAP_STAGE="$value" ;;
      3:earlier) SWAP_EARLIER="$value" ;;
      *:move|*:displace)
        listed_file "$value" || { SWAP_WHY="names a file no run replaces, so none of its files is moved in"; return 1; }
        if [ "$key" = move ]; then SWAP_MOVES="$SWAP_MOVES $value"; else SWAP_DISPLACES="$SWAP_DISPLACES $value"; fi ;;
      *:status)
        [ -z "$SWAP_STATUS" ] && [ "$value" = 1 ] || { SWAP_WHY="cannot be read, so none of its files is moved in"; return 1; }
        SWAP_STATUS=1 ;;
      *:end)
        [ "$line" = end ] || { SWAP_WHY="cannot be read, so none of its files is moved in"; return 1; }
        ended=1 ;;
      *) SWAP_WHY="cannot be read, so none of its files is moved in"; return 1 ;;
    esac
  done < .swap
  # written to a temporary name and renamed into place whole: without its end line, nothing had moved
  if [ "$ended" = 0 ]; then SWAP_WHY="has no end line, so it was never whole and no file had moved yet"; return 1; fi
  case "$SWAP_KIND" in
    process|minutes|transcribe) ;;
    *) SWAP_WHY="names no kind of run, so none of its files is moved in"; return 1 ;;
  esac
  case "$SWAP_STAGE" in
    */*) SWAP_WHY="names no staging folder, so none of its files is moved in"; return 1 ;;
    .stage.??????) ;;
    *) SWAP_WHY="names no staging folder, so none of its files is moved in"; return 1 ;;
  esac
  if [ ! -d "$SWAP_STAGE" ] || [ -L "$SWAP_STAGE" ]; then
    SWAP_WHY="names a staging folder that is not there, so there is nothing left to move in"; return 1
  fi
  case "$SWAP_EARLIER" in
    -) [ -z "$SWAP_DISPLACES" ] || { SWAP_WHY="displaces files with no earlier folder, so none of its files is moved in"; return 1; } ;;
    */*) SWAP_WHY="names no earlier folder, so none of its files is moved in"; return 1 ;;
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]\ [0-9][0-9][0-9][0-9]|[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]\ [0-9][0-9][0-9][0-9]-[1-9]*) ;;
    *) SWAP_WHY="names no earlier folder, so none of its files is moved in"; return 1 ;;
  esac
}

# earlier/ is a real folder, or not there yet.
earlier_usable() { [ ! -L earlier ] && { [ ! -e earlier ] || [ -d earlier ]; }; }

# The copy the run kept of FILE: earlier/<marker's name>/FILE, a plain file, with no link on the way to
# it. A link there could lead back to FILE itself, or out of the meeting folder.
kept_copy() {
  [ "$SWAP_EARLIER" != - ] && [ ! -L earlier ] && [ ! -L "earlier/$SWAP_EARLIER" ] \
    && [ ! -L "earlier/$SWAP_EARLIER/$1" ] && [ -f "earlier/$SWAP_EARLIER/$1" ]
}

# Before a swap moves new files over FILE...: none is the copy the run kept of it (it changed since, or
# no copy of it was kept), so a copy is made now, in the stage, compared byte for byte, and renamed to
# the first free earlier/<YYYY-MM-DD HHMM>[-N]. Each line says which it was. False, with a line saying
# why and nothing moved, when that fails.
# Usage: keep_again FILE...
keep_again() {
  local f tmp stamp name n
  earlier_usable || { warn "earlier in $RUN_DIR is not a folder, so nothing is moved over $*"; return 1; }
  tmp="$(mktemp -d "$SWAP_STAGE/kept.XXXXXX")" \
    || { warn "could not make a folder for copies of $* in $SWAP_STAGE, so nothing is moved over them"; return 1; }
  for f in "$@"; do
    if [ -d "$f" ]; then warn "$f is a folder, so no copy of it can be kept and nothing is moved over it"; return 1; fi
    { cp -- "$f" "$tmp/$f" && chmod 600 "$tmp/$f"; } || { warn "$f could not be copied, so nothing is moved over it"; return 1; }
    cmp -s -- "$f" "$tmp/$f" || { warn "the copy of $f does not match it, so nothing is moved over it"; return 1; }
  done
  [ -d earlier ] || mkdir earlier || { warn "could not make earlier/ in $RUN_DIR, so nothing is moved over $*"; return 1; }
  stamp="$(date '+%Y-%m-%d %H%M')"; name="$stamp"; n=1
  while [ -e "earlier/$name" ] || [ -L "earlier/$name" ]; do n=$((n + 1)); name="$stamp-$n"; done
  mv -- "$tmp" "earlier/$name" || { warn "could not move the copies of $* into earlier/$name, so nothing is moved over them"; return 1; }
  for f in "$@"; do
    if kept_copy "$f"; then warn "$f is not the copy kept in earlier/$SWAP_EARLIER, so it is kept in earlier/$name before the new one goes in"
    else warn "no copy of $f was kept, so it is kept in earlier/$name before the new one goes in"; fi
  done
}

# Step 9's renames, for this run's swap and for one a killed run left, as the SWAP_ variables give it.
# First, a file a move would overwrite that is not the copy kept of it in the earlier folder (changed
# since, or there since nothing was kept, or that copy reached through a link) is kept again, in a new
# earlier folder; if that fails, nothing moves. A displacement through a linked earlier folder is
# refused before anything moves. .notes-written, never kept, is never checked. Then each file moves from the stage over
# its target, .notes-written last, and each displaced file moves into the earlier folder (made again if
# it has gone), where nothing of that name may be, and is made 0600. A file already moved is skipped,
# so a swap a killed run began finishes the same way. Every file moved in is touched, so the app counts
# it as written by the run that finished the swap. Interrupt signals are ignored meanwhile. A rename
# that fails is logged and the rest still move: then it returns 1 and .swap stays. Otherwise .swap is
# removed.
apply_swap() {
  local f failed=0 changed=""
  trap '' INT TERM HUP
  if [ -n "$SWAP_DISPLACES" ] && { [ -L earlier ] || [ -L "earlier/$SWAP_EARLIER" ]; }; then
    warn "earlier/$SWAP_EARLIER leads through a link, so nothing is moved through it out of the meeting folder"
    run_traps; return 1
  fi
  if [ -n "$SWAP_DISPLACES" ] && [ ! -d "earlier/$SWAP_EARLIER" ]; then
    if ! earlier_usable || ! mkdir -p "earlier/$SWAP_EARLIER"; then
      warn "could not make earlier/$SWAP_EARLIER again for the files this swap moves aside"
      run_traps; return 1
    fi
    info "earlier/$SWAP_EARLIER, where the interrupted run kept its copies, was not there; it is made again for the files it moves aside"
  fi
  for f in $SWAP_MOVES; do
    [ "$f" != .notes-written ] && [ -e "$SWAP_STAGE/$f" ] && [ -e "$f" ] || continue
    if kept_copy "$f" && cmp -s -- "$f" "earlier/$SWAP_EARLIER/$f"; then continue; fi
    changed="$changed $f"
  done
  # shellcheck disable=SC2086   # file names, without spaces
  if [ -n "$changed" ] && ! keep_again $changed; then run_traps; return 1; fi
  for f in $SWAP_MOVES; do
    if [ -e "$SWAP_STAGE/$f" ] && ! mv -f -- "$SWAP_STAGE/$f" "$f"; then
      warn "could not move the new $f into place"
      failed=1
      continue
    fi
    if [ -e "$f" ]; then touch -- "$f" || true; fi
  done
  for f in $SWAP_DISPLACES; do
    [ -e "$f" ] || continue
    if [ -e "earlier/$SWAP_EARLIER/$f" ] || [ -L "earlier/$SWAP_EARLIER/$f" ] || ! mv -- "$f" "earlier/$SWAP_EARLIER/$f"; then
      warn "could not move the old $f into earlier/$SWAP_EARLIER"
      failed=1
      continue
    fi
    chmod 600 "earlier/$SWAP_EARLIER/$f" || true
  done
  if [ "$failed" = 0 ]; then rm -f .swap || true; fi
  run_traps
  return "$failed"
}

# Step 2: a .swap marker a killed run left. One without its end line, or naming a stage that is not
# there, or that cannot be read, is removed with a log line saying which. Otherwise that swap is
# finished first. A run of the marker's own kind then stops with the marker's status, since its result
# is in place: 0, or 1 for a process whose minutes failed. A run of another kind goes on with its own
# work, and a failure after that says the interrupted run's files were put in place.
# Usage: finish_swap KIND
finish_swap() {
  [ -e .swap ] || [ -L .swap ] || return 0
  if [ -d .swap ] && [ ! -L .swap ]; then die ".swap in $RUN_DIR is a folder, not meetingbox's marker. Move it away to go on"; fi
  if ! read_swap; then
    info "the .swap marker an interrupted run left $SWAP_WHY; it is removed"
    rm -f .swap
    return 0
  fi
  say "finishing the swap an interrupted run began"
  apply_swap || swap_die "not every new file could be moved into place"
  remove_own_folder "$SWAP_STAGE" || true
  ok "the interrupted run's new files are in place"
  if [ "$SWAP_KIND" = "$1" ]; then
    [ "$SWAP_STATUS" != 1 ] || die "the minutes could not be written, so only the new transcript went in"
    progress done
    exit 0
  fi
  FINISHED_OTHER=1
}

# Step 3: what killed runs left: their staging folders, and a marker half written. In a folder the
# recorder made (meeting.json, audio.m4a, mic.m4a or call.m4a is there), also a work folder from before
# runs had stages, which may hold a WAV and speakers files with voice vectors; elsewhere a .work. folder
# might not be meetingbox's, so it is left alone. None of them holds the only copy of anything.
clear_leftovers() {
  local f folders=".stage.??????"
  if [ -e meeting.json ] || [ -e audio.m4a ] || [ -e mic.m4a ] || [ -e call.m4a ]; then folders="$folders .work.??????"; fi
  for f in $folders; do
    [ -d "$f" ] && [ ! -L "$f" ] || continue
    info "removing $f, left by a run that stopped"
    remove_own_folder "$f" || true
  done
  rm -f .swap.tmp || true
}

# Removes this run's stage, unless a .swap names it: then a swap is left part done, and the next run
# finishes it from there.
drop_stage() {
  local s="$STAGE"
  [ -n "$s" ] || return 0
  STAGE=""
  if [ -f .swap ] && grep -qxF "stage $s" .swap 2>/dev/null; then return 0; fi
  remove_own_folder "$s" || true
}

# Step 7: the new files in the stage are there and whole. Each REQUIRED file is there; transcript.txt,
# notes.md and notes-raw.md are not empty; every JSON file reads (a words file with no words does);
# .notes-written is one SHA-256. Prints why not.
# Usage: staged_whole REQUIRED...
staged_whole() {
  local f
  for f in "$@"; do
    [ -f "$STAGE/$f" ] || { printf 'the new %s was not written' "$f"; return 1; }
  done
  for f in transcript.txt notes.md notes-raw.md; do
    [ ! -e "$STAGE/$f" ] || [ -s "$STAGE/$f" ] || { printf 'the new %s came out empty' "$f"; return 1; }
  done
  for f in mic.words.json call.words.json brief.json; do
    [ ! -e "$STAGE/$f" ] || jq -e . "$STAGE/$f" >/dev/null 2>&1 || { printf 'the new %s cannot be read' "$f"; return 1; }
  done
  [ ! -e "$STAGE/.notes-written" ] || grep -Eqx '[0-9a-f]{64}' "$STAGE/.notes-written" \
    || { printf 'the new .notes-written is not a SHA-256'; return 1; }
}

# For a redo: a side that has words in the folder now must still have words, or the redo fails and
# nothing is changed. Prints why not.
sides_keep_words() {
  local side
  for side in mic call; do
    if [ -f "$side.words.json" ] && has_words "$side.words.json" && ! has_words "$STAGE/$side.words.json"; then
      printf 'the %s side has words now, and transcribing it again found none' "$side"
      return 1
    fi
  done
}

# notes.md was edited by hand since meetingbox wrote it: its SHA-256 is not the one .notes-written
# holds, or there is no .notes-written.
notes_hand_edited() {
  [ -f .notes-written ] || return 0
  [ "$(shasum -a 256 notes.md | cut -d' ' -f1)" != "$(head -n 1 .notes-written)" ]
}

# The swap for the files on a replace list: each one the run made in its stage moves in, made 0600;
# each one it did not make that is in the folder is displaced: moved into earlier/ itself, in the swap.
# .notes-written is never displaced, as it is never kept. Sets SWAP_MOVES, SWAP_DISPLACES and REPLACED,
# the files in the folder that a move overwrites.
# Usage: plan_swap FILE...
plan_swap() {
  local f
  SWAP_MOVES=""; SWAP_DISPLACES=""; REPLACED=""
  for f in "$@"; do
    if [ -f "$STAGE/$f" ]; then
      chmod 600 "$STAGE/$f" || true
      SWAP_MOVES="$SWAP_MOVES $f"
      if [ -e "$f" ]; then REPLACED="$REPLACED $f"; fi
    elif [ "$f" != .notes-written ] && [ -e "$f" ]; then
      SWAP_DISPLACES="$SWAP_DISPLACES $f"
    fi
  done
}

# Step 8, after plan_swap: a copy of each file a move overwrites (REPLACED), made in the stage's kept/
# folder with a checked cp and compared byte for byte, then that folder renamed to the first free
# earlier/<YYYY-MM-DD HHMM>[-N], so it appears whole or not at all. The displaced files join it in the
# swap. .notes-written is never kept. A hand-edited notes.md is also copied to the first free
# notes-edited-<stamp>[-N].md beside it, put in place with ln, which never replaces a file. Sets
# EARLIER to the earlier folder's name, or - when nothing is replaced. Anything that fails stops the
# run with the folder as it was.
keep_earlier() {
  local f stamp name n edited=0 keep=""
  EARLIER="-"; KEPT_EDITED=""; KEPT_MADE_EARLIER=0
  for f in $REPLACED; do [ "$f" = .notes-written ] || keep="$keep $f"; done
  [ -n "$keep$SWAP_DISPLACES" ] || return 0
  stamp="$(date '+%Y-%m-%d %H%M')"
  mkdir "$STAGE/kept" || die "could not make a folder for the copies in $RUN_DIR"
  for f in $keep; do
    { cp -- "$f" "$STAGE/kept/$f" && chmod 600 "$STAGE/kept/$f" && cmp -s -- "$f" "$STAGE/kept/$f"; } \
      || die "could not keep a copy of $f"
  done
  case " $keep " in
    *" notes.md "*)
      if notes_hand_edited; then
        { cp -- notes.md "$STAGE/notes-edited" && chmod 600 "$STAGE/notes-edited" && cmp -s -- notes.md "$STAGE/notes-edited"; } \
          || die "could not keep a copy of the edited notes.md"
        edited=1
      fi ;;
  esac
  still_here || moved_die
  earlier_usable || die "earlier in $RUN_DIR is not a folder"
  if [ ! -d earlier ]; then mkdir earlier || die "could not make earlier/ in $RUN_DIR"; KEPT_MADE_EARLIER=1; fi
  name="$stamp"; n=1
  while [ -e "earlier/$name" ] || [ -L "earlier/$name" ]; do n=$((n + 1)); name="$stamp-$n"; done
  if ! mv -- "$STAGE/kept" "earlier/$name"; then
    unkeep
    die "could not move the copies into earlier/$name"
  fi
  EARLIER="$name"
  if [ "$edited" = 1 ]; then
    name="notes-edited-$stamp.md"; n=1
    while [ -e "$name" ] || [ -L "$name" ]; do n=$((n + 1)); name="notes-edited-$stamp-$n.md"; done
    if ! ln -- "$STAGE/notes-edited" "$name"; then
      unkeep
      die "could not keep the edited notes.md as $name"
    fi
    KEPT_EDITED="$name"
    ok "your edited notes.md is kept as $name"
  fi
  ok "what this run replaces is kept in earlier/$EARLIER"
}

# Undoes keep_earlier, so the folder is as it was: the copies go back into the stage, the notes-edited
# copy it put in place is unlinked (the stage holds the same copy), and an earlier/ it made, now empty,
# goes.
unkeep() {
  if [ "$EARLIER" != - ]; then mv -- "earlier/$EARLIER" "$STAGE/kept" || true; fi
  if [ -n "$KEPT_EDITED" ]; then rm -f -- "$KEPT_EDITED" || true; fi
  if [ "$KEPT_MADE_EARLIER" = 1 ]; then rmdir earlier 2>/dev/null || true; fi
  EARLIER="-"; KEPT_EDITED=""; KEPT_MADE_EARLIER=0
}

# The marker's lines: the kind, the stage, the earlier folder, each file to move in and each to
# displace, status 1 for a process whose minutes failed, and an end line.
swap_lines() {
  local f
  printf 'kind %s\nstage %s\nearlier %s\n' "$SWAP_KIND" "$SWAP_STAGE" "$SWAP_EARLIER"
  for f in $SWAP_MOVES; do printf 'move %s\n' "$f"; done
  for f in $SWAP_DISPLACES; do printf 'displace %s\n' "$f"; done
  [ "$SWAP_STATUS" != 1 ] || printf 'status 1\n'
  printf 'end\n'
}

# Step 9: the folder checked once more, on every run, for a move (what keep_earlier made is undone
# first); the marker, written to .swap.tmp (0600) and renamed into place, so it is whole or absent; then
# the swap itself, and the stage removed. A swap that cannot finish leaves the marker and the stage for
# the next run, and the run exits 3.
# Usage: swap_in KIND (after plan_swap and keep_earlier)
swap_in() {
  SWAP_KIND="$1"; SWAP_STAGE="$STAGE"; SWAP_EARLIER="$EARLIER"; SWAP_STATUS=""
  [ "$MINUTES_FAILED" != 1 ] || SWAP_STATUS=1
  if ! still_here; then unkeep; moved_die; fi
  swap_lines > .swap.tmp && mv -f .swap.tmp .swap \
    || { rm -f .swap.tmp || true; die "could not write the .swap marker in $RUN_DIR"; }
  # from here this run changes the folder itself
  FINISHED_OTHER=0
  apply_swap || swap_die "not every new file could be moved into place"
  drop_stage
}

# Steps 8 and 9 for the files on a replace list.
# Usage: replace_files KIND FILE...
replace_files() {
  local kind="$1"
  shift
  plan_swap "$@"
  keep_earlier
  swap_in "$kind"
}

# The end of a run that worked: progress, the done sound and banner, and from a terminal the minutes.
finish_run() {
  progress done
  chime done
  notify "meetingbox" "Minutes ready"
  ok "minutes: $RUN_DIR/notes.md"
  if [ -t 1 ]; then
    printf '\n'; cat notes.md; printf '\n'
    have open && open notes.md 2>/dev/null || true
  fi
  end_processing 0
}

# process: a recording (a meeting folder's audio.m4a, or any .m4a, .mp3, .wav, .caf, .aiff, .aif, .aac,
# .mp4 or .flac, in any case) or a transcript file (.txt, .md, .vtt or .srt), to a transcript and
# minutes; anything else, a .json included, is refused. The meeting's own
# transcript.txt is a notes run. When the minutes fail, the new transcript and words still go in,
# keeping what they replace, and the run fails: the meeting is Failed with a transcript, and Redo
# minutes can finish it. Only process removes audio, for --no-keep-audio, only once the minutes are in
# place, and only the recording it transcribed: never a file of any other kind.
process() {
  # transcripts and minutes are as private as the recording
  umask 077
  local input="$1" dir name audio two=0 required why=""
  # a meeting folder stands for its recording
  [ -d "$input" ] && input="${input%/}/audio.m4a"
  [ -d "$(dirname -- "$input")" ] || die "no such file: $input"
  dir="$(cd -- "$(dirname -- "$input")" && pwd)"
  name="$(basename -- "$input")"
  if [ "$name" = transcript.txt ]; then notes_cmd "$dir"; return; fi
  case "$(printf '%s' "${name##*.}" | tr '[:upper:]' '[:lower:]')" in
    txt|md|vtt|srt) audio=0 ;;
    m4a|mp3|wav|caf|aiff|aif|aac|mp4|flac) audio=1 ;;
    *) die "$name is neither a recording (.m4a, .mp3, .wav, .caf, .aiff, .aif, .aac, .mp4 or .flac) nor a transcript (.txt, .md, .vtt or .srt), so it is not processed" ;;
  esac
  begin_run "$dir" process
  [ -e "$name" ] || die "no such file: $input"

  if [ "$audio" = 0 ]; then
    cp -- "$name" "$STAGE/transcript.txt" || die "could not copy $name"
  else
    progress transcribing
    # The meeting's own recording (the folder, or its audio.m4a) is both sides, when it has them. Any
    # other recording named is transcribed as itself.
    if [ "$name" = audio.m4a ] && [ -f mic.m4a ] && [ -f call.m4a ]; then
      # process, never a redo, so a call may teach meetingbox the user's voice
      transcribe_channels . "$STAGE" "$(meeting_id .)"
      two=1
    else
      # ./ so that a name starting with a dash is never taken for an option
      transcribe "./$name" "$STAGE/transcript.txt"
    fi
  fi
  required="transcript.txt"
  [ "$two" = 0 ] || required="$required mic.words.json call.words.json"
  # shellcheck disable=SC2086   # file names, without spaces
  why="$(staged_whole $required)" || die "$why"

  progress minutes
  if summarise "$STAGE/transcript.txt" "$STAGE" && why="$(staged_whole notes.md notes-raw.md .notes-written)"; then
    # shellcheck disable=SC2086   # file names, without spaces
    replace_files process $TRANSCRIPTION_FILES $MINUTES_FILES
  else
    why="${MINUTES_WHY:-$why}"
    warn "the minutes could not be written, so only the new transcript goes in"
    # the marker says so, so a process that finishes this swap fails as this one does
    MINUTES_FAILED=1
    # shellcheck disable=SC2086   # file names, without spaces
    replace_files process $TRANSCRIPTION_FILES
    die "${why:-the minutes could not be written}"
  fi
  # --no-keep-audio: only now the minutes are in place, so a failed run never loses audio. Only the
  # recording transcribed goes: the meeting's three files by name, or the one recording given.
  if [ "$KEEP_AUDIO" != "1" ] && [ "$audio" = 1 ]; then
    if [ "$two" = 1 ]; then rm -f audio.m4a mic.m4a call.m4a; else rm -f -- "./$name"; fi
  fi
  finish_run
}

# notes (Redo minutes): the minutes again from the folder's transcript.txt, which it never changes. It
# never transcribes, so it never learns a voice, and it never removes audio.
notes_cmd() {
  umask 077
  local dir why
  [ -d "$1" ] || die "no such folder: $1"
  dir="$(cd -- "$1" && pwd)"
  begin_run "$dir" minutes
  [ -s transcript.txt ] || die "there is no transcript in $RUN_DIR to write the minutes from"
  progress minutes
  summarise transcript.txt "$STAGE" || die "${MINUTES_WHY:-the minutes could not be written}"
  why="$(staged_whole notes.md notes-raw.md .notes-written)" || die "$why"
  # shellcheck disable=SC2086   # file names, without spaces
  replace_files minutes $MINUTES_FILES
  finish_run
}

# redo (Transcribe again): the recording transcribed again, its speakers found again with the people
# counts given, and the minutes written again. It passes no meeting id, so it never teaches meetingbox
# the user's voice, and it never removes audio. A side that has words now and none after fails it.
redo_cmd() {
  umask 077
  local dir why
  [ -d "$1" ] || die "no such folder: $1"
  dir="$(cd -- "$1" && pwd)"
  begin_run "$dir" transcribe
  if [ -f mic.m4a ] && [ -f call.m4a ]; then
    progress transcribing
    transcribe_channels . "$STAGE"
    why="$(staged_whole transcript.txt mic.words.json call.words.json)" || die "$why"
    why="$(sides_keep_words)" || die "$why"
  elif [ -f audio.m4a ]; then
    progress transcribing
    transcribe audio.m4a "$STAGE/transcript.txt"
    why="$(staged_whole transcript.txt)" || die "$why"
  else
    die "there is no recording in $RUN_DIR to transcribe again"
  fi
  progress minutes
  summarise "$STAGE/transcript.txt" "$STAGE" || die "${MINUTES_WHY:-the minutes could not be written}"
  why="$(staged_whole notes.md notes-raw.md .notes-written)" || die "$why"
  # shellcheck disable=SC2086   # file names, without spaces
  replace_files transcribe $TRANSCRIPTION_FILES $MINUTES_FILES
  finish_run
}

# ----------------------------------------------------------------------- reset
#
#   reset            stuck recording state, and meetingbox's macOS permissions
#   reset --tools    also what setup built, so setup starts from scratch
#   uninstall        also meetingbox itself
#
# Recordings are never touched. Only paths on setup's list (see remove_installed)
# are deleted, so nothing that was already on the Mac is, wherever an MB_*
# setting points.

# The v1.1.0 recorder sat in $BIN_DIR. Only a byte for byte copy of the one
# setup compiled counts as ours.
old_recorder() {
  [ -f "$BIN_DIR/audio-capture" ] && [ -f "$SRC_DIR/audio-capture/audio-capture" ] \
    && cmp -s "$BIN_DIR/audio-capture" "$SRC_DIR/audio-capture/audio-capture"
}

# A running app owns the recording state (recording.dir and paused), so reset asks it to stop
# rather than clearing them behind it: it finishes the recording and clears them itself. False
# when no app answers, and reset clears them as before.
reset_through_app() {
  local reply
  reply="$(app_send stop)" || return 1
  case "$reply" in
    "ok finalising "*)    ok "meetingbox is finishing the recording in ${reply#ok finalising }" ;;
    "error not recording") ok "meetingbox is running and not recording" ;;
    "ok "*|"error "*)     info "meetingbox: ${reply#* }" ;;
    *)                    return 1 ;;
  esac
}

reset_cmd() {
  level="$1"   # state | tools | all
  case "$level" in tools) again="reset --tools" ;; all) again="uninstall" ;; *) again="reset" ;; esac
  if [ "$level" != state ]; then
    # The app is about to go: not while a recording is being made, finished or recovered.
    refuse_while_busy "$again" || return 1
    adopt_own_app
  fi
  say "reset"
  rule
  info "this will:"
  info "  stop any recorder left running and clear the recording state"
  info "  reset the Screen Recording and Microphone permissions for meetingbox,"
  info "  so macOS asks again next time"
  if [ "$level" != state ]; then
    info "  quit the meetingbox app, if it is running"
    ours="$(cat "$INSTALLED" 2>/dev/null || true)"
    info "  delete what setup installed:"
    n=0
    while IFS= read -r p; do
      case "$p" in
        keychain:sha1:*)
          info "    the meetingbox signing certificate in your login keychain"; n=$((n + 1)) ;;
        /*) if [ -e "$p" ] || [ -L "$p" ]; then info "    $p"; n=$((n + 1)); fi ;;
      esac
    done <<< "$ours"
    if old_recorder; then info "    $BIN_DIR/audio-capture (from v1.1.0)"; n=$((n + 1)); fi
    [ "$n" -gt 0 ] || info "    nothing, setup has no record of installing anything"
    left=""
    for p in "$APP_DIR" "$TRANSCRIPT_BIN" "$SRC_DIR/meetingbox" "$SRC_DIR/audio-capture" "$SRC_DIR/speech-analyzer-cli" \
             "$SA_APP" "$SA_LINK" "$WHISPER_FILE" "$SPEECH_BIN" "$SPEECH_MODELS" "$HOME/Library/Caches/mb-speech" \
             "$VOICE_FILE" "$VOICE_LOCK"; do
      if { [ -e "$p" ] || [ -L "$p" ]; } && ! installed_by_us "$p"; then left="$left$p
"; fi
    done
    if [ -n "$left" ]; then
      info "  leave alone, meetingbox did not install these:"
      printf '%s' "$left" | while IFS= read -r p; do info "    $p"; done
    fi
  fi
  [ "$level" = all ] && info "  delete meetingbox itself:                 $BIN_DIR/meetingbox"
  info "your recordings in $BASE_DIR are not touched"
  rule
  confirm "go ahead?" no || { info "nothing changed"; return 1; }

  # A recording may have started while the question was up: quit_app checks again first.
  if [ "$level" != state ]; then quit_app "$again" || return 1; fi

  # recorder and state: through the app when it answers (it has quit for tools and all)
  if [ "$level" = state ] && reset_through_app; then
    :
  else
    # Same 15s as stop, so a long recording can finish its file.
    stop_recorders ""
    if has_session; then
      info "the unfinished recording is kept in $(session_dir)"
    fi
    rm -f "$DIR_FILE" "$PAUSE_FILE"
    ok "recording state cleared"
  fi
  rm -f "$PID_FILE"   # recording.pid is from v1.2.0 and earlier
  clear_permcheck; release_lock

  # permissions, only meetingbox's own
  if [ -d "$APP_DIR" ]; then
    register_app
    if tccutil reset ScreenCapture "$APP_ID" >/dev/null 2>&1 \
       && tccutil reset Microphone "$APP_ID" >/dev/null 2>&1; then
      ok "permissions reset for meetingbox"
    else
      warn "could not reset permissions. Turn meetingbox off by hand in Privacy & Security"
    fi
  else
    info "the recorder app is not installed, so there are no meetingbox permissions to reset"
  fi

  if [ "$level" != state ]; then
    if installed_by_us "$APP_DIR" && [ -x "$LSREGISTER" ]; then
      "$LSREGISTER" -u "$APP_DIR" >/dev/null 2>&1 || true
    fi
    old_recorder && rm -f "$BIN_DIR/audio-capture"
    while IFS= read -r p; do
      case "$p" in /*) remove_installed "$p" || true ;; esac
    done <<< "$ours"
    # The app has quit (quit_app), so its socket goes too: one left by a crash would otherwise stay.
    rm -f "$CONTROL_SOCK"
    remove_signing_identity || true
    # a half finished download of the model setup was fetching
    if printf '%s\n' "$ours" | grep -qxF -- "$WHISPER_FILE"; then rm -f "$WHISPER_FILE.part"; fi
    # and the voice print's own temporary name, written beside it
    if printf '%s\n' "$ours" | grep -qxF -- "$VOICE_FILE"; then rm -f "$VOICE_FILE.tmp"; fi
    rmdir "$SRC_DIR" "$MODEL_DIR" 2>/dev/null || true
    ok "installed tools removed"
    if have brew && brew list whisper-cpp >/dev/null 2>&1; then
      info "Homebrew's whisper-cpp is left installed. To remove it: brew uninstall whisper-cpp"
    fi
  fi

  if [ "$level" = all ]; then
    rm -f "$BIN_DIR/meetingbox"
    # the app's lock file, free now it has quit, so the folder can go too
    app_lock_held || rm -f "$STATE_DIR/app.lock"
    [ -s "$INSTALLED" ] || rm -f "$INSTALLED"
    rmdir "$STATE_DIR" 2>/dev/null || true
    ok "meetingbox removed"
    info "the PATH line in your shell profile stays, other tools use ~/.local/bin too"
    return 0
  fi

  rule
  say "done. Run ${c_b}meetingbox setup${c_0} to set it up again."
}

# ----------------------------------------------------------------------- version

# The app's build as the app shows it (About meetingbox, Preferences, its menu: BuildInfo.swift),
# from its Info.plist: "meetingbox 2.0.0 (build 2026-11-05 14:30, 1a2b3c4, 9602459)", the commit
# only when known. An app from before builds were stamped gives its version alone.
app_build_line() {
  local p="$APP_DIR/Contents/Info.plist" v b h c
  v="$(plist_value "$p" CFBundleShortVersionString)"
  b="$(plist_value "$p" CFBundleVersion)"
  h="$(plist_value "$p" MBSourceHash)"
  c="$(plist_value "$p" MBCommit)"
  case "$b" in
    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) ;;
    *) printf 'meetingbox %s' "$v"; return 0 ;;
  esac
  if [ "${#h}" -lt 7 ]; then printf 'meetingbox %s' "$v"; return 0; fi
  printf 'meetingbox %s (build %s-%s-%s %s:%s, %s%s)' "$v" \
    "${b:0:4}" "${b:4:2}" "${b:6:2}" "${b:8:2}" "${b:10:2}" "${h:0:7}" "${c:+, $c}"
}

# This command's version and, when meetingbox's app is installed, its build. The two differ after
# the command is updated and before setup has rebuilt the app.
print_version() {
  local p="$APP_DIR/Contents/Info.plist"
  printf 'meetingbox %s\n' "$VERSION"
  [ "$(plist_value "$p" CFBundleIdentifier)" = "$APP_ID" ] || return 0
  if [ -n "$(plist_value "$p" CFBundleShortVersionString)" ]; then
    printf 'app: %s\n' "$(app_build_line)"
  else
    printf 'app: version unknown\n'
  fi
  if [ "$(plist_value "$p" CFBundleShortVersionString)" != "$VERSION" ]; then
    printf '%s\n' "The app and the command differ. Run: meetingbox setup"
  fi
}

usage() {
  cat <<'USAGE'
meetingbox: record, transcribe and summarise a meeting entirely on device.

  meetingbox setup                 install what is missing, next next next
  meetingbox                       toggle: start, or stop and write the minutes
  meetingbox start | stop | status
  meetingbox pause | resume
  meetingbox process <file|folder> run a recording or a transcript through the pipeline
  meetingbox notes <folder>        write the minutes again from its transcript
  meetingbox redo <folder>         transcribe it again, then write the minutes again
  meetingbox recover <folder>      finish a recording that was interrupted
  meetingbox doctor                what is installed and what is not
  meetingbox engines               which transcribers are ready, and your voice print
  meetingbox voice add <audio>     learn your voice from a recording of you alone
  meetingbox voice forget          forget your voice
  meetingbox mics                  microphones the recorder can see
  meetingbox reset                 clear a stuck recording, ask for permissions again
  meetingbox reset --tools         also remove what setup built, to start setup afresh
  meetingbox uninstall             remove meetingbox (recordings are kept)
  meetingbox version               this command's version, and which build the app is
  meetingbox help

Options
  --mic "USB"            microphone, substring match   (MB_MIC)
  --dir ~/Meetings       where recordings land         (MB_DIR)
  --locale en-GB         transcription locale          (MB_LOCALE)
  --parakeet | --native | --whisper   pick the transcriber   (MB_ENGINE)
  --tidy | --no-tidy     tidy transcript lines, or a line per turn with every word
  --room N | --call N    people in the room (you included) and on the call, 1 to 6,
                         for redo; without them it works them out
  --model <path>         whisper ggml model            (MB_WHISPER_MODEL)
  --no-keep-audio        bin the m4a files once processed (notes and redo never do)

Output lands in ~/Meetings/<date>_<time>/
  audio.m4a  mic.m4a  call.m4a       the mix, your side, the other side
  transcript.txt                     who said what, labelled by speaker
  notes.md  notes-raw.md  brief.json
  earlier/<date> <time>/             what a later run replaced, kept byte for byte
  notes-edited-<date> <time>.md      your own edits to notes.md, kept when it is replaced
USAGE
}

# The command line: the command, its file, and the settings. `voice` takes a word of its own first
# (add or forget). A function above main, so the tests can call it.
parse_args() {
  cmd=""
  subcmd=""
  argfile=""
  RESET_TOOLS=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --mic|--device) MIC="$2"; shift 2 ;;
      --dir)     BASE_DIR="$2"; DIR_ARG="$2"; shift 2 ;;
      --locale)  LOCALE="$2"; shift 2 ;;
      --model)   WHISPER_MODEL="$2"; ENGINE="whisper"; shift 2 ;;
      --whisper) ENGINE="whisper"; shift ;;
      --native)  ENGINE="native"; shift ;;
      --parakeet) ENGINE="parakeet"; shift ;;
      --tidy)    TIDY=1; shift ;;
      --no-tidy) TIDY=0; shift ;;
      --room|--call)
        case "${2:-}" in
          [1-6]) ;;
          *) die "$1 takes a number of people from 1 to 6" ;;
        esac
        if [ "$1" = --room ]; then ROOM_COUNT="$2"; else CALL_COUNT="$2"; fi
        shift 2 ;;
      --writer)
        case "${2:-}" in
          apple) WRITER="apple" ;;
          *) die "unknown minutes writer: ${2:-none given}" ;;
        esac
        shift 2 ;;
      --keep-audio)    KEEP_AUDIO=1; shift ;;
      --no-keep-audio) KEEP_AUDIO=0; shift ;;
      --tools)   RESET_TOOLS=1; shift ;;
      -v|--version) print_version; exit 0 ;;
      -h|--help) usage; exit 0 ;;
      -*) die "unknown option: $1" ;;
      *)  if [ -z "$cmd" ]; then cmd="$1"
          elif [ "$cmd" = voice ] && [ -z "$subcmd" ]; then subcmd="$1"
          else argfile="$1"; fi
          shift ;;
    esac
  done
}

# ------------------------------------------------------------------------ main

parse_args "$@"

case "${cmd:-toggle}" in
  toggle)
    if ! has_session && ! recorder_ready; then
      warn "not set up yet"
      confirm "run setup now?" && setup || info "run 'meetingbox setup' when you are ready"
    else
      toggle_recording
    fi ;;
  start)   start_recording ;;
  stop)    stop_recording ;;
  process) [ -n "$argfile" ] || die "usage: meetingbox process <audio-or-transcript>"
           process "$argfile" ;;
  notes)   [ -n "$argfile" ] || die "usage: meetingbox notes <folder>"
           notes_cmd "$argfile" ;;
  redo)    [ -n "$argfile" ] || die "usage: meetingbox redo <folder>"
           redo_cmd "$argfile" ;;
  recover) [ -n "$argfile" ] || die "usage: meetingbox recover <folder>"
           recover_cmd "$argfile" ;;
  setup)   setup ;;
  doctor|check) doctor ;;
  engines) engines_cmd ;;
  voice)
    case "$subcmd" in
      add)    [ -n "$argfile" ] || die "usage: meetingbox voice add <audio>"
              voice_add "$argfile" ;;
      forget) voice_forget ;;
      *)      die "usage: meetingbox voice add <audio> | meetingbox voice forget" ;;
    esac ;;
  mics|devices)
    recorder_ready || die "the recorder is not installed. Run: meetingbox setup"
    "$APP_BIN" --record -l ;;
  pause)   pause_recording ;;
  resume)  resume_recording ;;
  status)  status_cmd ;;
  reset)
    if [ "$RESET_TOOLS" = 1 ]; then reset_cmd tools; else reset_cmd state; fi ;;
  uninstall) reset_cmd all ;;
  version) print_version ;;
  help)    usage ;;
  *)       die "unknown command: $cmd (try: meetingbox help)" ;;
esac
